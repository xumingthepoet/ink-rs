Story
  Weave(baseIndent=0)
  Module(name="game")
    Weave(baseIndent=0)
      VariableAssignment(name="x", global=true, temp=false, type=string)
        String("")
    Flow(level=Knot, name="main", function=false)
      Weave(baseIndent=0)
        Text("This is a test")
        Text("\n")
        Text("SET_X:")
        Text("\n")
        ContentList
          Conditional(kind=if)
            ConditionalBranch(true=false, else=false, inline=false)
              Weave(baseIndent=0)
                Divert(target="-> x_not_set", empty=false, tunnel=false)
              Binary(==, VariableReference(x), String(""))
            ConditionalBranch(true=false, else=true, inline=false)
              Weave(baseIndent=0)
                Divert(target="-> x_is_set", empty=false, tunnel=false)
        Text("\n")
      Flow(level=Stitch, name="x_not_set", function=false)
        Weave(baseIndent=0)
          Text("X is not set!")
          Text("\n")
      Flow(level=Stitch, name="x_is_set", function=false)
        Weave(baseIndent=0)
          Text("X is set")
          Text("\n")
