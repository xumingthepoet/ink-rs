Story
  Weave(baseIndent=0)
  Module(name="game")
    Weave(baseIndent=0)
      VariableAssignment(name="x", global=true, temp=false, type=int)
        Number(0)
    Flow(level=Knot, name="main", function=false)
      Weave(baseIndent=0)
        Divert(target="-> one", empty=false, tunnel=false)
    Flow(level=Knot, name="one", function=false)
      Weave(baseIndent=0)
        ContentList
          Conditional(kind=if)
            Binary(<, VariableReference(x), Number(4))
            ConditionalBranch(true=true, else=false, inline=false)
              Weave(baseIndent=0)
                Divert(target="-> two.s2", empty=false, tunnel=false)
            ConditionalBranch(true=false, else=true, inline=false)
              Weave(baseIndent=0)
                Divert(target="-> two", empty=false, tunnel=false)
        Text("\n")
    Flow(level=Knot, name="two", function=false)
      Flow(level=Stitch, name="s2", function=false)
        Weave(baseIndent=0)
          VariableAssignment(name="x", global=false, temp=false)
            Binary(+, VariableReference(x), Number(1))
          Divert(target="-> one", empty=false, tunnel=false)
