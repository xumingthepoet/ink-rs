Story
  Weave(baseIndent=0)
  Module(name="data")
    Weave(baseIndent=0)
      EnumDeclaration(name="State")
        Member(name="Idle")
        Member(name="Busy")
        Member(name="Done")
      EnumDeclaration(name="Tone")
        Member(name="Calm")
        Member(name="Sharp")
      VariableAssignment(name="state", global=true, temp=false, type=State)
      VariableAssignment(name="states", global=true, temp=false, type=State[])
        ArrayLiteral(VariableReference(State.Idle), VariableReference(State.Busy))
      StructDeclaration(name="Actor")
        Field(name="state", type=State)
        Field(name="history", type=State[])
        Field(name="mood", type=Tone)
      VariableAssignment(name="actor", global=true, temp=false, type=Actor)
        StructLiteral(Actor, state=VariableReference(State.Busy), history=ArrayLiteral(VariableReference(State.Idle)), mood=VariableReference(Tone.Sharp))
      ConstantDeclaration(name="DEFAULT_STATE", type=State)
        VariableReference(State.Done)
      ConstantDeclaration(name="DEFAULT_TONE", type=Tone)
        VariableReference(Tone.Calm)
    Flow(level=Knot, name="echo", function=true)
      Weave(baseIndent=0)
        Return
          VariableReference(value)
    Flow(level=Knot, name="tone_name", function=true)
      Weave(baseIndent=0)
        ContentList
          Conditional(kind=switch)
            VariableReference(value)
            ConditionalBranch(true=false, else=false, inline=false)
              Weave(baseIndent=0)
                Return
                  String("calm")
              VariableReference(Tone.Calm)
            ConditionalBranch(true=false, else=true, inline=false)
              Weave(baseIndent=0)
                Return
                  String("sharp")
        Text("\n")
  Module(name="game")
    Import(from="data", names=["State", "state", "states", "actor", "DEFAULT_STATE", "DEFAULT_TONE", "echo", "tone_name"])
    Flow(level=Knot, name="main", function=false)
      Weave(baseIndent=0)
        ContentList
          QualifiedReference(data::state)
        Text("|")
        ContentList
          Binary(==, QualifiedReference(data::state), VariableReference(data::State.Idle))
        Text("|")
        ContentList
          IndexAccess(QualifiedReference(data::states), Number(1))
        Text("|")
        ContentList
          VariableReference(data::actor.state)
        Text("|")
        ContentList
          IndexAccess(VariableReference(data::actor.history), Number(0))
        Text("|")
        ContentList
          QualifiedFunctionCall(data::echo, args=1)
        Text("|")
        ContentList
          QualifiedFunctionCall(data::tone_name, args=1)
        Text("|")
        ContentList
          VariableReference(data::actor.mood)
        Text("\n")
        VariableAssignment(name="data::state", global=false, temp=false)
          VariableReference(data::State.Done)
        Text("|")
        ContentList
          Binary(!=, QualifiedReference(data::state), VariableReference(data::State.Busy))
        Text("\n")
