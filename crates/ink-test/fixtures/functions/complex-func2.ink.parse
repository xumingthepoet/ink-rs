Story
  Weave(baseIndent=0)
  Module(name="game")
    Weave(baseIndent=0)
      VariableAssignment(name="x", global=true, temp=false, type=int)
        Number(0)
      VariableAssignment(name="y", global=true, temp=false, type=int)
        Number(3)
      VariableAssignment(name="z", global=true, temp=false, type=int)
        Number(1)
    Flow(level=Knot, name="main", function=false)
      Weave(baseIndent=0)
        ContentList
          FunctionCall(derp, args=2)
          Text("\n")
        Text("The values are ")
        ContentList
          VariableReference(x)
        Text(" and ")
        ContentList
          VariableReference(y)
        Text(" and ")
        ContentList
          VariableReference(z)
        Text(".")
        Text("\n")
    Flow(level=Knot, name="derp", function=true)
      Weave(baseIndent=0)
        VariableAssignment(name="x", global=false, temp=false)
          Binary(-, VariableReference(a), VariableReference(b))
        ContentList
          Conditional(kind=if)
            ConditionalBranch(true=false, else=false, inline=false)
              Weave(baseIndent=0)
                VariableAssignment(name="y", global=false, temp=false)
                  Number(0)
              Binary(==, VariableReference(x), Number(0))
            ConditionalBranch(true=false, else=false, inline=false)
              Weave(baseIndent=0)
                VariableAssignment(name="y", global=false, temp=false)
                  Binary(-, VariableReference(x), Number(1))
              Binary(>, VariableReference(x), Number(0))
            ConditionalBranch(true=false, else=true, inline=false)
              Weave(baseIndent=0)
                VariableAssignment(name="y", global=false, temp=false)
                  Binary(+, VariableReference(x), Number(1))
        Text("\n")
