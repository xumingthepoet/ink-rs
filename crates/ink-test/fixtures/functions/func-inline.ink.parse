Story
  Weave(baseIndent=0)
  Module(name="game")
    Flow(level=Knot, name="main", function=false)
      Weave(baseIndent=0)
        Text("The value of x is ")
        ContentList
          FunctionCall(lerp, args=3)
        Text(".")
        Text("\n")
    Flow(level=Knot, name="lerp", function=true)
      Weave(baseIndent=0)
        Return
          Binary(+, Binary(*, Binary(-, VariableReference(b), VariableReference(a)), VariableReference(k)), VariableReference(a))
