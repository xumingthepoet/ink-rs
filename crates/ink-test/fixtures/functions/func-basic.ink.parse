Story
  Weave(baseIndent=0)
  Module(name="game")
    Weave(baseIndent=0)
      VariableAssignment(name="x", global=true, temp=false, type=float)
        Number(0)
    Flow(level=Knot, name="main", function=false)
      Weave(baseIndent=0)
        ContentList
          VariableAssignment(name="x", global=false, temp=false)
            FunctionCall(lerp, args=3)
          Text("\n")
        Text("The value of x is ")
        ContentList
          VariableReference(x)
        Text(".")
        Text("\n")
    Flow(level=Knot, name="lerp", function=true)
      Weave(baseIndent=0)
        Return
          Binary(+, Binary(*, Binary(-, VariableReference(b), VariableReference(a)), VariableReference(k)), VariableReference(a))
