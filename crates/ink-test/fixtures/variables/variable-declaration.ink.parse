Story
  Weave(baseIndent=0)
  Module(name="game")
    Weave(baseIndent=0)
      VariableAssignment(name="friendly_name_of_player", global=true, temp=false, type=string)
        String("Jackie")
      VariableAssignment(name="age", global=true, temp=false, type=int)
        Number(23)
    Flow(level=Knot, name="main", function=false)
      Weave(baseIndent=0)
        Text("\"My name is Jean Passepartout, but my friend's call me ")
