Story
  Weave(baseIndent=0)
    Gather(name=null, depth=1)
    Divert(target="-> DONE", empty=false, tunnel=false, thread=false)
  Module(name="game")
    Weave(baseIndent=0)
      VariableAssignment(name="x", global=true, temp=false, type=int)
        Number(0)
      VariableAssignment(name="y", global=true, temp=false, type=int)
        Number(3)
    Flow(level=Knot, name="main", function=false)
      Weave(baseIndent=0)
        ContentList
          Conditional(kind=if)
            Binary(>, VariableReference(x), Number(0))
            ConditionalBranch(true=true, else=false, inline=false)
              Weave(baseIndent=0)
                VariableAssignment(name="y", global=false, temp=false)
                  Binary(-, VariableReference(x), Number(1))
            ConditionalBranch(true=false, else=true, inline=false)
              Weave(baseIndent=0)
                VariableAssignment(name="y", global=false, temp=false)
                  Binary(+, VariableReference(x), Number(1))
        Text("\n")
        Text("The value is ")
        ContentList
          VariableReference(y)
        Text(". ")
        Divert(target="-> END", empty=false, tunnel=false, thread=false)
        Text("\n")