Story
  Weave(baseIndent=0)
    Text("What\u0027s that?\u0022 my master asked.")
    Text("\n")
    Choice(name=null, once=true, invisible=false, depth=1, inline=true)
      ContentList
        Text("\u0022I am somewhat tired")
      ContentList
        Text(".\u0022")
      ContentList
        Text(",\u0022 I repeated.")
        Text("\n")
    Text("\u0022Really,\u0022 he responded. \u0022How deleterious.\u0022")
    Text("\n")
    Choice(name=null, once=true, invisible=false, depth=1, inline=true)
      ContentList
        Text("\u0022Nothing, Monsieur!\u0022")
      ContentList
        Text(" I replied.")
        Text("\n")
    Text("\u0022Very good, then.\u0022")
    Text("\n")
    Choice(name=null, once=true, invisible=false, depth=1, inline=true)
      ContentList
        Text("\u0022I said, this journey is appalling")
      ContentList
        Text(".\u0022")
      ContentList
        Text(" and I want no more of it.\u0022")
        Text("\n")
    Text("\u0022Ah,\u0022 he replied, not unkindly. \u0022I see you are feeling frustrated. Tomorrow, things will improve.\u0022")
    Text("\n")
    Gather(name=null, depth=1)
    Text("With that Monsieur Fogg left the room.")
    Text("\n")
    Divert(target="-\u003E END", empty=false, tunnel=false, thread=false)
    Gather(name=null, depth=1)
    Divert(target="-\u003E DONE", empty=false, tunnel=false, thread=false)