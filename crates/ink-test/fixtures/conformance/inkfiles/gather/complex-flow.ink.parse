Story
  Weave(baseIndent=0)
    Text("I looked at Monsieur Fogg")
    Text("\n")
    Choice(name=null, once=true, invisible=false, depth=1, inline=false)
      ContentList
        Text("... and I could contain myself no longer.")
      ContentList
        Text("\n")
    Text("\u0027What is the purpose of our journey, Monsieur?\u0027")
    Text("\n")
    Text("\u0027A wager,\u0027 he replied.")
    Text("\n")
    Weave(baseIndent=1)
      Choice(name=null, once=true, invisible=false, depth=2, inline=true)
        ContentList
          Text("\u0027A wager!\u0027")
        ContentList
          Text(" I returned.")
          Text("\n")
      Text("He nodded.")
      Text("\n")
      Weave(baseIndent=2)
        Choice(name=null, once=true, invisible=false, depth=3, inline=false)
          ContentList
            Text("\u0027But surely that is foolishness!\u0027")
          ContentList
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=3, inline=false)
          ContentList
            Text("\u0027A most serious matter then!\u0027")
          ContentList
            Text("\n")
        Gather(name=null, depth=3)
        Text("He nodded again.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=3, inline=false)
          ContentList
            Text("\u0027But can we win?\u0027")
          ContentList
            Text("\n")
        Text("\u0027That is what we will endeavour to find out,\u0027 he answered.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=3, inline=false)
          ContentList
            Text("\u0027A modest wager, I trust?\u0027")
          ContentList
            Text("\n")
        Text("\u0027Twenty thousand pounds,\u0027 he replied, quite flatly.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=3, inline=true)
          ContentList
            Text("I asked nothing further of him then")
          ContentList
            Text(".")
          ContentList
            Text(", and after a final, polite cough, he offered nothing more to me. ")
            Glue
            Text("\n")
      Choice(name=null, once=true, invisible=false, depth=2, inline=true)
        ContentList
          Text("\u0027Ah")
        ContentList
          Text(".\u0027")
        ContentList
          Text(",\u0027 I replied, uncertain what I thought.")
          Text("\n")
      Gather(name=null, depth=2)
      Text("After that, ")
      Glue
      Text("\n")
    Choice(name=null, once=true, invisible=false, depth=1, inline=true)
      ContentList
        Text("... but I said nothing")
      ContentList
        Text(" and ")
        Glue
        Text("\n")
    Gather(name=null, depth=1)
    Text("we passed the day in silence.")
    Text("\n")
    Gather(name=null, depth=1)
    Divert(target="-\u003E END", empty=false, tunnel=false, thread=false)
    Gather(name=null, depth=1)
    Divert(target="-\u003E DONE", empty=false, tunnel=false, thread=false)