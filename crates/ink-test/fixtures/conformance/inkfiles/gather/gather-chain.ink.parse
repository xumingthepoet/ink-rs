Story
  Weave(baseIndent=0)
    Text("I ran through the forest, the dogs snapping at my heels.")
    Text("\n")
    Choice(name=null, once=true, invisible=false, depth=1, inline=true)
      ContentList
        Text("I checked the jewels")
      ContentList
        Text(" were still in my pocket, and the feel of them brought a spring to my step. ")
        Glue
        Text("\n")
    Choice(name=null, once=true, invisible=false, depth=1, inline=true)
      ContentList
        Text("I did not pause for breath")
      ContentList
        Text(" but kept on running. ")
        Glue
        Text("\n")
    Choice(name=null, once=true, invisible=false, depth=1, inline=false)
      ContentList
        Text("I cheered with joy. ")
        Glue
      ContentList
        Text("\n")
    Gather(name=null, depth=1)
    Text("The road could not be much further! Mackie would have the engine running, and then I\u0027d be safe.")
    Text("\n")
    Choice(name=null, once=true, invisible=false, depth=1, inline=true)
      ContentList
        Text("I reached the road and looked about")
      ContentList
        Text(". And would you believe it?")
        Text("\n")
    Choice(name=null, once=true, invisible=false, depth=1, inline=true)
      ContentList
        Text("I should interrupt to say Mackie is normally very reliable")
      ContentList
        Text(". He\u0027s never once let me down. Or rather, never once, previously to that night.")
        Text("\n")
    Gather(name=null, depth=1)
    Text("The road was empty. Mackie was nowhere to be seen.")
    Text("\n")
    Divert(target="-\u003E END", empty=false, tunnel=false, thread=false)
