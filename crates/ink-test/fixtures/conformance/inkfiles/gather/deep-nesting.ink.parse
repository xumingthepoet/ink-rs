Story
  Weave(baseIndent=0)
    Text("Tell us a tale, Captain!\u0022")
    Text("\n")
    Choice(name=null, once=true, invisible=false, depth=1, inline=false)
      ContentList
        Text("\u0022Very well, you sea-dogs. Here\u0027s a tale...\u0022")
