Story
  Weave(baseIndent=0)
    Text("I looked...")
    Text("\n")
    Choice(name=null, once=true, invisible=false, depth=1, inline=true)
      ContentList
        Text("at the door")
      ContentList
        Text("\n")
    Divert(target="-> door_open", empty=false, tunnel=false, thread=false)
