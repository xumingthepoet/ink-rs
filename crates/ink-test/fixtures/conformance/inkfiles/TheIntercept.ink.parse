          ContentList
            Text("Say nothing")
          ContentList
            Text(" \t")
            Divert(target="-\u003E say_nothing", empty=false, tunnel=false, thread=false)
            Text("\n")
          VariableReference(drugged)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Lie")
          ContentList
            Text(" \t")
            Divert(target="-\u003E claim_hooper_took_component", empty=false, tunnel=false, thread=false)
            Text("\n")
          Unary(not, VariableReference(drugged))
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Don\u0027t explain")
        ContentList
          Text("\n")
        Unary(not, VariableReference(drugged))
      Text("\u0022There\u0027s nothing to explain,\u0022 I reply stiffly. ")
      Divert(target="-\u003E i_know_where", empty=false, tunnel=false, thread=false)
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Lie")
        ContentList
          Text(" ")
          Divert(target="-\u003E claim_hooper_took_component", empty=false, tunnel=false, thread=false)
          Text("\n")
        Unary(not, VariableReference(drugged))
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Evade")
        ContentList
          Text("\n")
        Unary(not, VariableReference(drugged))
      Text("\u0022Explain what you should be doing, do you mean, rather than bullying me? Certainly.\u0022 I fold my arms. ")
      Divert(target="-\u003E i_know_where", empty=false, tunnel=false, thread=false)
      Text("\n")
      Choice(name="say_nothing", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Say nothing")
        ContentList
          Text("\n")
        VariableReference(drugged)
      Text("I fold my arms, intended firmly to say nothing. But somehow, watching Harris\u0027 face, I cannot bring myself to do it. I want to confess. I want to tell him everything I can, to explain myself to him, to earn his forgiveness. The sensation is so strong my will is powerless in the face of it.")
      Text("\n")
      Text("Something is wrong with me, I am sure of it. There is a strange, bitter flavour on my tongue. I taste it as words start to form.")
      Text("\n")
      Divert(target="-\u003E ive_done_things", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="i_know_where", function=false)
      Weave(baseIndent=0)
        Text("\u0022I know where your component is because it\u0027s obvious where your component is. That doesn\u0027t mean I took it, just because I can figure out a simple problem, any more than it means I\u0027m a German spy because I can crack their codes.\u0022")
        Text("\n")
        Divert(target="-\u003E harris_asks_for_theory", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="ive_done_things", function=false)
      Weave(baseIndent=0)
        Text("\u0022I\u0027ve done things,\u0022 I begin")
        ContentList
          Conditional
            VariableReference(harris_demands_component.cant_talk_right)
            ConditionalBranch(true=true, else=false, inline=true)
              Weave(baseIndent=0)
                Text(" helplessly")
        Text(". \u0022Things I didn\u0027t want to do. I tried not to. But in the end, it felt like cutting off my own arm to resist.\u0022")
        Text("\n")
        Divert(target="-\u003E harris_presses_for_details", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="harris_asks_for_theory", function=false)
    Weave(baseIndent=0)
      Text("\u0022Tell me, then,\u0022 he asks. \u0022What\u0027s your theory? You\u0027re a smart fellow \u2014 as smart as they come around here, and that\u0027s saying something. What\u0027s your opinion on the missing component? Accident, perhaps? Or do you blame one of the other men? ")
      ContentList
        Conditional
          VariableReference(hooper_mentioned)
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("Hooper?")
      Text("\u0022")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Blame no\u2014one")
        ContentList
          Text(" ")
          Text("\n")
      Divert(target="-\u003E an_accident", empty=false, tunnel=false, thread=false)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Blame someone")
        ContentList
          Text(" ")
          Divert(target="-\u003E claim_hooper_took_component", empty=false, tunnel=false, thread=false)
          Text("\n")
    Flow(level=Stitch, name="an_accident", function=false)
      Weave(baseIndent=0)
        Text("\u0022An accident, naturally.\u0022 I risk a smile. \u0022That damned machine is made from spare parts and string. Even these Huts leak when it rains. It wouldn\u0027t take more than one fellow to trip over a cable to shake out a component. Have you tried looking under the thing?\u0022")
        Text("\n")
        Text("\u0022Do you believe we haven\u0027t?\u0022")
        Text("\n")
        Text("In a sudden moment I understand that his reply is a threat.")
        Text("\n")
        Text("\u0022Now,\u0022 he continues. \u0022Are you sure there isn\u0027t anything you want to tell me?\u0022")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Co-operate")
          ContentList
            Text("\n")
        Text("\u0022All right.\u0022 With a sigh, your defiance collapses. \u0022If you\u0027re searched my things then I suppose you\u0027ve found ")
        ContentList
          Conditional
            Binary(>, VariableReference(evasive), Number(1))
            ConditionalBranch(true=true, else=false, inline=true)
              Weave(baseIndent=0)
                Text(" what you need")
            ConditionalBranch(true=false, else=true, inline=true)
              Weave(baseIndent=0)
                Text("my letters. Haven\u0027t you? In fact, if you haven\u0027t, don\u0027t tell me")
        Text(".")
        Text("\n")
        VariableAssignment(name="admitblackmail", global=false, temp=false)
          Number(true)
        Text("Harris nods once.")
        Text("\n")
        Glue
        Text(" ")
        Divert(target="-\u003E harris_has_seen_it_before", empty=false, tunnel=false, thread=false)
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Evade")
          ContentList
            Text(" \u0022Only that you\u0027re being unreasonable, and behaving like a swine.\u0022")
            Text("\n")
          Binary(>, VariableReference(evasive), Number(0))
        Text("\u0022You imbecile,\u0022 Harris replies, with sudden force. He is half out of his chair. \u0022You know the situation as well as I do. Why the fencing? The Hun are poised like rats, ready to run all over this country. They\u0027ll destroy everything. You understand that, don\u0027t you? You\u0027re not so locked up inside your crossword puzzles that you don\u0027t see that, are you? This machine we have here \u2014 you men \u2014 you are the best and only hope this country has. God help her.\u0022")
        Text("\n")
        VariableAssignment(name="losttemper", global=false, temp=false)
          Number(true)
        Text("I sit back, startled by the force of his outburst. His carefully sculpted expression has curled to angry disgust. \u003Ci\u003EHe really does hate me\u003C/i\u003E, I think. \u003Ci\u003EHe\u0027ll have my blood for the taste of it.\u003C/i\u003E")
        Text("\n")
        Weave(baseIndent=1)
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("Placate")
            ContentList
              Text("\n")
          Text("\u0022Now steady on,\u0022 I reply, gesturing for him to be calm.")
          Text("\n")
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("Mock")
            ContentList
              Text(" ")
              Text("\n")
          Text("\u0022I can imagine how being surrounded by clever men is pretty threatening for you, Commander,\u0022 I reply with a sneer. \u0022They don\u0027t train you to think in the Armed Forces.\u0022")
          Text("\n")
          ContentList
            FunctionCall(raise, args=1)
            Text("\n")
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("Dismiss")
            ContentList
              Text("\n")
          Text("\u0022Then I\u0027ll be going, on and getting on with my job of saving her, shall I?\u0022 I even rise half to my feet, before he slams the tabletop.")
          Text("\n")
          Gather(name=null, depth=2)
          Text("\u0022Talk,\u0022 Harris demands. \u0022Talk now. Tell me where you\u0027ve hidden it or who you passed it to. Or God help me, I\u0027ll take your wretched pansy body to pieces looking for it.\u0022")
          Text("\n")
          Divert(target="-\u003E harris_demands_you_speak", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="harris_has_seen_it_before", function=false)
    Weave(baseIndent=0)
      Text("\u0022I\u0027ve seen it before. A young man like you \u2014 clever, removed. The kind that doesn\u0027t go to parties. Who takes himself too seriously. Who takes things too far.\u0022")
      Text("\n")
      Text("He slides his thumb between two fingers.")
      Text("\n")
      Text("\u0022Now they own you.\u0022")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Agree")
        ContentList
          Text(" ")
          Text("\n")
      Text("\u0022What could I do?\u0022 I\u0027m shaking now. The night is cold and the heat\u2014lamp in the Hut has been removed. \u0022")
      ContentList
        Conditional
          Binary(>, VariableReference(forceful), Number(2))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("I won\u0027t")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("I don\u0027t want to")
      Text(" go to prison.\u0022")
      Text("\n")
      Text("\u0022Smart man,\u0022 he replies. \u0022You wouldn\u0027t last.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Disagree")
        ContentList
          Text(" ")
          Text("\n")
      Text("\u0022I can still fix this.\u0022")
      Text("\n")
      Text("Harris shakes his head. \u0022You\u0027ll do nothing. This is beyond you now. You may go to prison or may go to firing squad - or we can change your name and move you somewhere where your indiscretions can\u0027t hurt you. But right now, none of that matters. What happens to you doesn\u0027t matter. All that matters is where that component is.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Lie")
        ContentList
          Text(" ")
          Text("\n")
        Unary(not, VariableReference(drugged))
      Text("\u0022I wanted to tell you,\u0022 I tell him. \u0022I thought I could find out who they were. Lead you to them.\u0022")
      Text("\n")
      Text("Harris looks at me with contempt. \u0022You wretch. You\u0027ll pay for what you\u0027ve done to this country today. If a single man loses his life because of your pride and your perversions then God help your soul.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Apologise")
        ContentList
          Text("\n")
        MultipleCondition(VariableReference(drugged), Binary(<, VariableReference(forceful), Number(0)))
      Text("\u0022Harris, I...\u0022")
      Text("\n")
      ContentList
        FunctionCall(lower, args=1)
        Text("\n")
      Text("\u0022Stop it,\u0022 he interrupts. \u0022There\u0027s no jury here to sway.  And there\u0027s no time.")
      Text("\n")
      Gather(name="tell_me_now", depth=1)
      Glue
      Text(" So why don\u0027t you tell me, right now. Where is it?\u0022")
      Text("\n")
      Divert(target="-\u003E harris_demands_you_speak", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="harris_demands_you_speak", function=false)
    Weave(baseIndent=0)
      Text("His eyes bear down like carbonised drill\u2014bits.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Confess")
        ContentList
          Text(" ")
          Text("\n")
      ContentList
        Conditional
          Binary(>, VariableReference(forceful), Number(1))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("\u0022You want me to tell you what happened? You\u0027ll be disgusted.\u0022")
              Text("\n")
          ConditionalBranch(true=false, else=true, inline=false)
            Weave(baseIndent=0)
              Text("\u0022All right. I\u0027ll tell you what happened.\u0022 And never mind my shame.")
              Text("\n")
      Text("\n")
      Text("\u0022I can imagine how it starts,\u0022 he replies.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Dissemble")
        ContentList
          Text(" ")
          Divert(target="-\u003E claim_hooper_took_component", empty=false, tunnel=false, thread=false)
          Text("\n")
        Unary(not, VariableReference(drugged))
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Dissemble")
        ContentList
          Text("\n")
        VariableReference(drugged)
      Text("My plan now is to blame Hooper, but I cannot seem to tell the story. Whatever they put in my tea, it rules my tongue. ")
      ContentList
        Conditional
          Binary(>, VariableReference(forceful), Number(1))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("I fight it as hard as I can but it does no good.")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("I am desperate to tell him everything. I am weeping with shame.")
      Text("\n")
      ContentList
        FunctionCall(lower, args=1)
        Text("\n")
      Gather(name=null, depth=1)
      Divert(target="-\u003E i_met_a_young_man", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="i_met_a_young_man", function=false)
    Weave(baseIndent=0)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Talk")
        ContentList
          Text("\n")
      Text("\u0022There was a young man. I met him in the town. A few months ago now. We got to talking. Not about work. And I used my cover story, but he seemed to know it wasn\u0027t true. That got me wondering if he might be one of us.\u0022")
      Text("\n")
      Gather(name=null, depth=1)
      Text("Harris is not letting me off any more.")
      Text("\n")
      Text("\u0022You seriously entertained that possibility?\u0022")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Yes")
        ContentList
          Text("\n")
      Text("\u0022Yes, I considered it. ")
      Glue
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("No")
        ContentList
          Text(" ")
          Text("\n")
      Text("\u0022No. Not for more than a moment, of course. Everyone here is marked out by how little we would be willing to say about it.\u0022")
      Text("\n")
      Text("\u0022Only you told this young man more than a little, didn\u0027t you?\u0022")
      Text("\n")
      Text("I nod. \u0022")
      Glue
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Lie")
        ContentList
          Text(" ")
          Text("\n")
      Text("\u0022I was quite certain, after a while. After we\u0027d been talking. ")
      Glue
      Text("\n")
      Gather(name=null, depth=1)
      Text("He seemed to know all about me. He... he was quite enchanted by my achievements.\u0022")
      Text("\n")
      Text("The way Harris is staring I expect him to strike me, but he does not. He replies, \u0022I can see how that must have been attractive to you,\u0022 with such plain\u2014spokeness that I think I must have misheard.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Yes")
        ContentList
          Text(" \u0022It\u0027s a lonely life in this place,\u0022 I reply. \u0022Lonely - and still one never gets a moment to oneself.\u0022")
          Text("\n")
      Text("\u0022That\u0027s how it is in the Service,\u0022 Harris answers.")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Argue")
          ContentList
            Text(" \u0022I\u0027m not in the Service.\u0022")
            Text("\n")
        Text("Harris shakes his head. \u0022Yes, you are.\u0022")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Agree")
          ContentList
            Text(" \u0022Perhaps. But I didn\u0027t choose this life.\u0022 ")
            Text("\n")
        Text("Harris shakes his head. \u0022No. And there\u0027s plenty of others who didn\u0027t who are suffering far worse.\u0022")
        Text("\n")
        Gather(name=null, depth=2)
        Text("Then he waves the thought aside.")
        Text("\n")
      Choice(name="nope", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("No")
        ContentList
          Text(" \u0022The boy was a pretty simpleton. Quite inferior. His good opinion meant nothing to be. Harris, do not misunderstand. I was simply after his body.\u0022")
          Text("\n")
        Unary(not, VariableReference(drugged))
      ContentList
        FunctionCall(raise, args=1)
        Text("\n")
      Text("Harris, to his credit, doesn\u0027t flinch; but I can see he will have nightmares of this moment later tonight. I\u0027m tempted to reach out and take his hand to worsen it for him.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("No")
        ContentList
          Text(" ")
          Text("\n")
        VariableReference(drugged)
      Text("\u0022It wasn\u0027t,\u0022 I reply. \u0022But I doubt you\u0027d understand.\u0022")
      Text("\n")
      Text("He simply nods.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Lie")
        ContentList
          Text(" ")
          Divert(target="-\u003E nope", empty=false, tunnel=false, thread=false)
          Text("\n")
        Unary(not, VariableReference(drugged))
      Gather(name=null, depth=1)
      Text("\u0022Go on with your confession.\u0022")
      Text("\n")
      Gather(name="paused", depth=1)
      ContentList
        Conditional
          Unary(not, VariableReference(nope))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("That gives me pause. I hadn\u0027t thought of it as such. But I suppose he\u0027s right. I am about to admit what I did.")
              Text("\n")
      Text("\n")
      Text("\u0022There\u0027s not much else to say. I took the part from Bombe computing device. You seem to know that already. I had to. He was going to expose me if I didn\u0027t.\u0022")
      Text("\n")
      Text("\u0022This young man was blackmailing you over your affair?\u0022")
      Text("\n")
      VariableAssignment(name="harris_thinks_youre_drugged", global=false, temp=true)
        VariableReference(drugged)
      ContentList
        Conditional
          VariableReference(drugged)
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              VariableAssignment(name="drugged", global=false, temp=false)
                Number(false)
              Text("As Harris speaks I find myself suddenly sharply aware, as if waking from a long sleep. The table, the corrugated walls of the hut, everything seems suddenly more tangible than a moment before.")
              Text("\n")
              Text("Whatever it was they put in my drink is wearing off.")
              Text("\n")
      Text("\n")
      Choice(name="yes", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Yes")
        ContentList
          Text(" ")
          Text("\n")
      Text("\u0022Yes. I suppose he was their agent. I should have realised but I didn\u0027t. Then he threatened to tell you. I thought you would have me locked up: I couldn\u0027t bear the thought of it. I love working here. I\u0027ve never been so happy, so successful, anywhere before. I didn\u0027t want to lose it.\u0022")
      Text("\n")
      Text("\u0022So what did you do with the component?\u0022 Harris talks urgently. He grips his gloves tightly in one hand, perhaps prepared to lift them and strike if it is required. \u0022Have you passed it to this man already? Have you left it somewhere for him to find?\u0022")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name="still_have", once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("I have it")
          ContentList
            Text(" \t")
            Text("\n")
        Text("\u0022I still have it. Not on me, of course. ")
        Divert(target="-\u003E reveal_location_of_component", empty=false, tunnel=false, thread=false)
        Text("\n")
        Choice(name="dont_have", once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("I don\u0027t have it")
          ContentList
            Text(" \t")
            Divert(target="-\u003E i_dont_have_it", empty=false, tunnel=false, thread=false)
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Lie")
          ContentList
            Text(" \t\t\t\t\t\t\t")
            Divert(target="-\u003E dont_have", empty=false, tunnel=false, thread=false)
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Tell the truth")
          ContentList
            Text(" \t\t\t\t")
            Divert(target="-\u003E still_have", empty=false, tunnel=false, thread=false)
            Text("\n")
      Choice(name="notright", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("No")
        ContentList
          Text(" ")
          Text("\n")
      Text("\u0022No, Harris. The young man wasn\u0027t blackmailing me.\u0022 I take a deep breath. \u0022It was Hooper.\u0022")
      Text("\n")
      ContentList
        Conditional
          Unary(not, VariableReference(hooper_mentioned))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("\u0022Hooper!\u0022 Harris exclaims, in surprise. ")
              ContentList
                Conditional
                  VariableReference(harris_thinks_youre_drugged)
                  ConditionalBranch(true=true, else=false, inline=true)
                    Weave(baseIndent=0)
                      Text("He does not doubt me for a moment.")
              Text("\n")
          ConditionalBranch(true=false, else=true, inline=false)
            Weave(baseIndent=0)
              Text("\u0022Now look here,\u0022 Harris interrupts. \u0022Don\u0027t start that again.\u0022")
              Text("\n")
      Text("\n")
      Text("\u0022It\u0027s the truth, Harris. If I\u0027m going to jail, so be it, but I won\u0027t hang at Traitor\u0027s Gate. Hooper was the one who told the boy about our work. Hooper put the boy on to me. ")
      ContentList
        Conditional
          Binary(<, VariableReference(forceful), Number(2))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("I should have realised, of course. These things don\u0027t happen by chance. I was a fool to think they might.")
      Text(" And then, once he had me compromised, he demanded I steal the part from the machine.\u0022")
      Text("\n")
      VariableAssignment(name="revealedhooperasculprit", global=false, temp=false)
        Number(true)
      Text("\u0022Which you did.\u0022 Harris leans forward. \u0022And then what? You still have it? You\u0027ve stashed it somewhere?\u0022")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name="didnt_have_long", once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Yes")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022Yes. I only had a moment. ")
        Divert(target="-\u003E reveal_location_of_component", empty=false, tunnel=false, thread=false)
        Text("\n")
        Choice(name="passed_on", once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("No")
          ContentList
            Text(" ")
            Divert(target="-\u003E passed_onto_hooper", empty=false, tunnel=false, thread=false)
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Lie")
          ContentList
            Text(" \t\t\t")
            Divert(target="-\u003E passed_on", empty=false, tunnel=false, thread=false)
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Evade")
          ContentList
            Text(" \t\t")
            Text("\n")
        Text("\u0022I can\u0027t remember.\u0022")
        Text("\n")
        Text("He draws his gun and lays it lightly on the field table.")
        Text("\n")
        Text("\u0022I\u0027m sorry to threaten you, friend. But His Majesty needs that brain of yours, and that brain alone. There are plenty of other parts to you that our country could do better without. Now I\u0027ll ask you again. Did you hide the component?\u0022")
        Text("\n")
        Weave(baseIndent=2)
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("Yes")
            ContentList
              Text(" ")
              Divert(target="-\u003E didnt_have_long", empty=false, tunnel=false, thread=false)
              Text("\n")
          Choice(name="nope_didnt_hide", once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("No")
            ContentList
              Text(" ")
              Text("\n")
          Text("\u0022Very well then.\u0022 I swallow nervously, to make it look more genuine. ")
          Divert(target="-\u003E passed_onto_hooper", empty=false, tunnel=false, thread=false)
          Text("\n")
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("Lie")
            ContentList
              Text(" ")
              Divert(target="-\u003E nope_didnt_hide", empty=false, tunnel=false, thread=false)
              Text("\n")
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("Evade")
            ContentList
              Text(" ")
              Divert(target="-\u003E i_dont_have_it", empty=false, tunnel=false, thread=false)
              Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Tell the truth")
        ContentList
          Text(" \t")
          Divert(target="-\u003E yes", empty=false, tunnel=false, thread=false)
          Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Lie")
        ContentList
          Text(" \t\t\t\t")
          Divert(target="-\u003E notright", empty=false, tunnel=false, thread=false)
          Text("\n")
    Flow(level=Stitch, name="i_dont_have_it", function=false)
      Weave(baseIndent=0)
        Text("\u0022I don\u0027t have it any more. I passed it through the fence to my contact straight after taking it, before it was discovered to be missing. It would have been idiocy to do differently. It\u0027s long gone, I\u0027m afraid.\u0022")
        Text("\n")
        Text("\u0022You fool, Manning,\u0022 Harris curses, getting quickly to his feet. \u0022You utter fool. Do you suppose you will be any better off living under Hitler? It\u0027s men like you who will get us all killed. Men too feeble, too weak in their hearts to stand up and take a man\u0027s responsibility for the world. You\u0027re happier to stay a child all your life and play with your little childish toys.\u0022")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Answer back")
          ContentList
            Text("\n")
        Text("\u0022Really, Commander,\u0022 I reply. \u0022It rather sounds like you want to spank me.\u0022")
        Text("\n")
        Text("\u0022For God\u0027s sake,\u0022 he declares with thick disgust, then swoops away out of the room.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Say nothing")
          ContentList
            Text(" ")
            Text("\n")
        Text("I say nothing. It\u0027s true, isn\u0027t it? I can\u0027t deny that I know there is a world out there, a complicated world of pain and suffering. And I can\u0027t deny that I don\u0027t think about it a moment longer than I have to. What use is thinking on a problem that cannot be solved? It is precisely our ability to avoid such endless spirals that makes us human and not machine.")
        Text("\n")
        Text("\u0022God have mercy on your soul,\u0022 Harris says finally, as he gets to his feet and heads for the door. \u0022I fear no\u2014one else will.\u0022")
        Text("\n")
        Gather(name=null, depth=1)
        Divert(target="-\u003E left_alone", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="passed_onto_hooper", function=false)
      Weave(baseIndent=0)
        VariableAssignment(name="hooper_mentioned", global=false, temp=false)
          Number(true)
        Text("\u0022No. I passed it on to Hooper.\u0022")
        Text("\n")
        Text("\u0022I see. And what did he do with it?\u0022")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Evade")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022I don\u0027t know.\u0022")
        Text("\n")
        Text("\u0022You can do better than that. Remember, there\u0027s a hangman\u0027s noose waiting for traitors.\u0022")
        Text("\n")
        Weave(baseIndent=1)
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("Theorise")
            ContentList
              Text(" ")
              Text("\n")
          Text("\u0022Well, then,\u0022 I answer, nervously. \u0022What would he do? Either get rid of it straight away \u2014 or if that wasn\u0027t possible, which it probably wouldn\u0027t be, since he\u0027d have to arrange things with his contacts \u2014 so most likely, he\u0027d hide it somewhere and wait, until you had the rope around my neck and he could be sure he was safe.\u0022")
          Text("\n")
          Divert(target="-\u003E claim_hooper_took_component.harris_being_convinced", empty=false, tunnel=false, thread=false)
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("Shrug")
            ContentList
              Text(" ")
              Divert(target="-\u003E claim_hooper_took_component.its_your_problem", empty=false, tunnel=false, thread=false)
              Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Tell the truth")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022I don\u0027t think Hooper could have planned this in advance. So he\u0027d need to get word to whoever he\u0027s working with, and that would take time. So I think he would have hidden it somewhere, and be waiting to make sure I soundly take the fall. That way, if anything goes wrong, he can arrange for the part to be conveniently re\u2014found.\u0022")
        Text("\n")
        Divert(target="-\u003E claim_hooper_took_component.harris_being_convinced", empty=false, tunnel=false, thread=false)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Lie")
          ContentList
            Text("\n")
        Text("\u0022I\u0027m sure I saw him this evening, talking to someone by the fence on the woodland side of the compound. He\u0027s probably passed it on already. You\u0027ll have to ask him.\u0022")
        Text("\n")
        Divert(target="-\u003E claim_hooper_took_component.harrumphs", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="claim_hooper_took_component", function=false)
    Weave(baseIndent=0)
      Text("\u0022I saw Hooper take it.\u0022")
      Text("\n")
      VariableAssignment(name="hooper_mentioned", global=false, temp=false)
        Number(true)
      ContentList
        Conditional
          VariableReference(losttemper)
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("\u0022Did you?\u0022")
              Text("\n")
              Text("The worst of his rage is passing; he is now moving into a kind of contemptuous despair. I can imagine him wrapping up our interview soon, leaving the hut, locking the door, and dropping the key down the well in the yard.")
              Text("\n")
              Text("And why wouldn\u0027t he? With my name tarnished they will not let me back to work on the Bombe \u2014 if there is the slightest smell of treachery about my name I would be lucky not be locked up for the remainder of the war.")
              Text("\n")
          ConditionalBranch(true=false, else=true, inline=false)
            Weave(baseIndent=0)
              Text("\u0022I see.\u0022 He is starting to lose his patience. I have seen Harris angry a few times, with lackeys and secretaries. But never with us. With the \u0027brains\u0027 he has always been cautious, treating us like children.")
              Text("\n")
              Text("And now I see that, like a father, he wants to smack us when we disobey him.")
              Text("\n")
      Text("\n")
      Text("\u0022Just get to the truth, man. Every \u003Ci\u003Eminute\u003C/i\u003E matters.\u0022")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Persist with this")
        ContentList
          Text("\n")
        VariableReference(admitblackmail)
      Text("\u0022I know what you\u0027re thinking. If I\u0027ve transgressed once then I must be guilty of everything else... But I\u0027m not. We were close to cracking the 13th\u0027s intercept. We were getting correlations in the data. Then Hooper disappeared for a moment, and next minute the machine was down.\u0022")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Tell the truth")
        ContentList
          Text(" ")
          Text("\n")
      Text("\u0022Very well. I see there\u0027s no point in covering up. You know everything anyway.\u0022")
      Text("\n")
      Text("Harris nods, and waits for me to continue.")
      Text("\n")
      Divert(target="-\u003E i_met_a_young_man", empty=false, tunnel=false, thread=false)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Persist with this")
        ContentList
          Text("\n")
        Unary(not, VariableReference(admitblackmail))
      Text("\u0022This is the truth.\u0022")
      Text("\n")
      Gather(name=null, depth=1)
      Text("I have become, somehow, an accustomed liar \u2014 the words roll easily off my tongue. Perhaps I am a traitor, I think, now that I dissemble as easily as one.")
      Text("\n")
      Text("\u0022Go on,\u0022 Harris says, giving me no indication of whether he believes my tale.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Assert")
        ContentList
          Text(" \u0022I saw him take it,\u0022 I continue. \u0022Collins was outside having a cigarette. Peterson was at the table. But I was at the front of the machine. I saw Hooper go around the side. He leant down and pulled something free. I even challenged him. I said, \u0027What\u0027s that? Someone put a nail somewhere they shouldn\u0027t have?\u0027 He didn\u0027t reply.\u0022")
          Text("\n")
      Text("Harris watches me for a long moment.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Imply")
        ContentList
          Text(" \u0022At the moment the machine halted, Peterson was at the bench and Collins was outside having a smoke. I was checking the dip\u2014switches. Hooper was the only one at the back of the Bombe. No\u2014one else could have done it.\u0022")
          Text("\n")
      Text("\u0022That\u0027s not quite the same as seeing him do it,\u0022 Harris remarks.")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Logical")
          ContentList
            Text("\n")
        Text("\u0022When you have eliminated the impossible...\u0022 I begin, but Harris cuts me off.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Persuasive")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022You have to believe me.\u0022")
        Text("\n")
        Text("\u0022We don\u0027t have to believe anyone,\u0022 Harris returns. \u0022I will only be happy with the truth, and your story doesn\u0027t tie up. We know you\u0027ve been leaving yourself open to pressure. We\u0027ve been watching your activities for some time. But we thought you were endangering the reputation of this site; not risking the country herself. Perhaps I put too much trust in your intellectual pride.\u0022")
        Text("\n")
        Text("He pauses for a moment, considering something. Then he continues:")
        Text("\n")
        Text("\u0022It might have been Hooper. It might have been you. ")
        Divert(target="-\u003E we_wont_guess", empty=false, tunnel=false, thread=false)
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Confident")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022Ask the others,\u0022 I reply, leaning back. \u0022They\u0027ll tell you. If they haven\u0027t already, that\u0027s only because they\u0027re protecting Hooper. Hoping he\u0027ll come to his senses and stop being an idiot. I hope he does too. And if you lock him up in a freezing hut like you\u0027ve done me, I\u0027m sure he will.\u0022")
        Text("\n")
        Text("\u0022We have,\u0022 Harris replies simply.")
        Text("\n")
        Text("It\u0027s all I can do not to gape.")
        Text("\n")
        Divert(target="-\u003E hoopers_hut_3", empty=false, tunnel=false, thread=false)
      Gather(name=null, depth=1)
      Text("\u0022We are left with two possibilities. You, or Hooper.\u0022 The Commander pauses to smooth down his moustache. ")
      Glue
      Text("\n")
      Gather(name="hoopers_hut_3", depth=1)
      Text("\u0022Hooper\u0027s in Hut 3 with the Captain, having a similar conversation.\u0022")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("\u0022And the other men?")
        ContentList
          Text("\u0022")
        ContentList
          Text(" Do we have a hut each? Are there  enough senior officers to go round?\u0022")
          Text("\n")
      Text("\u0022Collins was outside when it happened, and Peterson can\u0027t get round the machine in that chair of his,\u0022 Harris replies. \u0022That leaves you and Hooper.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("\u0022Then you know I\u0027m right.")
        ContentList
          Text("\u0022")
        ContentList
          Text(" You knew all along. Why did you threaten me?\u0022")
          Text("\n")
      Text("\u0022All we know is that we have a traitor, holding the fate of the country in his hands.")
      Text("\n")
      Gather(name="we_wont_guess", depth=1)
      Glue
      Text(" We\u0027re not in the business of guessing here at Bletchley. We are military intelligence. We get answers.\u0022 Harris points a finger. \u0022And if that component has left these grounds, then every minute is critical.\u0022")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Co-operate")
        ContentList
          Text(" ")
          Text("\n")
      Text("\u0022I\u0027d be happy to help,\u0022 I answer, leaning forwards. \u0022I\u0027m sure there\u0027s something I could do.\u0022")
      Text("\n")
      Text("\u0022Like what, exactly?\u0022")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=false)
          ContentList
            Text("\u0022Put me in with Hooper.\u0022")
          ContentList
            Text("\n")
        Divert(target="-\u003E putmein", empty=false, tunnel=false, thread=false)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("\u0022Tell Hooper I\u0027ve confessed.")
          ContentList
            Text("\u0022")
          ContentList
            Text(" Better yet. Let him see you marching me off in handcuffs. Then let him go, and see what he does. Ten to one he\u0027ll go straight to wherever he\u0027s hidden that component and his game will be up.\u0022")
            Text("\n")
        Text("Harris nods slowly, chewing over the idea. It isn\u0027t a bad plan even \u2014 except, of course, Hooper has \u003Ci\u003Enot\u003C/i\u003E hidden the component, and won\u0027t lead them anywhere. But that\u0027s a problem I might be able to solve once I\u0027m out of this place; and once they\u0027re too busy dogging Hooper\u0027s steps from hut to hut.")
        Text("\n")
        Text("\u0022Interesting,\u0022 the Commander muses. \u0022But I\u0027m not so sure he\u0027d be that stupid. And if he\u0027s already passed the part on, the whole thing will only be a waste of time.\u0022")
        Text("\n")
        Weave(baseIndent=2)
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("\u0022Trust me. He hasn\u0027t.")
            ContentList
              Text("\u0022")
            ContentList
              Text(" If I know that man, and I do, he\u0027ll be wanting to keep his options open as long as possible. If the component\u0027s gone then he\u0027s in it up to his neck. He\u0027ll take a week at least to make sure he\u0027s escaped suspicion. Then he\u0027ll pass it on.\u0022")
              Text("\n")
          Text("\u0022And if we keep applying pressure to him, you think the component will eventually just turn up?\u0022")
          Text("\n")
          Weave(baseIndent=3)
            Choice(name=null, once=true, invisible=false, depth=4, inline=true)
              ContentList
                Text("\u0022Yes.")
              ContentList
                Text("\u0022")
              ContentList
                Text(" Probably under my bunk.\u0022")
                Text("\n")
            Text("Harris smiles wryly. \u0022We\u0027ll know that for a fake, then. We\u0027ve looked there already.")
            Text("\n")
            Choice(name=null, once=true, invisible=false, depth=4, inline=false)
              ContentList
                Text("\u0022Or be thrown into the river.\u0022 ")
              ContentList
                Text("\n")
            Text("\u0022Hmm.\u0022 Harris chews his moustache thoughtfully. \u0022Well, that would put us in a spot, seeing as how we\u0027d never know for certain. We\u0027d have to be ready to change our whole approach just in case the part had got through to the Germans.")
            Text("\n")
            Gather(name=null, depth=4)
            Glue
            Text(" I don\u0027t mind telling you, this is a disaster, this whole thing. What I want is to find that little bit of mechanical trickery. I don\u0027t care where. In your luncheon box or under Hooper\u0027s pillow. Just somewhere, and within the grounds of this place.\u0022")
            Text("\n")
            Choice(name=null, once=true, invisible=false, depth=4, inline=true)
              ContentList
                Text("\u0022Then let him he think he\u0027s off the hook.")
              ContentList
                Text("\u0022")
              ContentList
                Text(" Make a show of me. And then you\u0027ll get your man.\u0022")
                Text("\n")
            Text("\u003Ci\u003ESomehow\u003C/i\u003E, I think. But that\u0027s the part I need to work.")
            Text("\n")
            Divert(target="-\u003E harris_takes_you_to_hooper", empty=false, tunnel=false, thread=false)
            Choice(name=null, once=true, invisible=false, depth=4, inline=true)
              ContentList
                Text("\u0022Then you\u0027d better get searching")
              ContentList
                Text(".\u0022")
              ContentList
                Text(",\u0022 I reply, tiring of his complaining. A war is a war, you have to expect an enemy. ")
                Divert(target="-\u003E its_your_problem", empty=false, tunnel=false, thread=false)
                Text("\n")
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("\u0022You\u0027re right. Let me talk to him")
            ContentList
              Text(".\u0022")
            ContentList
              Text(", then. As a colleague. Maybe I can get something useful out of him.\u0022")
              Text("\n")
          Divert(target="-\u003E putmein", empty=false, tunnel=false, thread=false)
          Choice(name=null, once=true, invisible=false, depth=3, inline=false)
            ContentList
              Text("\u0022You\u0027re right.\u0022 ")
            ContentList
              Divert(target="-\u003E shake_head", empty=false, tunnel=false, thread=false)
              Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Block")
        ContentList
          Text(" ")
          Divert(target="-\u003E its_your_problem", empty=false, tunnel=false, thread=false)
          Text("\n")
    Flow(level=Stitch, name="harris_being_convinced", function=false)
      Weave(baseIndent=0)
        Text("\u0022Makes sense,\u0022 Harris agrees, cautiously. ")
        ContentList
          Conditional
            Binary(>, VariableReference(evasive), Number(1))
            ConditionalBranch(true=true, else=false, inline=true)
              Weave(baseIndent=0)
                Text("I can see he\u0027s still not entirely convinced by my tale, as well he might not be \u2014 I\u0027ve hardly been entirely straight with him.")
            ConditionalBranch(true=false, else=true, inline=true)
              Weave(baseIndent=0)
                Text("I can see he\u0027s still not certain whether he can trust me.")
        Text(" \u0022Which means the question is, what can we do to rat him out?\u0022")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Offer to help")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022Maybe I can help with that.\u0022")
        Text("\n")
        Text("\u0022Oh, yes? And how, exactly?\u0022")
        Text("\n")
        Weave(baseIndent=1)
          Choice(name=null, once=true, invisible=false, depth=2, inline=false)
            ContentList
              Text("\u0022I\u0027ll talk to him.\u0022 ")
            ContentList
              Text("\n")
          Text("\u0022What?\u0022")
          Text("\n")
          Text("\u0022Put me in with Hooper with him. Maybe I can get something useful out of him.\u0022")
          Text("\n")
          Divert(target="-\u003E putmein", empty=false, tunnel=false, thread=false)
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("\u0022We\u0027ll fool him.")
            ContentList
              Text("\u0022")
            ContentList
              Text(" He\u0027s waiting to be sure that I\u0027ve been strung up for this, so let\u0027s give him what he wants. If he sees me taken away, clapped in irons \u2014 he\u0027ll go straight to that component and set about getting rid of it.\u0022")
              Text("\n")
          Divert(target="-\u003E harris_takes_you_to_hooper", empty=false, tunnel=false, thread=false)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Don\u0027t offer to help")
          ContentList
            Text("\n")
        Text("I lean back. ")
        Divert(target="-\u003E its_your_problem", empty=false, tunnel=false, thread=false)
        Text("\n")
    Flow(level=Stitch, name="putmein", function=false)
      Weave(baseIndent=0)
        Text("Harris shakes his head.")
        Text("\n")
        Text("\u0022He despises you. I don\u0027t see why he\u0027d give himself up to you.\u0022")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Insist")
          ContentList
            Text(" \u0022Try me. Just me and him.\u0022 ")
            Text("\n")
        Divert(target="-\u003E go_in_alone", empty=false, tunnel=false, thread=false)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Give in")
          ContentList
            Text(" \u0022You\u0027re right.\u0022 ")
            Text("\n")
        Divert(target="-\u003E shake_head", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="shake_head", function=false)
      Weave(baseIndent=0)
        Glue
        Text(" I shake my head. \u0022You\u0027re right. I don\u0027t see how I can help you. So there\u0027s only one conclusion.\u0022")
        Text("\n")
        Text("\u0022Oh, yes? And what\u0027s that?\u0022")
        Text("\n")
        Divert(target="-\u003E its_your_problem", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="its_your_problem", function=false)
      Weave(baseIndent=0)
        Text("\u0022It\u0027s your problem. Your security breach. So much for your careful vetting process.\u0022")
        Text("\n")
        Text("I lean back in my chair and fold my arms so the way they shake will not be visible.")
        Text("\n")
        Text("\u0022You\u0027d better get on with solving it, instead of wasting your time in here with me.\u0022")
        Text("\n")
        Divert(target="-\u003E harrumphs", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="harrumphs", function=false)
      Weave(baseIndent=0)
        Text("Harris harrumphs. He\u0027s thinking it all over.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Wait")
          ContentList
            Text(" ")
            Text("\n")
          VariableReference(putmein)
        Text("\u0022All right,\u0022 he declares, gruffly. \u0022We\u0027ll try it. But if this doesn\u0027t work, I might just put the both of you in front of a firing squad and be done with these games. Worse things happen in time of war, you know.\u0022")
        Text("\n")
        Text("\u0022Alone,\u0022 I add.")
        Text("\n")
        Divert(target="-\u003E go_in_alone", empty=false, tunnel=false, thread=false)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Wait")
          ContentList
            Text(" ")
            Text("\n")
          VariableReference(putmein)
        Text("\u0022No,\u0022 Harris declares, finally. \u0022I think you\u0027re lying about Hooper. I think you\u0027re a clever, scheming young man \u2014 that\u0027s why we hired you \u2014 and you\u0027re looking for the only reasonable out this situation has to offer. But I\u0027m not taking it. We know you were in the room with the machine, we know you\u0027re of a perverted persuasion, we know you have compromised yourself. There\u0027s nothing more to say here. Either you tell me what you\u0027ve done with that component, or we will hang you and search just as hard. It\u0027s your choice.\u0022")
        Text("\n")
        Divert(target="-\u003E harris_threatens_lynching", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="go_in_alone", function=false)
      Weave(baseIndent=0)
        Text("\u0022Alone?\u0022")
        Text("\n")
        Text("\u0022Alone.\u0022")
        Text("\n")
        Text("Harris considers it. I watch his eyes, flicking backwards and forwards over mine, like a ribbon\u2014reader loading its program.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Patient")
          ContentList
            Text(" \u0022Well?\u0022")
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Impatient")
          ContentList
            Text(" \u0022For God\u0027s sake, man, what do you have to lose?\u0022 ")
            Text("\n")
        ContentList
          FunctionCall(raise, args=1)
          Text("\n")
        Gather(name=null, depth=1)
        Text("\u0022We\u0027ll be outside the door,\u0022 Harris replies, seriously. \u0022The first sign of any funny business and we\u0027ll have you both on the floor in minutes. You understand? The country needs your brain, but it\u0027s not too worried about your legs. Remember that.\u0022")
        Text("\n")
        Text("Then he gets to his feet, and opens the door, and marches me out across the yard. The evening is drawing in and there\u0027s a chill in the air. My mind is racing. I have one opportunity here \u2014 a moment in which to put the fear of God into Hooper and make him do something foolish that places him in harm\u0027s way. But how to achieve it?")
        Text("\n")
        Text("\u0022You ready?\u0022 Harris demands.")
        Text("\n")
        Choice(name="yes", once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Yes")
          ContentList
            Text("\n")
        Text("\u0022Absolutely.\u0022")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("No")
          ContentList
            Text("\n")
        Text("\u0022No.\u0022")
        Text("\n")
        Text("\u0022Too bad.\u0022")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Lie")
          ContentList
            Text(" ")
            Divert(target="-\u003E yes", empty=false, tunnel=false, thread=false)
            Text("\n")
        Gather(name=null, depth=1)
        Divert(target="-\u003E inside_hoopers_hut", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="harris_takes_you_to_hooper", function=false)
    Weave(baseIndent=0)
      Text("Harris gets to his feet. \u0022All right,\u0022 he says. \u0022I should no better than to trust a clever man, but we\u0027ll give it a go.\u0022")
      Text("\n")
      Text("Then, he smiles, with all his teeth, like a wolf.")
      Text("\n")
      ContentList
        Conditional
          VariableReference(claim_hooper_took_component.hoopers_hut_3)
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("\u0022Especially since this is a plan that involves keeping you in handcuffs. I don\u0027t see what I have to lose.\u0022")
              Text("\n")
          ConditionalBranch(true=false, else=true, inline=false)
            Weave(baseIndent=0)
              Text("\u0022Hooper\u0027s in Hut 3 being debriefed by the Captain. Let\u0027s see if we can\u0027t get his attention somehow.\u0022")
              Text("\n")
      Text("\n")
      Text("He raps on the door for the guard and gives the man a quick instruction. He returns a moment later with a cool pair of iron cuffs.")
      Text("\n")
      Text("\u0022Put \u0027em up,\u0022 Harris instructs, and I do so. The metal closes around my wrists like a trap. I stand and follow Harris willingly out through the door.")
      Text("\n")
      Text("But whatever I\u0027m doing with my body, my mind is scheming. \u003Ci\u003ESomehow,\u003C/i\u003E I\u0027m thinking, \u003Ci\u003EI have to get away from these men long enough to get that component behind Hut 2 and put it somewhere Hooper will go. Or, otherwise, somehow get Hooper to go there himself...\u003C/i\u003E")
      Text("\n")
      Text("Harris marches me over to Hut 3, and gestures for the guard to stand aside. Pushing me forward, he opens the door nice and wide.")
      Text("\n")
      Text("\u0022Captain. Manning talked. If you\u0027d step out for a moment?\u0022")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Play the part, head down")
        ContentList
          Text("\n")
      Text("From where he\u0027s sitting, I know Hooper can see me, so I keep my head down and look guilty as sin. The bastard is probably smiling.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Look inside the hut")
        ContentList
          Text("\n")
      Text("I look in through the door and catch Hooper\u0027s expression. I had half expected him to be smiling be he isn\u0027t. He looks shocked, almost hurt. \u0022Iain,\u0022 he murmurs. \u0022You couldn\u0027t...\u0022")
      Text("\n")
      Choice(name="shouted", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Call to Hooper")
        ContentList
          Text(" ")
          Text("\n")
      Text("I have a single moment to shout something to Hooper before the door closes.")
      Text("\n")
      Text("\u0022I\u0027ll get you Hooper, you\u0027ll see!\u0022 I cry. Then:")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("\u0022Queen to rook two, checkmate!\u0022")
          ContentList
            Text(" I call, then laugh viciously, as if I am damning him straight to hell.")
            Text("\n")
        VariableAssignment(name="hooperClueType", global=false, temp=false)
          VariableReference(CHESS)
        Gather(name="only_catch", depth=2)
        Text("I only catch Hooper\u0027s reaction for a moment \u2014 his eyebrow lifts in surprise and alarm. Good. If he thinks it is a threat then he just might be careless enough to go looking for what it might mean.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=false)
          ContentList
            Text("\u0022Ask not for whom the bell tolls!\u0022")
          ContentList
            Text("\n")
        Text("He stares back at me, as if were a madman and perhaps for a split second I see him shudder.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("\u0022Two words: messy, without one missing!\u0022")
          ContentList
            Text(" I cry, laughing. It isn\u0027t the best clue, hardly worthy of The Times, but it will have to do.")
            Text("\n")
        VariableAssignment(name="hooperClueType", global=false, temp=false)
          VariableReference(CROSSWORD)
        Divert(target="-\u003E only_catch", empty=false, tunnel=false, thread=false)
      Gather(name=null, depth=1)
      Text("The Captain comes outside, pulling the door to. \u0022What\u0027s this?\u0022 he asks. \u0022A confession? Just like that?\u0022")
      Text("\n")
      Text("\u0022No,\u0022 the Commander admits, in a low voice. \u0022I\u0027m afraid not. Rather more a scheme. The idea is to let Hooper go and see what he does. If he believes we have Manning here in irons, he\u0027ll try to shift the component.\u0022")
      Text("\n")
      Text("\u0022If he has it.\u0022")
      Text("\n")
      Text("\u0022Indeed.\u0022")
      Text("\n")
      Text("The Captain peers at me for a moment, like I was some kind of curious insect.")
      Text("\n")
      Text("\u0022Sometimes, I think you people are magicians,\u0022 he remarks. \u0022Other times you seem more like witches. Very well.\u0022")
      Text("\n")
      Text("With that he opens the door to the Hut and goes back inside. The Commander uses the moment to hustle me roughly forward.")
      Text("\n")
      ContentList
        Conditional
          VariableReference(shouted)
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("\u0022And what was all that shouting about?\u0022 he hisses in my ear as we move towards the barracks. \u0022Are you trying to pull something? Or just make me look incompetent?\u0022")
              Text("\n")
          ConditionalBranch(true=false, else=true, inline=false)
            Weave(baseIndent=0)
              Text("\u0022This scheme of yours had better come off,\u0022 he hisses in my ear. \u0022Otherwise the Captain is going to start having men tailing \u003Ci\u003Eme\u003C/i\u003E to see where I go on Saturdays.\u0022")
              Text("\n")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Reassure")
        ContentList
          Text(" ")
          Text("\n")
      ContentList
        Conditional
          Unary(not, VariableReference(shouted))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("\u0022It will. Hooper\u0027s running scared,\u0022 I reply, hoping I sound more confident than I feel.")
              Text("\n")
          ConditionalBranch(true=false, else=true, inline=false)
            Weave(baseIndent=0)
              Text("\u0022Just adding to the drama,\u0022 I tell him, confidently. \u0022I\u0027m sure you can understand that.\u0022")
              Text("\n")
      Text("\n")
      Text("\u0022I think we\u0027ve had enough drama today already,\u0022 Harris replies. \u0022Let\u0027s hope for a clean kill.\u0022")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Dissuade")
        ContentList
          Text(" ")
          Text("\n")
      ContentList
        Conditional
          Unary(not, VariableReference(shouted))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("\u0022The Captain thought it was a good scheme. You\u0027ll most likely get a promotion.\u0022")
              Text("\n")
          ConditionalBranch(true=false, else=true, inline=false)
            Weave(baseIndent=0)
              Text("\u0022I\u0027m not trying to do anything except save my neck.\u0022")
              Text("\n")
      Text("\n")
      Text("\u0022Let\u0027s hope things work out,\u0022 Harris agrees darkly.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Evade")
        ContentList
          Text(" ")
          Text("\n")
      Text("\u0022We\u0027re still in ear\u2014shot if they let Hooper go. Best get us inside and then we can talk, if we must.\u0022")
      Text("\n")
      Text("\u0022I\u0027ve had enough of your voice for one day,\u0022 Harris replies grimly. ")
      Glue
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Say nothing")
        ContentList
          Text("\n")
      Text("I let him have his rant. ")
      Glue
      Text("\n")
      Gather(name=null, depth=1)
      Text("He hustles me up the steps of the barracks, keeping me firmly gripped as if I had any chance of giving him, a trained military man, the slip. It\u0027s all I can do not to fall into the room.")
      Text("\n")
      Divert(target="-\u003E slam_door_shut_and_gone", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="inside_hoopers_hut", function=false)
    Weave(baseIndent=0)
      Gather(name=null, depth=1)
      Text("Harris opens the door and pushes me inside. \u0022Captain,\u0022 he calls. \u0022Could I have a moment?\u0022")
      Text("\n")
      Text("The Captain, looking puzzled, steps out. The door is closed. Hooper stares at me, open\u2014mouthed, about to say something. I probably have less than a minute before the Captain storms back in and declares this plan to be bunkum.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Threaten")
        ContentList
          Text("\n")
      Text("\u0022Listen to me, Hooper. We were the only men in that hut today, so we know what happened. But I want you to know this. I put the component inside a breeze\u2014block in the foundations of Hut 2, wrapped in one of your shirts. They\u0027re going to find it eventually, and that\u0027s going to be what tips the balance. And there\u0027s nothing you can do to stop any of that from happening.\u0022")
      Text("\n")
      VariableAssignment(name="hooperClueType", global=false, temp=false)
        VariableReference(STRAIGHT)
      Text("His eyes bulge with terror. \u0022What did I do, to you? What did I ever do?\u0022")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Tell the truth")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022You treated me like vermin. Like something abhorrent.\u0022")
        Text("\n")
        Text("\u0022You are something abhorrent.\u0022")
        Text("\n")
        Text("\u0022I wasn\u0027t. Not when I came here. And I won\u0027t be, once you\u0027re gone.\u0022")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Lie")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022Nothing,\u0022 I reply. \u0022You\u0027re just the other man in the room. One of us has to get the blame.\u0022")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Evade")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022It doesn\u0027t matter. Just remember what I said. I\u0027ve beaten you, Hooper. Remember that.\u0022")
        Text("\n")
        Gather(name=null, depth=2)
        Text("I get to my feet and open the door of the Hut. The Captain storms back inside and I\u0027m quickly thrown out. ")
        Divert(target="-\u003E hustled_out", empty=false, tunnel=false, thread=false)
        Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Bargain")
        ContentList
          Text(" ")
          Text("\n")
      Text("\u0022Hooper, I\u0027ll make a deal with you. We both know what happened in that hut this afternoon. I know because I did it, and you know because you know you didn\u0027t. But once this is done I\u0027ll be rich, and I\u0027ll split that with you. I\u0027ll let you have the results, too. Your name on the discovery of the Bombe. And it won\u0027t hurt the war effort \u2014 you know as well as me that the component on its own is worthless, it\u0027s the wiring of the Bombe, the usage, that\u0027s what\u0027s valuable. So how about it?\u0022")
      Text("\n")
      Text("Hooper looks back at me, appalled. \u0022You\u0027re asking me to commit treason?\u0022")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Yes")
          ContentList
            Text("\n")
        Text("\u0022Yes, perhaps. But also to ensure your name goes down in the annals of mathematics. ")
        Divert(target="-\u003E back_of_hut_2", empty=false, tunnel=false, thread=false)
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("No")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022No. It\u0027s not treason. It\u0027s a trade, plain and simple.\u0022")
        Text("\n")
        Choice(name="lie", once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Lie")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022I\u0027m suggesting you save your own skin. I\u0027ve wrapped that component in one of your shirts, Hooper. They\u0027ll be searching this place top to bottom. They\u0027ll find it eventually, and when they do, that\u0027s the thing that will swing it against you. So take my advice now. Hut 2.\u0022")
        Text("\n")
        VariableAssignment(name="hooperClueType", global=false, temp=false)
          VariableReference(STRAIGHT)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Evade")
          ContentList
            Text(" ")
            Divert(target="-\u003E lie", empty=false, tunnel=false, thread=false)
            Text("\n")
        Gather(name=null, depth=2)
        Divert(target="-\u003E no_chance", empty=false, tunnel=false, thread=false)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Plead")
        ContentList
          Text(" ")
          Text("\n")
      Text("\u0022Please, Hooper. You don\u0027t understand. They have information on me.  I don\u0027t need to tell you what I\u0027ve done, you know. Have a soul. And the component \u2014 it\u0027s nothing. It\u0027s not the secret of the Bombe. It\u0027s just a part. The German\u0027s think it\u0027s a weapon \u2014 a missile component. Let them have it. Please, man. Just help me.\u0022")
      Text("\n")
      Text("\u0022Help you?\u0022 Hooper stares. \u0022Help you? You\u0027re a traitor. A snake in the grass. And you\u0027re \u003Ci\u003Equeer\u003C/i\u003E.\u0022")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Deny")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022I\u0027m no traitor. You \u003Ci\u003Eknow\u003C/i\u003E I\u0027m not. How much work have I done here against the Germans? I\u0027ve given my all. And you know as well as I do, if the Reich were to invade, I would be a dead man. Please, Hooper. I\u0027m not doing any of this lightly.\u0022")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Accept")
          ContentList
            Text("\n")
        Text("\u0022I am what I am,\u0022 I reply. \u0022I\u0027m the way I was made. But they\u0027ll hang me unless you help, Hooper. Don\u0027t let them hang me.\u0022")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Evade")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022That\u0027s not important now. What matters is what you do, this evening.\u0022")
        Text("\n")
        Gather(name=null, depth=2)
        Text("\u0022Assuming I wanted to help you,\u0022 he replies, carefully. \u0022Which I don\u0027t. What would I do?\u0022")
        Text("\n")
        Text("\u0022Nothing. Almost nothing.")
        Text("\n")
        Divert(target="-\u003E back_of_hut_2", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="back_of_hut_2", function=false)
      Weave(baseIndent=0)
        Glue
        Text(" All you have to do is go to the back of Hut 2. There\u0027s a breeze\u2014block with a cavity. That\u0027s where I\u0027ve put it. I\u0027ll be locked up overnight. But you can pick it up and pass it to my contact. He\u0027ll be at the south fence around two AM.\u0022")
        Text("\n")
        VariableAssignment(name="hooperClueType", global=false, temp=false)
          VariableReference(STRAIGHT)
        Divert(target="-\u003E no_chance", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="no_chance", function=false)
      Weave(baseIndent=0)
        Text("\u0022If you think I\u0027ll do that then you\u0027re crazy,\u0022 Hooper replies.")
        Text("\n")
        Text("At that moment the door flies open and the Captain comes storming back inside.")
        Text("\n")
        Divert(target="-\u003E hustled_out", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="hustled_out", function=false)
      Weave(baseIndent=0)
        Text("Harris hustles me over to the barracks. \u0022I hope that\u0027s the end of it,\u0022 he mutters.")
        Text("\n")
        Text("\u0022Just be sure to let him out,\u0022 I reply. \u0022And then see where he goes.\u0022")
        Text("\n")
        Divert(target="-\u003E slam_door_shut_and_gone", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="slam_door_shut_and_gone", function=false)
    Weave(baseIndent=0)
      Text("Then they slam the door shut, and it locks.")
      Text("\n")
      ContentList
        Conditional
          Binary(==, VariableReference(hooperClueType), VariableReference(NONE))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Glue
              Text(" How am I supposed to manage anything from in here?")
              Text("\n")
              Choice(name=null, once=true, invisible=false, depth=1, inline=true)
                ContentList
                  Text("Try the door")
                ContentList
                  Text(" ")
                  Divert(target="-\u003E try_the_door", empty=false, tunnel=false, thread=false)
                  Text("\n")
              Choice(name=null, once=true, invisible=false, depth=1, inline=true)
                ContentList
                  Text("Try the windows")
                ContentList
                  Text(" ")
                  Divert(target="-\u003E try_the_windows", empty=false, tunnel=false, thread=false)
                  Text("\n")
          ConditionalBranch(true=false, else=true, inline=false)
            Weave(baseIndent=0)
              Text("I can only hope that Hooper bites. If he thinks I\u0027m bitter enough to have framed him, and arrogant enough to have taunted him with ")
              ContentList
                Conditional
                  Binary(>, VariableReference(hooperClueType), VariableReference(STRAIGHT))
                  ConditionalBranch(true=true, else=false, inline=true)
                    Weave(baseIndent=0)
                      Text("a clue to")
              Text(" where the damning evidence is hidden...")
              Text("\n")
              Text("If he hates me enough, and is paranoid enough, then he might ")
              ContentList
                Conditional
                  Binary(>, VariableReference(hooperClueType), VariableReference(STRAIGHT))
                  ConditionalBranch(true=true, else=false, inline=true)
                    Weave(baseIndent=0)
                      Text("unravel my little riddle and")
              Text(" go searching around Hut 2.")
              Text("\n")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Wait")
        ContentList
          Text(" \t")
          Divert(target="-\u003E night_falls", empty=false, tunnel=false, thread=false)
          Text("\n")
    Flow(level=Stitch, name="try_the_door", function=false)
      Weave(baseIndent=0)
        Text("I try the door. It\u0027s locked, of course.")
        Text("\n")
        Divert(target="-\u003E from_outside_heard", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="from_outside_heard", function=false)
      Weave(baseIndent=0)
        Text("From outside, I hear a voice. Hooper\u0027s. He\u0027s haranguing someone.")
        Text("\n")
        Gather(name="opts", depth=1)
        Choice(name="listened", once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Listen at the keyhole")
          ContentList
            Text(" ")
            Text("\n")
        Text("I put my ear down to the keyhole, but there\u0027s nothing now. Probably still a guard outside, of course, but they\u0027re keeping mum.")
        Text("\n")
        Divert(target="-\u003E opts", empty=false, tunnel=false, thread=false)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Try the window")
          ContentList
            Text(" ")
            Divert(target="-\u003E try_the_windows", empty=false, tunnel=false, thread=false)
            Text("\n")
          Unary(not, VariableReference(try_the_windows))
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Try the door")
          ContentList
            Text(" ")
            Divert(target="-\u003E try_the_door", empty=false, tunnel=false, thread=false)
            Text("\n")
          MultipleCondition(Unary(not, VariableReference(try_the_door)), VariableReference(listened))
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Smash the window")
          ContentList
            Text(" ")
            Divert(target="-\u003E try_to_smash_the_window", empty=false, tunnel=false, thread=false)
            Text("\n")
          VariableReference(try_the_windows)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Wait")
          ContentList
            Text(" ")
            Text("\n")
          Binary(&&, VariableReference(try_the_door), VariableReference(try_the_windows))
        Text("It\u0027s useless. There\u0027s nothing I can do but hope. I sit down on one corner of the bunk to wait.")
        Text("\n")
        Divert(target="-\u003E night_falls", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="try_the_windows", function=false)
      Weave(baseIndent=0)
        Text("I go over to the window and try to jimmy it open. Not much luck, but in my struggling I notice this window only backs on the thin little brook that runs down the back of the compound. Which means, if I smashed it, I might get away with no\u2014one seeing.")
        Text("\n")
        Divert(target="-\u003E from_outside_heard", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="try_to_smash_the_window", function=false)
      Weave(baseIndent=0)
        Text("The window is my only way out of here. I just need a way to smash it.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Punch it")
          ContentList
            Text(" ")
            Text("\n")
        Text("I suppose my fist would do a good enough job. But I\u0027d cut myself to ribbons, most likely. ")
        Glue
        Text("\n")
        Choice(name="use_bucket", once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Find something")
          ContentList
            Text(" ")
            Text("\n")
        VariableAssignment(name="smashingWindowItem", global=false, temp=false)
          VariableReference(BUCKET)
        Text("I cast around the small room. There\u0027s a bucket in one corner for emergencies \u2014 I suppose I could use that. I pick it up but it\u0027s not very easy to heft. ")
        Glue
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Use something you\u0027ve got")
          ContentList
            Text(" ")
            Text("\n")
        Text("I pat down my pockets but all I\u0027m carrying is the intercept, which is no good at all.")
        Text("\n")
        Weave(baseIndent=1)
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("Something you\u0027re wearing?")
            ContentList
              Text(" ")
              Text("\n")
          Text("Ah, but of course! I slip off one shoe and heft it by the toe. The heel will make a decent enough hammer, if I give it enough wallop.")
          Text("\n")
          VariableAssignment(name="smashingWindowItem", global=false, temp=false)
            VariableReference(SHOE)
          Text("But I\u0027ll cut my hand to ribbons doing it. ")
          Glue
          Text("\n")
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("Look around")
            ContentList
              Text(" ")
              Divert(target="-\u003E use_bucket", empty=false, tunnel=false, thread=false)
              Text("\n")
        Gather(name=null, depth=1)
        Text("And the noise would be terrible. There must be a way of making this easier. I\u0027m supposed to be a thief now. What would a burglar do?")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Work slowly")
          ContentList
            Text(" ")
            Text("\n")
        Text("Work carefully? It\u0027s difficult to work carefully when all one\u0027s has is ")
        ContentList
          Conditional
            Binary(==, VariableReference(smashingWindowItem), VariableReference(BUCKET))
            ConditionalBranch(true=true, else=false, inline=true)
              Weave(baseIndent=0)
                Text("a bucket. It\u0027s rather like the sledgehammer for the proverbial nut")
            ConditionalBranch(true=false, else=true, inline=true)
              Weave(baseIndent=0)
                ContentList
                  Conditional
                    Binary(==, VariableReference(smashingWindowItem), VariableReference(SHOE))
                    ConditionalBranch(true=true, else=false, inline=true)
                      Weave(baseIndent=0)
                        Text("a shoe")
                    ConditionalBranch(true=false, else=true, inline=true)
                      Weave(baseIndent=0)
                        Text("nothing but brute force")
        Text(".")
        Text("\n")
        Weave(baseIndent=1)
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("Just do it")
            ContentList
              Text(" ")
              Divert(target="-\u003E time_to_move_now", empty=false, tunnel=false, thread=false)
              Text("\n")
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("Look around for something")
            ContentList
              Text(" ")
              Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Find something to help")
          ContentList
            Text(" ")
            Text("\n")
        Gather(name=null, depth=1)
        Divert(target="-\u003E find_something_to_smash_window", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="time_to_move_now", function=false)
      Weave(baseIndent=0)
        Text("Enough of this. There isn\u0027t any time to lose. Right now they\u0027ll be following Hooper as he goes to bed, and goes to sleep; and then that\u0027s it. The minute he closes his eyelids and drifts off that\u0027s the moment that this trap swings shut on me.")
        Text("\n")
        Text("So I punch out the glass with my ")
        ContentList
          Conditional
            Binary(==, VariableReference(smashingWindowItem), VariableReference(BUCKET))
            ConditionalBranch(true=true, else=false, inline=true)
              Weave(baseIndent=0)
                Text("bucket")
            ConditionalBranch(true=false, else=true, inline=true)
              Weave(baseIndent=0)
                ContentList
                  Conditional
                    Binary(==, VariableReference(smashingWindowItem), VariableReference(SHOE))
                    ConditionalBranch(true=true, else=false, inline=true)
                      Weave(baseIndent=0)
                        Text("shoe")
                    ConditionalBranch(true=false, else=true, inline=true)
                      Weave(baseIndent=0)
                        Text("fist")
        Text(" and it shatters with a terrific noise. Then I stop, and wait, to see if anyone will come in through the door.")
        Text("\n")
        Text("Nothing.")
        Text("\n")
        Choice(name="pause", once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Wait a little longer")
          ContentList
            Text(" ")
            Text("\n")
        Text("I pause for a moment longer. It doesn\u0027t do to be too careless...")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Clear the frame of shards")
          ContentList
            Text("\n")
        Text("With my jacket wrapped round my arm, I sweep out the remaining shards of glass. It\u0027s not a big window, but I\u0027m not a big man. If I was Harris, I\u0027d be stuffed, but as it is...")
        Text("\n")
        Gather(name=null, depth=1)
        Text("Then the door locks turns. The door opens. Then Jeremy \u2014 one of the guards, rather \u2014 sticks his head through the door. \u0022I thought I heard...\u0022")
        Text("\n")
        Text("He stops. Looks for a moment. ")
        ContentList
          Conditional
            Binary(==, VariableReference(smashingWindowItem), VariableReference(BUCKET))
            ConditionalBranch(true=true, else=false, inline=true)
              Weave(baseIndent=0)
                Text("Sees the bucket in my hand.")
            ConditionalBranch(true=false, else=true, inline=true)
              Weave(baseIndent=0)
                Text("Sees the broken window.")
        Text(" Then without a moment\u0027s further thought he blows his shrill whistles and hustles into the hut, grabbing me roughly by my arms.")
        Text("\n")
        ContentList
          Conditional
            VariableReference(pause)
            ConditionalBranch(true=true, else=false, inline=false)
              Weave(baseIndent=0)
                Text("I\u0027ll never know if I hadn\u0027t have waited that extra moment \u2014 maybe I still could have got away. But, how far?")
                Text("\n")
        Text("\n")
        Text("I\u0027m hustled into one of the huts. Nowhere to sleep, but they\u0027re not interested in my comfort any longer. Harris comes in with the Captain.")
        Text("\n")
        Text("\u0022So,\u0022 Harris remarks. \u0022Looks like your little trap worked. Only it worked to show \u003Ci\u003Eyou\u003C/i\u003E out for what you are.\u0022")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Tell the truth")
          ContentList
            Text(" ")
            Text("\n")
        ContentList
          Conditional
            VariableReference(i_met_a_young_man)
            ConditionalBranch(true=true, else=false, inline=false)
              Weave(baseIndent=0)
                Text("\u0022Please, Harris. You can\u0027t understand the pressure they put me under. You can\u0027t understand what it\u0027s like, to be in love but be able to do nothing about it...\u0022")
                Text("\n")
            ConditionalBranch(true=false, else=true, inline=false)
              Weave(baseIndent=0)
                Text("\u0022Harris. They were blackmailing me. They knew about... certain indiscretions. You can understand, can\u0027t you, Harris? I was in an impossible bind...\u0022")
                Text("\n")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Lie")
          ContentList
            Text("\n")
        Text("\u0022I had to get out, Harris. I had to provoke Hooper into doing something that would incriminate himself fully. He\u0027s too clever, you see...\u0022")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Evade")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022This proves nothing,\u0022 I reply stubbornly. \u0022You still don\u0027t have the component and without it, I don\u0027t see what you can hope to prove.\u0022")
        Text("\n")
        Gather(name=null, depth=1)
        Text("\u0022Be quiet, man. We know all about your and your sordid affairs.\u0022 The Captain curls his lip. \u0022Don\u0027t you know there\u0027s a war on? Do you know the kind of place they would have sent you if it haven\u0027t had been for that brain of yours? Don\u0027t you think you owe it to your country to use it a little more?\u0022")
        Text("\n")
        Text("\u003Ci\u003EDo I\u003C/i\u003E, I wonder? \u003Ci\u003EDo I owe this country anything, this country that has spurned who and what am I since the day I became a man?\u003C/i\u003E")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Yes")
          ContentList
            Text(" ")
            Text("\n")
        Text("My anger deflates like a collapsing equation, all arguments cancelling each other out. The world, of course, owes me nothing; and I owe it everything.")
        Text("\n")
        Choice(name="alone", once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("No")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u003Ci\u003EOf course not. I am alone; that is what they wanted me to be, because of who and what I love. So I have no nation, no country.\u003C/i\u003E")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Lie")
          ContentList
            Text(" \t")
            Divert(target="-\u003E alone", empty=false, tunnel=false, thread=false)
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Evade")
          ContentList
            Text(" \t")
            Text("\n")
        Text("\u003Ci\u003EBut what is a country, after all? A country is not a concept, not an ideal. Every country falls, its borders shift and move, its language disappears to be replaced by another. Neither the Reich nor the British Empire will survive forever, so what use is my loyalty to either? \u003C/i\u003E")
        Text("\n")
        Text("\u003Ci\u003EI may as well, therefore, look after myself. Something I have attempted, but failed miserably, to do.\u003C/i\u003E")
        Text("\n")
        Gather(name=null, depth=1)
        Text("\u0022I\u0027m afraid we have only one option, Manning,\u0022 Harris says. \u0022Please, man. Tell us where the component is.\u0022")
        Text("\n")
        VariableAssignment(name="notraitor", global=false, temp=false)
          Number(true)
        VariableAssignment(name="losttemper", global=false, temp=false)
          Number(false)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Tell them")
          ContentList
            Text("\n")
        VariableAssignment(name="revealedhooperasculprit", global=false, temp=false)
          Number(false)
        Text("\u0022All right.\u0022 I am beaten, after all. \u0022")
        Glue
        Divert(target="-\u003E reveal_location_of_component", empty=false, tunnel=false, thread=false)
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Say nothing")
          ContentList
            Text(" ")
            Divert(target="-\u003E my_lips_are_sealed", empty=false, tunnel=false, thread=false)
            Text("\n")
    Flow(level=Stitch, name="find_something_to_smash_window", function=false)
      Weave(baseIndent=0)
        Text("Let me see. There\u0027s the bunk, ")
        ContentList
          Conditional
            Binary(==, Unary(not, VariableReference(smashingWindowItem)), VariableReference(BUCKET))
            ConditionalBranch(true=true, else=false, inline=true)
              Weave(baseIndent=0)
                Text("a bucket,")
        Text(" nothing else. I have my jacket but nothing in the pockets \u2014 no handkerchief, for instance.")
        Text("\n")
        Gather(name="opts", depth=1)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("The bunk")
          ContentList
            Text(" \t")
            Text("\n")
        Text("The bunk has a solid metal frame, a blanket, a pillow, nothing more.")
        Text("\n")
        Weave(baseIndent=1)
          Gather(name="bunk_opts", depth=2)
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("The frame")
            ContentList
              Text("\n")
          Text("The frame is heavy and solid. I couldn\u0027t lift it or shift it without help from another man. And it wouldn\u0027t do me any good here anyway. I can reach the window perfectly well.")
          Text("\n")
          Divert(target="-\u003E bunk_opts", empty=false, tunnel=false, thread=false)
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("The blanket")
            ContentList
              Text(" ")
              Text("\n")
          Text("The blanket. Perfect. I scoop it up off the bed and hold it in place over the window. ")
          Divert(target="-\u003E smash_the_window", empty=false, tunnel=false, thread=false)
          Text("\n")
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("The pillow")
            ContentList
              Text(" ")
              Text("\n")
          Text("The pillow is fat and fluffy. I could put it over the window and it would muffle the sound of breaking glass, certainly; but I wouldn\u0027t be able to break any glass through it either.")
          Text("\n")
          Divert(target="-\u003E bunk_opts", empty=false, tunnel=false, thread=false)
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("Something else")
            ContentList
              Text(" ")
              Divert(target="-\u003E opts", empty=false, tunnel=false, thread=false)
              Text("\n")
            Binary(>, VariableReference(bunk_opts), Number(1))
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("The jacket")
          ContentList
            Text(" ")
            Text("\n")
        Text("I slip off my jacket and hold it with one hand over the glass. ")
        Divert(target="-\u003E smash_the_window", empty=false, tunnel=false, thread=false)
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("The bucket")
          ContentList
            Text(" ")
            Text("\n")
          Binary(==, Unary(not, VariableReference(smashingWindowItem)), VariableReference(BUCKET))
        Text("The bucket? Hardly. The bucket might do some good if I wanted to sweep up the glass afterwards, but it won\u0027t help me smash the glass quietly.")
        Text("\n")
        Divert(target="-\u003E opts", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="smash_the_window", function=false)
    Weave(baseIndent=0)
      Text("Then I heft ")
      ContentList
        Conditional
          Binary(==, VariableReference(smashingWindowItem), VariableReference(BUCKET))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("up the bucket \u2014 this really is quite a fiddly thing to be doing in cuffs \u2014 ")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              ContentList
                Conditional
                  Binary(==, VariableReference(smashingWindowItem), VariableReference(SHOE))
                  ConditionalBranch(true=true, else=false, inline=true)
                    Weave(baseIndent=0)
                      Text(" my shoe by its toe, ")
                  ConditionalBranch(true=false, else=true, inline=true)
                    Weave(baseIndent=0)
                      Text("back my arm, ")
      Text(" and take a strong swing, trying to imagine it\u0027s Harris\u0027 face on the other side.")
      Text("\n")
      VariableAssignment(name="smashedglass", global=false, temp=false)
        Number(true)
      VariableAssignment(name="smashingWindowItem", global=false, temp=false)
        VariableReference(NONE)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Smash!")
        ContentList
          Text("\n")
      Gather(name=null, depth=1)
      Text("The sound of the impact is muffled. With my arm still covered, I sweep out the remaining glass in the frame.")
      Text("\n")
      Gather(name=null, depth=1)
      Text("I\u0027m ready to escape. The only trouble is \u2014 when they look in on me in the morning, there will be no question what has happened. It won\u0027t help me one jot with shifting suspicion off my back.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Wait")
        ContentList
          Text("\n")
      Text("So perhaps I should wait it out, after all. Who knows? I might have a better opportunity later.")
      Text("\n")
      Divert(target="-\u003E night_passes", empty=false, tunnel=false, thread=false)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Slip out")
        ContentList
          Text(" ")
          Text("\n")
      Text("Moving quickly and quietly, I hoist myself up onto the window\u2014frame and worm my way outside into the freezing night air. Then I am away, slipping down the paths between the Huts, sticking to the shadows, on my way to Hut 2.")
      Text("\n")
      Gather(name=null, depth=1)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Go the shortest way")
        ContentList
          Text(" ")
          Text("\n")
      Text("There\u0027s no time to lose. Throwing caution to the wind I make my way quickly to Hut 2, and around the back. I don\u0027t think I\u0027ve been seen but if I have it is too late. My actions are suspicious enough for the noose. I have no choice but to follow through.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Take a longer route")
        ContentList
          Text("\n")
      Text("In case I\u0027m being followed, I divert around the perimeter of the compound. It\u0027s a much longer path, and it takes me across some terrain that\u0027s difficult to negotiate in the dark \u2014 muddy, and thick with thistles and nestles.")
      Text("\n")
      VariableAssignment(name="muddyshoes", global=false, temp=false)
        Number(true)
      Text("Still, I can be confident no\u2014one is behind me. I crouch down behind the rear wall of Hut 2. ")
      Glue
      Text("\n")
      Gather(name=null, depth=1)
      Text("The component is still there, wrapped in a tea\u2014towel and shoved into a cavity in a breeze\u2014block at the base of the Hut wall.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Take it")
        ContentList
          Text(" ")
          Text("\n")
      Text("Quickly, I pull it free, and slip it into the pocket of my jacket.")
      Text("\n")
      VariableAssignment(name="gotcomponent", global=false, temp=false)
        Number(true)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Leave it")
        ContentList
          Text(" ")
          Text("\n")
      Text("Still there means no\u2014one has found it, which means it is probably well\u2014hidden. And short of skipping the compound now, I can afford to leave it hidden there a while longer. So I leave it in place.")
      Text("\n")
      Gather(name=null, depth=1)
      Text("Where now?")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Back to the barracks")
        ContentList
          Text(" ")
          Divert(target="-\u003E return_to_room_after_excursion", empty=false, tunnel=false, thread=false)
          Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Go to Hooper\u0027s dorm")
        ContentList
          Text(" ")
          Divert(target="-\u003E go_to_hoopers_dorm", empty=false, tunnel=false, thread=false)
          Text("\n")
        VariableReference(gotcomponent)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Escape the compound")
        ContentList
          Text(" ")
          Text("\n")
      Text("Enough of this place. Time for me to get moving. I can get to the train station on foot, catch the postal train to Scotland and be somewhere else before anyone realises that I\u0027m gone.")
      Text("\n")
      Text("Of course, then they\u0027ll be looking for me in earnest. ")
      ContentList
        Conditional
          Unary(not, VariableReference(framedhooper))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("As a confirmed traitor.")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("Perhaps not as a traitor \u2014 they might take the idea that Hooper was involved with the theft \u2014 but certainly as a valuable mind, one containing valuable secrets and all too easily threatened. They will think I am running away because of my indiscretions. I suppose, in fairness, that I am.")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Go")
          ContentList
            Text(" \t\t\t")
            Divert(target="-\u003E live_on_the_run", empty=false, tunnel=false, thread=false)
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Don\u0027t go")
          ContentList
            Text(" ")
            Text("\n")
        Text("It\u0027s no good. That\u0027s only half a solution. I couldn\u0027t be happy with that.")
        Text("\n")
        Weave(baseIndent=2)
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("Back to the barracks")
            ContentList
              Text(" \t\t\t")
              Divert(target="-\u003E return_to_room_after_excursion", empty=false, tunnel=false, thread=false)
              Text("\n")
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("To Hooper\u0027s dorm")
            ContentList
              Text(" ")
              Divert(target="-\u003E go_to_hoopers_dorm", empty=false, tunnel=false, thread=false)
              Text("\n")
            Binary(&&, VariableReference(gotcomponent), Unary(not, VariableReference(go_to_hoopers_dorm)))
  Flow(level=Knot, name="go_to_hoopers_dorm", function=false)
    Weave(baseIndent=0)
      Text("I creep around the outside of the huts towards Hooper\u0027s dorm. Time to wrap up this little game once and for all. A few guards patrol the area at night but not many \u2014 after all, very few know this place even exists.")
      Text("\n")
      Text("Our quarters are arranged away from the main house; where we sleep is of less importance than where we work. We each have our own hut, through some are less permanent than others. Hooper\u0027s is a military issue tent: quite a large canopy, with two rooms inside and a short porch area where he insists people leave their shoes. It\u0027s all zipped up for the night and no light shines from inside.")
      Text("\n")
      Text("I hang back for a moment. If Harris is keeping to the terms of our deal then someone will be watching this place. But I can see no\u2014one.")
      Text("\n")
      Choice(name="outer_zip", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Open the outer zip")
        ContentList
          Text(" ")
          Text("\n")
      Text("I creep forward to the tent, intent on lifting the zip to the front porch area just a little \u2014 enough to slip the component inside, and without the risk of the noise waking Hooper from his snoring.")
      Text("\n")
      Text("The work is careful, and more than little fiddly \u2014 Hooper has tied the zips down on the inside, the fastidious little bastard! \u2014 but after a little work I manage to make a hole large enough for my hand.")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Slip in the component")
          ContentList
            Text(" \t\t")
            Text("\n")
        Text("I slide the component into the tent, work the zip closed, and move quickly away into the shadows. It takes a few minutes for my breath to slow, and my heart to stop hammering, but I see no other movement. If anyone is watching Hooper\u0027s tent, they are asleep at their posts.")
        Text("\n")
        VariableAssignment(name="putcomponentintent", global=false, temp=false)
          Number(true)
        VariableAssignment(name="gotcomponent", global=false, temp=false)
          Number(false)
        Divert(target="-\u003E return_to_room_after_excursion", empty=false, tunnel=false, thread=false)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("No, some other way")
          ContentList
            Text(" \t\t\t")
            Text("\n")
        Text("Then pause. This is too transparent. Too blatant. If I leave it here, like this, Hooper will never be seen to go looking for it: he will stumble over it in plain sight, and the men watching will wonder why it was not there when he went to bed.")
        Text("\n")
        Text("No, I must try something else \u2014 or nothing at all.")
        Text("\n")
        Weave(baseIndent=2)
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("On top of the tent")
            ContentList
              Text(" ")
              Divert(target="-\u003E put_component_on_tent", empty=false, tunnel=false, thread=false)
              Text("\n")
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("Throw the component into the long grass")
            ContentList
              Text(" ")
              Text("\n")
          Text("From inspiration \u2014 or desperation, I am not certain \u2014 a simple approach occurs to me. ")
          Divert(target="-\u003E toss_component_into_bushes", empty=false, tunnel=false, thread=false)
          Text("\n")
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("Give up")
            ContentList
              Text(" ")
              Text("\n")
          Text("There is nothing to be gained here. I have the component now; maybe it will be of some value tomorrow.")
          Text("\n")
          Weave(baseIndent=3)
            Choice(name=null, once=true, invisible=false, depth=4, inline=true)
              ContentList
                Text("Return to my barrack")
              ContentList
                Text(" ")
                Divert(target="-\u003E return_to_room_after_excursion", empty=false, tunnel=false, thread=false)
                Text("\n")
            Choice(name=null, once=true, invisible=false, depth=4, inline=true)
              ContentList
                Text("Escape the compound")
              ContentList
                Text(" ")
                Divert(target="-\u003E live_on_the_run", empty=false, tunnel=false, thread=false)
                Text("\n")
      Choice(name="wide_circuit", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Look for another opening")
        ContentList
          Text(" ")
          Text("\n")
      Text("Making a wide circuit I creep around the tent. It has plenty of other flaps and openings, tied down with Gordian complexity. But nothing afford itself to slipping the component inside.")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Try the porch zip")
          ContentList
            Text(" \t\t\t")
            Divert(target="-\u003E outer_zip", empty=false, tunnel=false, thread=false)
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Try on top of the tent")
          ContentList
            Text(" \t\t")
            Divert(target="-\u003E put_component_on_tent", empty=false, tunnel=false, thread=false)
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Give up")
          ContentList
            Text(" \t\t\t\t\t\t")
            Text("\n")
        Text("It\u0027s no good. Nothing I can do will be any less than obvious \u2014 something appearing where something was not there before. The men watching Hooper will know it is a deception and Hooper\u0027s protestations will be taken at face value.")
        Text("\n")
        Text("If I can\u0027t find a way for Hooper to pick the component up, as if from a hiding place of his own devising, and be caught doing it, then I have no plan at all.")
        Text("\n")
        Weave(baseIndent=2)
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("Return to my barrack")
            ContentList
              Text(" ")
              Divert(target="-\u003E return_to_room_after_excursion", empty=false, tunnel=false, thread=false)
              Text("\n")
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("Escape the compound")
            ContentList
              Text(" ")
              Divert(target="-\u003E live_on_the_run", empty=false, tunnel=false, thread=false)
              Text("\n")
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("Toss the component into the bushes")
            ContentList
              Text(" ")
              Divert(target="-\u003E toss_component_into_bushes", empty=false, tunnel=false, thread=false)
              Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Hide the component somewhere")
        ContentList
          Text(" ")
          Text("\n")
      Text("If I leave the component here somewhere it should be somewhere I can rely on Hooper finding it, but no\u2014one before Hooper. In particular.")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Behind the tent")
          ContentList
            Text("\t\t\t \t")
            Divert(target="-\u003E wide_circuit", empty=false, tunnel=false, thread=false)
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Inside the porch section")
          ContentList
            Text(" \t\t")
            Divert(target="-\u003E outer_zip", empty=false, tunnel=false, thread=false)
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("On top of the canvas")
          ContentList
            Text(" \t\t\t")
            Divert(target="-\u003E put_component_on_tent", empty=false, tunnel=false, thread=false)
            Text("\n")
    Flow(level=Stitch, name="put_component_on_tent", function=false)
      Weave(baseIndent=0)
        Text("A neat idea strikes me. If I could place it on top of the canvas, somewhere in the middle where it would bow the cloth inwards, then it would be invisible to anyone passing by. But to Hooper, it would be above him: a shadow staring him in the face as he awoke. What could be more natural than getting up, coming out, and looking to see what had fallen on him during the night?")
        Text("\n")
        Text("It\u0027s the work of a moment. I was once an excellent bowler for the second XI back at school. This time I throw underarm, of course, but I still land the vital missing component exactly where I want it to go.")
        Text("\n")
        VariableAssignment(name="framedhooper", global=false, temp=false)
          Number(true)
        VariableAssignment(name="gotcomponent", global=false, temp=false)
          Number(false)
        Text("For a second I hold my breath, but nothing and no\u2014one stirs. ")
        Divert(target="-\u003E return_to_room_after_excursion", empty=false, tunnel=false, thread=false)
        Text("\n")
    Flow(level=Stitch, name="toss_component_into_bushes", function=false)
      Weave(baseIndent=0)
        Text("I toss the component away into the bushes behind Hooper\u0027s tent and return to my barrack, wishing myself a long sleep followed by a morning, free of this business.")
        Text("\n")
        VariableAssignment(name="gotcomponent", global=false, temp=false)
          Number(false)
        VariableAssignment(name="throwncomponentaway", global=false, temp=false)
          Number(true)
        Divert(target="-\u003E return_to_room_after_excursion", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="live_on_the_run", function=false)
    Weave(baseIndent=0)
      Text("Better to live on the run than die on the spit. Creeping around the edge of the compound")
      ContentList
        Conditional
          VariableReference(gotcomponent)
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text(", the Bombe component heavy in my pocket")
      Text(", I make my way to the front gate. As always, it\u0027s manned by two guards, but I slip past their box by crawling on my belly.")
      Text("\n")
      Text("And then I\u0027m on the road. Walking, not running. Silent. Free.")
      Text("\n")
      Text("For the moment, at least.")
      Text("\n")
      Divert(target="-\u003E END", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="return_to_room_after_excursion", function=false)
    Weave(baseIndent=0)
      ContentList
        Conditional
          VariableReference(gotcomponent)
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("The weight of the Bombe component safely in my jacket")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("Satisfied")
      Text(", I return the short way up the paths between the huts to the barrack block and the broken window.")
      Text("\n")
      Text("It\u0027s a little harder getting back through \u2014 the window is higher off the ground than the floor inside \u2014 but after a decent bit of jumping and hauling I manage to get my elbows up, and then one leg, and finally I collapse inside, quite winded and out breath.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Wait")
        ContentList
          Text("  \t")
          Divert(target="-\u003E night_passes", empty=false, tunnel=false, thread=false)
          Text("\n")
  Flow(level=Knot, name="night_passes", function=false)
    Weave(baseIndent=0)
      Text("The rest of the night passes slowly. I sleep a little, dozing mostly. Then I\u0027m woken by the rooster in the yard. The door opens, and Harris comes in. He takes one look at the broken window and frowns with puzzlement.")
      Text("\n")
      ContentList
        Conditional
          VariableReference(putcomponentintent)
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text(" ")
              Divert(target="-\u003E put_component_inside_tent", empty=false, tunnel=false, thread=false)
      Text("\n")
      Text("\u0022What happened there?\u0022")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Confess")
        ContentList
          Text(" ")
          Text("\n")
      Text("\u0022I broke it,\u0022 I reply. There doesn\u0027t seem any use in trying to lie. \u0022I thought I could escape. But I couldn\u0027t get myself through.\u0022")
      Text("\n")
      Text("The Commander laughs. ")
      Divert(target="-\u003E glad_youre_here", empty=false, tunnel=false, thread=false)
      Text("\n")
      Choice(name="deny", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Deny")
        ContentList
          Text(" ")
          Text("\n")
      Text("\u0022I\u0027m not sure. I was asleep: I woke up when someone broke the window. I looked out to see who it was, but they were already gone.\u0022")
      Text("\n")
      Text("Harris looks at me with puzzlement. \u0022Someone came by to break the window, and then ran off? That\u0027s absurd. That\u0027s utterly absurd. Admit it, Manning. You tried to escape and you couldn\u0027t get through.\u0022")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Admit it")
          ContentList
            Text("\n")
        Text("\u0022All right. ")
        ContentList
          Conditional
            Binary(>, VariableReference(forceful), Number(1))
            ConditionalBranch(true=true, else=false, inline=true)
              Weave(baseIndent=0)
                Text("Damn you.")
        Text(" That\u0027s exactly it.\u0022")
        Text("\n")
        Divert(target="-\u003E glad_youre_here", empty=false, tunnel=false, thread=false)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Deny it")
          ContentList
            Text("\n")
          Unary(not, VariableReference(framedhooper))
        Text("\u0022If I wanted to escape, I would have made damn sure that I could,\u0022 I tell him sternly.")
        Text("\n")
        Divert(target="-\u003E harris_certain_is_you", empty=false, tunnel=false, thread=false)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Deny it")
          ContentList
            Text(" ")
            Text("\n")
          VariableReference(framedhooper)
        Text("\u0022I tell you, someone broke it. Someone wanted to threaten me, I think.\u0022")
        Text("\n")
        Text("Harris shakes his head. \u0022Well, we can look into that matter later. For now, you probably want to hear the more pressing news. ")
        Divert(target="-\u003E found_missing_component", empty=false, tunnel=false, thread=false)
        Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Show him the component")
        ContentList
          Text(" ")
          Divert(target="-\u003E someone_threw_component", empty=false, tunnel=false, thread=false)
          Text("\n")
        VariableReference(gotcomponent)
    Flow(level=Stitch, name="put_component_inside_tent", function=false)
      Weave(baseIndent=0)
        Text("He takes one look around, and sighs, a deep, wistful sigh.")
        Text("\n")
        Text("\u0022Things just get worse and worse for you, Manning,\u0022 he remarks. \u0022You are your own worst enemy.\u0022")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Agree")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022I\u0027ve thought so before.\u0022 ")
        ContentList
          Conditional
            VariableReference(admitblackmail)
            ConditionalBranch(true=true, else=false, inline=true)
              Weave(baseIndent=0)
                Text("Certainly in the matter of getting blackmailed.")
        Text("\n")
        Text("\u0022Let me tell you what happened this morning. ")
        Glue
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Disagree")
          ContentList
            Text("\n")
        Text("\u0022Right now, I think you take that role, Harris,\u0022 I reply coolly.")
        Text("\n")
        Weave(baseIndent=1)
          Gather(name="droll", depth=2)
          Text("\u0022Very droll,\u0022 he replies. \u0022Let me tell you what happened this morning. It will take the smile off your face. ")
          Glue
          Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Evade")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022I\u0027m looking forward to having a wash and a change of clothes; which should make me a little less evil to be around.\u0022")
        Text("\n")
        Divert(target="-\u003E droll", empty=false, tunnel=false, thread=false)
        Gather(name=null, depth=1)
        Text("Our men watching Hooper\u0027s tent saw Hooper wake up, get dressed, clamber out of his tent and then step on something in at the entrance of his tent.\u0022")
        Text("\n")
        VariableAssignment(name="piecereturned", global=false, temp=false)
          Number(true)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Be interested")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022You mean he didn\u0027t even hide it? He put it in his shoe?\u0022")
        Text("\n")
        Weave(baseIndent=1)
          Gather(name="not_that", depth=2)
          Text("\u0022No,\u0022 Harris replies. \u0022That isn\u0027t really what I mean. ")
          Glue
          Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Be dismissive")
          ContentList
            Text("\n")
        Text("\u0022So he\u0027s an idiot, and he hid it in his shoe.\u0022")
        Text("\n")
        Divert(target="-\u003E not_that", empty=false, tunnel=false, thread=false)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Say nothing")
          ContentList
            Text(" ")
            Text("\n")
        Text("I say quiet, listening, not sure how this will go.")
        Text("\n")
        Text("\u0022In case I\u0027m not making myself clear,\u0022 Harris continues, \u0022")
        Glue
        Text("\n")
        Gather(name=null, depth=1)
        Text("I mean, he managed to find it, by accident, somewhere where it wasn\u0027t the night before. And at the same time, you\u0027re sitting here with your window broken. So, I rather think you\u0027ve played your last hand and lost. It\u0027s utterly implausible that Hooper stole that component and then left it lying around in the doorway of his tent. So I came to tell you that the game is up, for you.\u0022")
        Text("\n")
        Text("He nods and gets to his feet. ")
        Divert(target="-\u003E left_alone", empty=false, tunnel=false, thread=false)
        Text("\n")
    Flow(level=Stitch, name="someone_threw_component", function=false)
      Weave(baseIndent=0)
        Text("\u0022Someone threw this in through the window over night,\u0022 I reply, and open my jacket to reveal the component from the Bombe. \u0022I couldn\u0027t see who, it was too dark. But I know what it is.\u0022")
        Text("\n")
        Text("He reaches out and takes it. \u0022Well, I\u0027ll be damned,\u0022 he murmurs. \u0022That\u0027s it all right. And you didn\u0027t have it on you when we put you in here. But it can\u0027t have been Hooper \u2014 I had men watching him all night. And there\u0027s no\u2014one else it could have been.\u0022")
        Text("\n")
        Text("He turns the component over in his hands, bemused.")
        Text("\n")
        VariableAssignment(name="piecereturned", global=false, temp=false)
          Number(true)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Suggest something")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022Perhaps Hooper had an accomplice. Someone else who works on site.\u0022")
        Text("\n")
        Text("Harris shakes his head, distractedly. \u0022That doesn\u0027t make sense,\u0022 he says. \u0022Why go to all the trouble of stealing it only to give it back? And why like this?\u0022")
        Text("\n")
        Weave(baseIndent=1)
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("Suggest something")
            ContentList
              Text(" ")
              Text("\n")
          Text("\u0022Perhaps the accomplice thought it was Hooper being kept in here. Maybe they saw the guard...\u0022")
          Text("\n")
          Divert(target="-\u003E all_too_farfetched", empty=false, tunnel=false, thread=false)
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("Suggest nothing")
            ContentList
              Text(" ")
              Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Suggest nothing")
          ContentList
            Text(" ")
            Text("\n")
        Gather(name=null, depth=1)
        Text("I shrug, eloquently.")
        Text("\n")
        Gather(name=null, depth=1)
        Divert(target="-\u003E all_too_farfetched", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="glad_youre_here", function=false)
      Weave(baseIndent=0)
        Text("\u0022Shame,\u0022 he remarks. \u0022I should have left that window open and put a guard on you. Might have been interesting to see where you went. Anyway, I\u0027m glad you\u0027re still here, even if you do smell like a dog.\u0022")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Be optimistic")
          ContentList
            Text(" ")
            Text("\n")
          Unary(not, VariableReference(framedhooper))
        Divert(target="-\u003E night_falls.morning_not_saved.optimism", empty=false, tunnel=false, thread=false)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Be pessimistic")
          ContentList
            Text(" ")
            Text("\n")
          Unary(not, VariableReference(framedhooper))
        Divert(target="-\u003E night_falls.morning_not_saved.pessimism", empty=false, tunnel=false, thread=false)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Be optimistic")
          ContentList
            Text(" ")
            Text("\n")
          VariableReference(framedhooper)
        Text("\u0022I\u0027m looking forward to having a bath.\u0022")
        Text("\n")
        Text("\u0022Well, you should enjoy it. ")
        Glue
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Be pessimistic")
          ContentList
            Text("\n")
          VariableReference(framedhooper)
        Text("\u0022I imagine I\u0027ll smell worse after another couple of days of this.\u0022")
        Text("\n")
        Text("\u0022That won\u0027t be necessary. ")
        Glue
        Text("\n")
        Gather(name=null, depth=1)
        Divert(target="-\u003E found_missing_component", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="found_missing_component", function=false)
      Weave(baseIndent=0)
        Text("We found the missing component. Or rather, Hooper found it for us. He snuck out and retrieved it from on top. Of all the damnest places \u2014 you would never have known it was there. He claimed ignorance when we jumped him, of course. But it\u0027s good enough for me.\u0022")
        Text("\n")
        Choice(name="devil", once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Approve")
          ContentList
            Text("\n")
        Text("\u0022I can\u0027t tell you enough, I\u0027m glad to hear it. I\u0027ve had a devil of a night.\u0022")
        Text("\n")
        Text("His gaze flicks to the broken window, but only for a moment. I think he genuinely cannot believe I could have done it.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Disapprove")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022You should never have hired him. A below-average intelligence can\u0027t be expected to cope with the pressure of our work.\u0022")
        Text("\n")
        Gather(name=null, depth=1)
        Text("Harris rolls his eyes, but he might almost be smiling. \u0022You\u0027d better get along, ")
        ContentList
          Conditional
            VariableReference(devil)
            ConditionalBranch(true=true, else=false, inline=true)
              Weave(baseIndent=0)
                Text("and work through your devils")
            ConditionalBranch(true=false, else=true, inline=true)
              Weave(baseIndent=0)
                Text("Mr Intelligent")
        Text(". There\u0027s a 24\u2014hour\u2014late message to be tackled and we\u0027re a genius short. So you\u0027d better be ready to work twice as hard.\u0022")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Thank him")
          ContentList
            Text(" \t")
            Text("\n")
        Text("\u0022I\u0027ll enjoy it. Thank you for helping me clear this up.\u0022")
        Text("\n")
        Text("\u0022Don\u0027t thank me yet. There\u0027s still a war to fight. Now get a move on.\u0022")
        Text("\n")
        Text("I nod, and hurry out of the door. The air outside has never tasted fresher and more invigorating. ")
        Glue
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Argue with him")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022I\u0027ll work as hard as I work.\u0022")
        Text("\n")
        Text("\u0022Get out,\u0022 Harris growls. \u0022Before I decide to arrest you as an accessory.\u0022")
        Text("\n")
        Text("I do as he says. Outside the barrack, the air has never smelt sweeter.")
        Text("\n")
        Gather(name=null, depth=1)
        Divert(target="-\u003E head_for_my_dorm_free", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="night_falls", function=false)
    Weave(baseIndent=0)
      Text("Night falls. The clockwork of the heavens keeps turning, whatever state I might be in. No\u2014one can steal the components that make the sun go down and the stars come out. I watch it performing its operations. I can\u0027t sleep.")
      Text("\n")
      ContentList
        Conditional
          Binary(>, VariableReference(hooperClueType), VariableReference(NONE))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("Has Hooper taken my bait?")
              Text("\n")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Look of out the window")
        ContentList
          Text(" ")
          Text("\n")
      Text("I peer out of the window, but it looks out onto the little brook at the back of the compound, with no view of the other huts or the House. Who knows if there are men up, searching the base of Hut 2, following one another with flashlights...")
      Text("\n")
      ContentList
        Conditional
          VariableReference(inside_hoopers_hut.back_of_hut_2)
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("Perhaps Hooper is there, in the dark, trying to help me after all?")
              Text("\n")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Listen at the door")
        ContentList
          Text(" \t")
          Text("\n")
      Text("I put my ear to the keyhole but can make out nothing. Are there still guards posted? ")
      ContentList
        Conditional
          Binary(>, VariableReference(hooperClueType), VariableReference(NONE))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("Perhaps, if Hooper has managed to incriminate himself, the guards have been removed?")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("Perhaps the component has been found and the crisis is over.")
      Text("\n")
      Text("Perhaps the door is unlocked and they left me to sleep?")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Try it")
          ContentList
            Text(" I try the handle. No such luck.")
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Leave it")
          ContentList
            Text(" I don\u0027t touch it. I don\u0027t want anyone outside thinking I\u0027m trying to escape.")
            Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Wait")
        ContentList
          Text(" \t\t\t\t\t")
          Text("\n")
      Text("There is nothing I can do to speed up time.")
      Text("\n")
      Gather(name=null, depth=1)
      Text("The night moves at its own pace. I suppose by morning I will know my fate.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Wait")
        ContentList
          Text(" ")
          Text("\n")
        Binary(>, VariableReference(hooperClueType), VariableReference(NONE))
      Text("Morning comes. I\u0027m woken by a rooster calling from the yard behind the House. I must have slept after all. I pull myself up from the bunk, shivering slightly. There is condensation on the inside of the window. I have probably given myself a chill.")
      Text("\n")
      Text("Without knocking, Harris comes inside. \u0022You\u0027re up,\u0022 he remarks, and then, \u0022You smell like an animal.\u0022")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Be friendly")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022I suppose I do rather.\u0022 I laugh, but Harris does not.")
        Text("\n")
        Text("\u0022This damn business gets worse and worse,\u0022 he says, talking as he goes over to unlock and throw open the window. ")
        Glue
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Be cold")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022So would you,\u0022 I reply tartly. Harris shrugs.")
        Text("\n")
        Text("\u0022I\u0027ve been through worse than this,\u0022 he replies matter\u2014of\u2014factly. \u0022It\u0027s hardly my fault if you sleep in your clothes.\u0022")
        Text("\n")
        Text("I glare back. He goes over to the window, unlocks it and throws it open, relishing the fresh air from outside.")
        Text("\n")
        Gather(name=null, depth=2)
        Text("\u0022Hooper\u0027s confessed, you know.\u0022")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Be eager")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022He has? I knew he would. The worm.\u0022")
        Text("\n")
        Text("\u0022Steady now. Matters aren\u0027t over yet. ")
        Glue
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Be cautious")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022Oh, yes?\u0022")
        Text("\n")
        Text("\u0022Yes. For what that\u0027s worth. ")
        Glue
        Text("\n")
        Gather(name="hooper_didnt_give_himself_up", depth=2)
        Text("There\u0027s still the issue of the component. It hasn\u0027t turned up. He didn\u0027t lead us to it. I guess he figured you must have had something on him. I don\u0027t know.\u0022")
        Text("\n")
        Text("He looks quite put out by the whole affair. He is not the kind of man to deal well with probabilities.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Be interested")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022You mean he confessed of his own accord? You didn\u0027t catch him?\u0022")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Be disinterested")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022Well, I\u0027m glad his conscience finally caught up with him,\u0022 I reply dismissively.")
        Text("\n")
        Gather(name=null, depth=2)
        Text("\u0022The Captain went back into that hut and he confessed immediately. We were so surprised we didn\u0027t let you go.\u0022 He wrinkles his nose. \u0022I\u0027m rather sorry about that now. I suggest you have a wash.\u0022")
        Text("\n")
        Text("And with that he gestures to the doorway.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Go")
          ContentList
            Text(" ")
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Wait")
          ContentList
            Text(" ")
            Text("\n")
        Text("I hang back a moment. Something does not seem quite right. After all, Hooper did not steal the component. He has no reason to confess to anything. Perhaps this is another trap?")
        Text("\n")
        Text("\u0022Well?\u0022 Harris asks. \u0022What are you waiting for? Please don\u0027t tell me \u003Ci\u003Eyou\u003C/i\u003E want to confess now as well, I don\u0027t think my head could stand it.\u0022")
        Text("\n")
        Weave(baseIndent=2)
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("Confess")
            ContentList
              Text(" ")
              Text("\n")
          Text("After a chance like this? A chance \u2014 however real \u2014 to save my neck? To hand it over \u2014 what, to save Hooper\u0027s worthless skin?")
          Text("\n")
          Weave(baseIndent=3)
            Choice(name=null, once=true, invisible=false, depth=4, inline=true)
              ContentList
                Text("Confess")
              ContentList
                Text(" ")
                Text("\n")
            Text("I see. Perhaps you think I bullied the man into giving himself up. Perhaps he understood my little clue far enough to know it was a threat against him, but not well enough to understand where he should look to find it. So he took the easy route out and folded. Gave me the hand.")
            Text("\n")
            VariableAssignment(name="hooperConfessed", global=false, temp=false)
              Number(true)
            Text("Hardly sporting, of course.")
            Text("\n")
            Weave(baseIndent=4)
              Choice(name=null, once=true, invisible=false, depth=5, inline=true)
                ContentList
                  Text("Confess")
                ContentList
                  Text("\n")
              Text("Well, then. I suppose this must be what it feels like to have a conscience. I suppose I had always wondered.")
              Text("\n")
              Text("\u0022Harris, sir. I don\u0027t know what Hooper\u0027s playing at, sir. But I can\u0027t let him do this.\u0022")
              Text("\n")
              Text("\u0022Do what?\u0022")
              Text("\n")
              Text("\u0022Take the rope for this. I took it, sir.")
              Text("\n")
              VariableAssignment(name="revealedhooperasculprit", global=false, temp=false)
                Number(false)
              VariableAssignment(name="losttemper", global=false, temp=false)
                Number(false)
              Divert(target="-\u003E reveal_location_of_component", empty=false, tunnel=false, thread=false)
              Choice(name=null, once=true, invisible=false, depth=5, inline=true)
                ContentList
                  Text("Don\u0027t confess")
                ContentList
                  Text(" ")
                  Text("\n")
            Choice(name=null, once=true, invisible=false, depth=4, inline=true)
              ContentList
                Text("Don\u0027t confess")
              ContentList
                Text(" ")
                Text("\n")
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("Don\u0027t confess")
            ContentList
              Text(" ")
              Text("\n")
          Gather(name=null, depth=3)
          Text("\u0022I certainly don\u0027t. But still, I\u0027m surprised. I had Hooper down for a full\u2014blown double agent, a traitor. He knows he\u0027ll face the rope, doesn\u0027t he?\u0022")
          Text("\n")
          Text("\u0022Don\u0027t ask me to explain why he did what he did,\u0022 Harris sighs. \u0022Just be grateful that he did, and you\u0027re now off the hook.\u0022")
          Text("\n")
        Gather(name=null, depth=2)
        Text("Curiouser and curiouser. I nod once to Harris and slip outside into the cold morning air.")
        Text("\n")
        ContentList
          Conditional
            Binary(==, VariableReference(hooperClueType), VariableReference(NONE))
            ConditionalBranch(true=true, else=false, inline=false)
              Weave(baseIndent=0)
                Text("Hooper\u0027s confession only makes sense in one fashion")
                ContentList
                  Conditional
                    VariableReference(hooperConfessed)
                    ConditionalBranch(true=true, else=false, inline=true)
                      Weave(baseIndent=0)
                        Text(", and that is his being dim\u2014witted and slow")
                    ConditionalBranch(true=false, else=true, inline=true)
                      Weave(baseIndent=0)
                        Text(" \u2014 if I successfully implied to him that I had him framed, but he did not unpack my little clue well enough to go looking for the component. Well, I had figured him for a more intelligent opponent, but a resignation from the game will suffice")
                Text(". Or perhaps he knew he would be followed if he went to check, and decided he would be doomed either way.")
                Text("\n")
            ConditionalBranch(true=false, else=true, inline=false)
              Weave(baseIndent=0)
                Text("Hooper\u0027s confession only makes sense in one way \u2014 and that\u0027s that he believed me. He reasoned that he would be followed. To try and uncover the component would have got him arrested, and to confess was the same.")
                Text("\n")
                Text("He simply caved, and threw in his hand.")
                Text("\n")
        Text("\n")
        Text("Of course, however, there is only one way to be certain that Harris is telling the truth, and that is to check the breeze\u2014block at the back of Hut 2.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Check")
          ContentList
            Text(" ")
            Divert(target="-\u003E go_to_where_component_is_hidden", empty=false, tunnel=false, thread=false)
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Don\u0027t check")
          ContentList
            Text("\n")
        Text("But there will time for that later. If there is nothing there, then Hooper discovered the component after all and Harris\u0027 men will have swooped on him, and the story about his confession is just a ruse to test me out.")
        Text("\n")
        Text("And if the component is still there \u2014 well. It will be just as valuable to my contact in a week\u0027s time, and his deadline of the 31st is not yet upon us.")
        Text("\n")
        Divert(target="-\u003E head_for_my_dorm_free", empty=false, tunnel=false, thread=false)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Wait")
        ContentList
          Text(" ")
          Divert(target="-\u003E morning_not_saved", empty=false, tunnel=false, thread=false)
          Text("\n")
        Binary(==, VariableReference(hooperClueType), VariableReference(NONE))
    Flow(level=Stitch, name="morning_not_saved", function=false)
      Weave(baseIndent=0)
        Text("Morning comes with the call of a rooster from the yard of the House. I must have slept after all. I pull myself up off the bunk, shivering slightly. There is condensation on the inside of the window. I have probably given myself a chill.")
        Text("\n")
        Text("It\u0027s not long after that Harris enters the hut. He closes the door behind him, careful as ever, then takes a chair across from me.")
        Text("\n")
        Text("\u0022You smell like a dog,\u0022 he remarks.")
        Text("\n")
        Choice(name="optimism", once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Be optimistic")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022I\u0027m looking forward to a long bath,\u0022 I reply. \u0022And getting back to work.\u0022")
        Text("\n")
        Choice(name="pessimism", once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Be pessimistic")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022So would you after the night I\u0027ve had.\u0022")
        Text("\n")
        Gather(name=null, depth=1)
        Divert(target="-\u003E harris_certain_is_you", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="harris_certain_is_you", function=false)
    Weave(baseIndent=0)
      Text("\u0022Well, I\u0027m afraid it is going to get worse for you,\u0022 Harris replies soberly. \u0022We followed Hooper, and he took himself neatly to bed and slept like a boy scout. Which puts us back to square one, and you firmly in the frame. And I\u0027m afraid I don\u0027t have time for any more games. I want you to tell me where that component is, or we will hang you as a traitor.\u0022")
      Text("\n")
      VariableAssignment(name="revealedhooperasculprit", global=false, temp=false)
        Number(false)
      VariableAssignment(name="losttemper", global=false, temp=false)
        Number(false)
      Divert(target="-\u003E harris_threatens_lynching", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="head_for_my_dorm_free", function=false)
    Weave(baseIndent=0)
      Text("I head for my dorm, intent on a bath, breakfast, a glance at the crossword before the other men get to it, and then on with work. They should have replaced the component in the Bombe by now. We will only be a day behind.")
      Text("\n")
      ContentList
        Conditional
          Unary(not, VariableReference(framedhooper))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("And then everything will proceed as before. The component will mean nothing to the Germans \u2014 this is the one fact I could never have explained to a man like Harris, even though the principle behind the Bombe is the same as the principle behind the army. The individual pieces \u2014 the men, the components \u2014 do not matter. They are identical. It is how they are arranged that counts.")
              Text("\n")
      Text("\n")
      Text("I bump into Russell in the dorm hut.")
      Text("\n")
      Text("\u0022Did you hear?\u0022 he whispers. \u0022Terrible news about Hooper. Absolutely terrible.\u0022")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Yes")
        ContentList
          Text(" ")
          Text("\n")
      Text("\u0022Quite terrible. I would never have guessed.\u0022")
      Text("\n")
      Text("\u0022Well.\u0022 Russell harrumphs.")
      Text("\n")
      Weave(baseIndent=1)
        Gather(name="quince", depth=2)
        Text("\u0022Quince was saying this morning, apparently his grandfather was German. So perhaps it\u0027s to be expected. See you there?\u0022")
        Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("No")
        ContentList
          Text("\n")
      Text("\u0022Heard what?\u0022")
      Text("\n")
      Weave(baseIndent=1)
        Gather(name="hooper_taken", depth=2)
        Text("\u0022Hooper\u0027s been taken away. They caught him, uncovering that missing Bombe component from a hiding place somewhere, apparently about to take it to his contact.\u0022 Russell harrumphs. ")
        Divert(target="-\u003E quince", empty=false, tunnel=false, thread=false)
        Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Lie")
        ContentList
          Text(" ")
          Text("\n")
      Text("\u0022I don\u0027t know what you\u0027re talking about.\u0022")
      Text("\n")
      Divert(target="-\u003E hooper_taken", empty=false, tunnel=false, thread=false)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Evade")
        ContentList
          Text("\n")
      Text("\u0022If you\u0027ll excuse me, Russell. I was about to take a bath.\u0022")
      Text("\n")
      Text("\u0022Oh, of course. Worked all night, did you? Well, you\u0027ll hear soon enough. Can hardly hide the fact there\u0027ll only be three of us from now on.\u0022")
      Text("\n")
      Gather(name=null, depth=1)
      Text("I wave to him and move away, my thoughts turning to the young man in the village. My lover. My contact. My blackmailer. Hooper may have taken the fall for the missing component, but ")
      ContentList
        Conditional
          Unary(not, VariableReference(framedhooper))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("if he did recover it from Hut 2 then ")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text(" its recovery does mean ")
      Text("I have nothing to sell to save my reputation")
      ContentList
        Conditional
          VariableReference(i_met_a_young_man)
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text(", if I have any left")
      Text(".")
      Text("\n")
      ContentList
        Conditional
          Unary(not, VariableReference(framedhooper))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("If he didn\u0027t, of course, and Harris was telling the truth about his sudden confession, then I will be able to buy my freedom once and for all.")
              Text("\n")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Get the component")
        ContentList
          Text(" ")
          Divert(target="-\u003E go_to_where_component_is_hidden", empty=false, tunnel=false, thread=false)
          Text("\n")
        Unary(not, VariableReference(framedhooper))
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Leave it")
        ContentList
          Text(" ")
          Text("\n")
        Unary(not, VariableReference(framedhooper))
      Text("I will have to leave that question for another day. To return there now, when they\u0027re probably watching my every step, would be suicide. After all, if Hooper ")
      ContentList
        Conditional
          Binary(==, VariableReference(hooperClueType), VariableReference(STRAIGHT))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("followed")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("understood")
      Text(" my clue, he will have explained it to them to save his neck. They won\u0027t believe him \u2014 but they won\u0027t quite disbelieve him either. We\u0027re locked in a cycle now, him and me, of half\u2014truth and probability. There\u0027s nothing either of us can do to put the other entirely into blame.")
      Text("\n")
      Divert(target="-\u003E ending_return_to_normal", empty=false, tunnel=false, thread=false)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Act normal")
        ContentList
          Text(" ")
          Text("\n")
      Text("But there is nothing to be done about it. ")
      Divert(target="-\u003E ending_return_to_normal", empty=false, tunnel=false, thread=false)
      Text("\n")
  Flow(level=Knot, name="ending_return_to_normal", function=false)
    Weave(baseIndent=0)
      Text("Nothing, that is, except to act as if there is no game being played. I\u0027ll have a bath, then start work as normal. I\u0027ve got a week to find something to give my blackmailer")
      ContentList
        Conditional
          VariableReference(i_met_a_young_man)
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text(" \u2014 or give him nothing: it seems my superiors know about my indiscretions now already")
      Text(".")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Co-operate")
        ContentList
          Text(" ")
          Text("\n")
      Text("Something will turn up. It always does. An opportunity will present itself, and more easily now that Hooper is out of the way.")
      Text("\n")
      Text("But for now, there\u0027s yesterday\u0027s intercept to be resolved.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Dissemble")
        ContentList
          Text(" ")
          Text("\n")
      Text("Or perhaps I might hand my young blackmailer over my superiors instead for being the spy he is.")
      Text("\n")
      Text("Perhaps that would be the moral thing to do, even, and not just the most smart.")
      Text("\n")
      Text("But not today. Today, there\u0027s an intercept to resolve.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Lie")
        ContentList
          Text("\n")
      Text("In a week\u0027s time, this whole affair will be in the past and quite forgotten. I\u0027m quite sure of that. ")
      Divert(target="-\u003E moreimportant", empty=false, tunnel=false, thread=false)
      Text("\n")
      Choice(name="moreimportant", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Evade")
        ContentList
          Text(" I\u0027ve more important problems to think about now. There\u0027s still yesterday\u0027s intercept to be resolved. ")
          Text("\n")
      Gather(name=null, depth=1)
      Text("The Bombe needs to be set up once more and set running.")
      Text("\n")
      Text("It\u0027s time I tackled a problem I can solve.")
      Text("\n")
      Divert(target="-\u003E END", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="go_to_where_component_is_hidden", function=false)
    Weave(baseIndent=0)
      Text("It won\u0027t take a moment to settle the matter. I can justify a walk past Hut 2 as part of my morning stroll. It will be obvious in a moment if the component is still there.")
      Text("\n")
      Text("On my way across the paddocks, between the huts and the House, I catch sight of young Miss Lyon, arriving for work on her bicycle. She giggles as she sees me and waves.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Wave back")
        ContentList
          Text(" ")
          Text("\n")
      Text("I wave cheerily back and she giggles, almost drops her bicycle, then dashes away inside the House. Judging by the clock on the front gable, she\u0027s running a little late this morning.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Ignore her")
        ContentList
          Text(" ")
          Text("\n")
      Text("I give no reaction. She sighs to herself, as if this kind of behaviour is normal, and trots away inside the House to begin her duties.")
      Text("\n")
      Gather(name=null, depth=1)
      Text("I turn the corner of Hut 3 and walk down the short gravel path to Hut 2. It was a good spot to choose \u2014 Hut 2 is where the electricians work, and they\u0027re generally focussed on what they\u0027re doing. They don\u0027t often come outside to smoke a cigarette so it\u0027s easy to slip past the doorway unnoticed.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Check inside")
        ContentList
          Text(" \t\t")
          Text("\n")
      Text("I hop up the steps and put my head inside all the same. Nobody about. Still too early in the AM for sparks, I suppose. ")
      Glue
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Go around the back")
        ContentList
          Text(" ")
          Text("\n")
      Gather(name=null, depth=1)
      Text("I head on around the back of the hut. The breeze\u2014block with the cavity is on the left side.")
      Text("\n")
      Choice(name="check", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Check")
        ContentList
          Text(" \t\t")
          Text("\n")
      Text("No time to waste. I drop to my knees and check the breeze\u2014block. Sure enough, there\u0027s nothing there. \u003Ci\u003EHooper took the bait.\u003C/i\u003E")
      Text("\n")
      Text("Suddenly, there\u0027s a movement behind me. I look up to see, first a snub pistol, and then, Harris.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Look around")
        ContentList
          Text(" ")
          Text("\n")
      Text("I pause to glance around, and catch a glimpse of movement. Someone ducking around the corner of the hut. Or a canvas sheet flapping in the light breeze. Impossible to be sure.")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Check the breeze\u2014block")
          ContentList
            Text(" ")
            Divert(target="-\u003E check", empty=false, tunnel=false, thread=false)
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Check around the side of the hut")
          ContentList
            Text(" ")
            Text("\n")
        Text("But too important to guess. I move back around the side of the hut.")
        Text("\n")
        Text("Harris is there, leaning in against the wall. He holds a stub pistol in his hand.")
        Text("\n")
      Gather(name=null, depth=1)
      ContentList
        Conditional
          Binary(>, VariableReference(hooperClueType), VariableReference(STRAIGHT))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("\u0022")
              ContentList
                Conditional
                  Binary(==, VariableReference(hooperClueType), VariableReference(CHESS))
                  ConditionalBranch(true=true, else=false, inline=true)
                    Weave(baseIndent=0)
                      Text("Queen to rook two")
                  ConditionalBranch(true=false, else=true, inline=true)
                    Weave(baseIndent=0)
                      Text("Messy without one missing whatever it was")
              Text(",\u0022 he declares. \u0022I wouldn\u0027t have fathomed it but Hooper did. Explained it right after we sprung him doing what you\u0027re doing now. We weren\u0027t sure what to believe but now, you seem to have resolved that for us.\u0022")
              Text("\n")
          ConditionalBranch(true=false, else=true, inline=false)
            Weave(baseIndent=0)
              Text("\u0022Hooper said you\u0027d told him where to look. I didn\u0027t believe him. Or, well. I wasn\u0027t sure what to believe. Now I rather think you\u0027ve settled it.\u0022")
              Text("\n")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Agree")
        ContentList
          Text(" ")
          Text("\n")
      Text("\u0022I have, rather.\u0022 I put my hands into my pockets. \u0022I seem to have done exactly that.\u0022")
      Text("\n")
      Text("\u0022I\u0027m afraid my little story about Hooper confessing wasn\u0027t true. I wanted to see if you\u0027d go to retrieve the part.\u0022 Harris gestures me to start walking. \u0022You were close, Manning, I\u0027ll give you that. I wanted to believe you. But I\u0027m glad I didn\u0027t.\u0022")
      Text("\n")
      Divert(target="-\u003E done", empty=false, tunnel=false, thread=false)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Lie")
        ContentList
          Text(" ")
          Text("\n")
      Text("\u0022I spoke to Russell. He said he saw Hooper doing something round here. I wanted to see what it was.\u0022")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Evade")
        ContentList
          Text(" ")
          Text("\n")
      Text("\u0022Harris, you\u0027d better watch out. He\u0027s planted a time\u2014bomb here.\u0022")
      Text("\n")
      Text("Harris stares at me for a moment, then laughs. \u0022Oh, goodness. That\u0027s rich.\u0022")
      Text("\n")
      Text("I almost wish I had a way to make the hut explode, but of course I don\u0027t.")
      Text("\n")
      Gather(name=null, depth=1)
      Text("\u0022Enough.\u0022 Harris gestures for me to start walking. \u0022This story couldn\u0027t be simpler. You took it to cover your back. You hid it. You lied to get Hooper into trouble, and when you thought you\u0027d won, you came to scoop your prize. A good hand but ultimately, ")
      ContentList
        Conditional
          Binary(<=, VariableReference(hooperClueType), VariableReference(STRAIGHT))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("if it hadn\u0027t have been you who hid the component, then you wouldn\u0027t be here now")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("you told Hooper where to look with your little riddle")
      Text(".\u0022")
      Text("\n")
      Gather(name="done", depth=1)
      Text("He leads me across the yard. Back towards Hut 5 to be decoded, and taken to pieces, once again.")
      Text("\n")
      Divert(target="-\u003E END", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="harris_threatens_lynching", function=false)
    Weave(baseIndent=0)
      ContentList
        Conditional
          VariableReference(harris_certain_is_you)
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("He passes a hand across his eyes with a long look of despair.")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("He gets to his feet, and gathers his gloves from the table top.")
      Text("\n")
      Text("\u0022I\u0027m going to go outside and organise a rope. That\u0027ll take about twelve minutes. That\u0027s how long you have to decide.\u0022")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Protest")
        ContentList
          Text(" ")
          Text("\n")
      Text("\u0022You can\u0027t do this!\u0022 I cry. \u0022It\u0027s murder! I demand a trial, a lawyer; for God\u0027s sake, man, you can\u0027t just throw me overboard, we\u0027re not barbarians...!\u0022")
      Text("\n")
      Weave(baseIndent=1)
        Gather(name="too_clever", depth=2)
        Text("\u0022You leave me no choice,\u0022 Harris snaps back, eyes cold as gun\u2014metal. \u0022You and your damn cyphers. Your damn clever problems. If men like you didn\u0027t exist, if we could just all be \u003Ci\u003Estraight\u003C/i\u003E with one another.\u0022 He gets to his feet and heads for the door. \u0022I fear for the future of this world, with men like you in. Reich or no Reich, Mr Manning, people like you simply \u003Ci\u003Ecomplicate\u003C/i\u003E matters.\u0022")
        Text("\n")
        Divert(target="-\u003E left_alone", empty=false, tunnel=false, thread=false)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Confess")
        ContentList
          Text(" ")
          Text("\n")
        Binary(&&, Unary(not, VariableReference(gotcomponent)), Unary(not, VariableReference(throwncomponentaway)))
      Text("I nod. \u0022I don\u0027t need twelve minutes. ")
      Divert(target="-\u003E reveal_location_of_component", empty=false, tunnel=false, thread=false)
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Stay silent")
        ContentList
          Text(" ")
          Divert(target="-\u003E my_lips_are_sealed", empty=false, tunnel=false, thread=false)
          Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Show him the component")
        ContentList
          Text(" ")
          Text("\n")
        VariableReference(gotcomponent)
      Text("\u0022I don\u0027t need twelve minutes. Here it is.\u0022")
      Text("\n")
      Text("I open my jacket and pull the Bombe component out of my pocket. Harris takes it from me, whistling, curious.")
      Text("\n")
      Text("\u0022Well, I\u0027ll be. That\u0027s it all right.\u0022")
      Text("\n")
      Text("\u0022That\u0027s it.\u0022")
      Text("\n")
      Text("\u0022But you didn\u0027t have it on you yesterday.\u0022")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Explain")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022I climbed out of the window overnight,\u0022 I explain. \u0022I went and got this from where it was hidden, and brought it back here.\u0022")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Don\u0027t explain")
          ContentList
            Text("\n")
        Text("\u0022No. I didn\u0027t.\u0022")
        Text("\n")
      Gather(name=null, depth=1)
      Divert(target="-\u003E all_too_farfetched", empty=false, tunnel=false, thread=false)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Confess")
        ContentList
          Text("\n")
        VariableReference(throwncomponentaway)
      Text("\u0022I don\u0027t need twelve minutes. The component is in the long grass behind Hooper\u0027s tent. I threw it there hoping to somehow frame him, but now I see that won\u0027t be possible. I was naive, I suppose.\u0022")
      Text("\n")
      VariableAssignment(name="piecereturned", global=false, temp=false)
        Number(true)
      Divert(target="-\u003E reveal_location_of_component.harris_believes", empty=false, tunnel=false, thread=false)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Frame Hooper")
        ContentList
          Text(" ")
          Text("\n")
        VariableReference(throwncomponentaway)
      Text("\u0022Look, I know where it is. The missing piece of the Bombe is in the long grasses behind Hooper\u0027s tent. I saw him throw it there right after we finished work. He knew you\u0027d scour the camp but I suppose he thought you\u0027d more obvious places first. I suppose he was right about that. Look there. That \u003Ci\u003Eproves\u003C/i\u003E his guilt.\u0022")
      Text("\n")
      VariableAssignment(name="longgrasshooperframe", global=false, temp=false)
        Number(true)
      VariableAssignment(name="piecereturned", global=false, temp=false)
        Number(true)
      Text("\u0022That doesn\u0027t prove anything,\u0022 Harris returns sharply. \u0022But we\u0027ll check what you say, all the same.\u0022 He gets to his feet and heads out of the door.")
      Text("\n")
      Divert(target="-\u003E left_alone", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="reveal_location_of_component", function=false)
    Weave(baseIndent=0)
      Glue
      Text(" The missing component of the Bombe computer is hidden in a small cavity in a breeze\u2014block supporting the left rear post of Hut 2. I put in there anticipating a search. I intended to ")
      ContentList
        Conditional
          VariableReference(revealedhooperasculprit)
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("pass it to Hooper")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("dispose of it")
      Text(" once the fuss had died down. I suppose I was foolish to think that it might.\u0022")
      Text("\n")
      VariableAssignment(name="piecereturned", global=false, temp=false)
        Number(true)
      Divert(target="-\u003E harris_believes", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="harris_believes", function=false)
      Weave(baseIndent=0)
        ContentList
          Conditional
            Unary(not, VariableReference(night_falls.hooper_didnt_give_himself_up))
            ConditionalBranch(true=true, else=false, inline=false)
              Weave(baseIndent=0)
                Text("\u0022Indeed. And Mr Manning: God help you if you\u0027re lying to me.\u0022")
                Text("\n")
            ConditionalBranch(true=false, else=true, inline=false)
              Weave(baseIndent=0)
                Text("\u0022I thought as much. I hadn\u0027t expected you to give it out so easily, however. You understand, Hooper has said nothing, of course. In fact, he went to Hut 2 directly after we released him and uncovered the component. But he told us you had instructed him where to go. Hence my little double bluff. Frankly, I\u0027ll be glad when I\u0027m shot of the lot of you mathematicians.\u0022")
                Text("\n")
        Text("\n")
        Text("Harris stands, and slips away smartly. ")
        Divert(target="-\u003E left_alone", empty=false, tunnel=false, thread=false)
        Text("\n")
  Flow(level=Knot, name="my_lips_are_sealed", function=false)
    Weave(baseIndent=0)
      Text("I say nothing, my lips tightly, firmly sealed. It\u0027s true I am a traitor, to the very laws of nature. The world has taught me that since a very early age. But not to my country \u2014 should the Reich win this war, I would hardly be treated as an honoured hero. I was doomed from the very start.")
      Text("\n")
      VariableAssignment(name="notraitor", global=false, temp=false)
        Number(true)
      Text("I explain none of this. How could a man like Harris understand?")
      Text("\n")
      Text("The Commander takes one look back from the doorway as he pulls it to.")
      Text("\n")
      Text("\u0022It\u0027s been a pleasure working with you, Mr Manning,\u0022 he declares. \u0022You\u0027ve done a great service to this country. If we come through, I\u0027m sure they\u0027ll remember you name. I\u0027m sorry it had to end this way and I\u0027ll do my best to keep it quiet. No\u2014one need know what you did.\u0022")
      Text("\n")
      Divert(target="-\u003E left_alone", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="all_too_farfetched", function=false)
    Weave(baseIndent=0)
      Text("\u0022This is all too far\u2014fetched,\u0022 Harris says. \u0022I\u0027m glad to have this back, but I need to think.\u0022")
      Text("\n")
      Text("Getting to his feet, he nods once. \u0022You\u0027ll have to wait a little longer, I\u0027m afraid, Manning.\u0022")
      Text("\n")
      Text("Then he steps out of the door, muttering to himself.")
      Text("\n")
      Divert(target="-\u003E make_your_peace", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="left_alone", function=false)
    Weave(baseIndent=0)
      ContentList
        Conditional
          VariableReference(slam_door_shut_and_gone.time_to_move_now)
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("The Commander holds the door for his superior, and follows him out.")
      Text(" Then the door closes. I am alone again, as I have been for most of my short life.")
      Text("\n")
      Divert(target="-\u003E make_your_peace", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="make_your_peace", function=false)
    Weave(baseIndent=0)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Make your peace")
        ContentList
          Text("\n")
      Gather(name=null, depth=1)
      Text("I am waiting again. I have no God to make my peace with. I find it difficult to believe in goodness of any kind, in a world such as this.")
      Text("\n")
      ContentList
        Conditional
          Unary(not, VariableReference(notraitor))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              VariableAssignment(name="notraitor", global=false, temp=false)
                Number(true)
              Text("But I am no traitor. Not to my country. To my sex, perhaps. But how could I support the Reich? If the Nazis were to come to power, I would be worse off than ever.")
              Text("\n")
      Text("\n")
      ContentList
        Conditional
          VariableReference(harris_threatens_lynching.too_clever)
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("In truth, it is men like Harris who are complex, not men like me. I live to make things ordered, systematic. I like my pencils sharpened and lined up in a row. I do not deal in difficult borders, or uncertainties, or alliances. If I could, I would reduce the world to something easier to understand, something finite.")
              Text("\n")
              Text("But I cannot, not even here, in our little haven from the horrors of the war.")
              Text("\n")
      Text("\n")
      Text("I have no place here. No way to fit. I am caught, in the middle, cryptic and understood only thinly, through my machines.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=false)
        ContentList
          Text("I must seem very calm. \t\t\t")
        ContentList
          Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Perhaps I should try to escape.")
        ContentList
          Text(" But escape to where? I am already a prisoner. Jail would be a blessing. ")
          Divert(target="-\u003E monastic", empty=false, tunnel=false, thread=false)
          Text("\n")
      Gather(name=null, depth=1)
      Glue
      Text(" I suppose I do not believe they will hang me. They will lock me up and continue to use my brain, if they can. I wonder what they will tell the world \u2014 perhaps that I have taken my own life. That would be simplest. The few who know me would believe it.")
      Text("\n")
      Text("Well, then. Not a bad existence, in prison. Removed from temptation.")
      Text("\n")
      Gather(name="monastic", depth=1)
      Text("A monastic life, with plenty of problems to keep me going.")
      Text("\n")
      Text("I wonder what else I might yet unravel before I\u0027m done?")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("The door is opening.")
        ContentList
          Text(" Harris is returning. Our little calculation here is complete. ")
          ContentList
            Conditional
              Unary(not, VariableReference(piecereturned))
              ConditionalBranch(true=true, else=false, inline=true)
                Weave(baseIndent=0)
                  Text(" I can only hope one of the others will be able to explain to him that the part I stole will mean nothing to the Germans.")
              ConditionalBranch(true=false, else=true, inline=true)
                Weave(baseIndent=0)
                  Text("We are just pieces in this machine; interchangeable and prone to wear.")
          Text("\n")
      Gather(name=null, depth=1)
      Text("That is the true secret of the calculating engine, and the source of its power. It is not the components that matter, they are quite repetitive. What matters is how they are wired; the diversity of the patterns and structures they can form. Much like people \u2014 it is how they connect that determines our victories and tragedies, and not their genius.")
      Text("\n")
      Text("Which makes me wonder. Should I give ")
      ContentList
        Conditional
          VariableReference(i_met_a_young_man)
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("up my beautiful young man")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("the young man who put me in this spot")
      Text(" to them as well as myself?")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Yes")
        ContentList
          Text(" ")
          Text("\n")
      Text("But of course I will. ")
      ContentList
        Conditional
          Binary(>, VariableReference(forceful), Number(2))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("Perhaps I can persuade them to put him in my cell.")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("A little vengeance, disguised as doing something good.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("No")
        ContentList
          Text(" ")
          Text("\n")
      Text("No. What would be the use? He will be long gone, and the name he told me is no doubt hokum. No: I was alone before in guilt, and I am thus alone again.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Lie")
        ContentList
          Text(" ")
          Text("\n")
      Text("No. Why would I? He is no doubt an innocent himself, trapped by some dire circumstance. Forced to act the way he did. I have every sympathy for him.")
      Text("\n")
      Text("Of course I do.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Evade")
        ContentList
          Text(" ")
          Text("\n")
      Text("It depends, perhaps, on what his name his worth. If it were to prove valuable, well; perhaps I can concoct a few more such lovers with which to ease my later days.")
      Text("\n")
      ContentList
        Conditional
          VariableReference(hooper_mentioned)
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text(" Hooper, perhaps. He wouldn\u0027t like that. ")
      Text("\n")
      Gather(name=null, depth=1)
      ContentList
        Conditional
          Unary(not, VariableReference(longgrasshooperframe))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("Harris put the cuffs around my wrists. \u0022I still have the intercept in my pocket,\u0022 I remark. \u0022Wherever we\u0027re going, could I have a pencil?\u0022")
              Text("\n")
          ConditionalBranch(true=false, else=true, inline=false)
            Weave(baseIndent=0)
              Text("\u0022We recovered the part, just where you said it was,\u0022 Harris reports, as he puts the cuffs around my wrists. \u0022Of course, a couple of the men swear blind they searched there yesterday, so I\u0027m afraid, what with the broken window... we\u0027ve formed a perfectly good theory which doesn\u0027t bode well for you.\u0022")
              Text("\n")
      Text("\n")
      VariableAssignment(name="piecereturned", global=false, temp=false)
        Number(true)
      ContentList
        Conditional
          VariableReference(longgrasshooperframe)
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("\u0022I see.\u0022 It doesn\u0027t seem worth arguing any further. \u0022I still have the intercept in my pocket,\u0022 I remark. \u0022Wherever we\u0027re going, could I have a pencil?\u0022")
              Text("\n")
      Text("\n")
      Text("He looks me in the eye.")
      Text("\n")
      ContentList
        Conditional
          Unary(not, VariableReference(losttemper))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("\u0022Of course. And one of your computing things, if I get my way. And when we\u0027re old, and smoking pipes together in The Rag like heroes, I\u0027ll explain to you the way that decent men have affairs.")
              Text("\n")
          ConditionalBranch(true=false, else=true, inline=false)
            Weave(baseIndent=0)
              Text("\u0022I\u0027ll give you a stone to chisel notches in the wall. And that\u0027s all the calculations you\u0027ll be doing. And as you sit there, pissing into a bucket and growing a beard down to your toes, you have a think about how a \u003Ci\u003Esmart\u003C/i\u003E man would conduct his illicit affairs. With a bit of due decorum you could have learnt off any squaddie.")
              Text("\n")
      Text("\n")
      Glue
      Text(" You scientists.\u0022")
      Text("\n")
      Text("He drags me up to my feet.")
      Text("\n")
      Text("\u0022You think you have to re\u2014invent everything.\u0022")
      Text("\n")
      Text("With that, he hustles me out of the door and I can\u0027t help thinking that, with a little more strategy, I could still have won the day. But too late now, of course.")
      Text("\n")
      Divert(target="-\u003E END", empty=false, tunnel=false, thread=false)