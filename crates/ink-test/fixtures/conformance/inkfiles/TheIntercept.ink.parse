        ContentList
          Text("Evade")
        ContentList
          Text("\n")
        Unary(not, VariableReference(drugged))
      Text("\"Explain what you should be doing, do you mean, rather than bullying me? Certainly.\" I fold my arms. ")
      Divert(target="-> i_know_where", empty=false, tunnel=false, thread=false)
