  Flow(level=Knot, name="harris_asks_for_theory", function=false)
    Weave(baseIndent=0)
      Text("\"Tell me, then,\" he asks. \"What's your theory? You're a smart fellow — as smart as they come around here, and that's saying something. What's your opinion on the missing component? Accident, perhaps? Or do you blame one of the other men? ")
      ContentList
        Conditional
          VariableReference(hooper_mentioned)
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("Hooper?")
      Text("\"")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Blame no—one")
        ContentList
          Text(" ")
          Text("\n")
      Divert(target="-> an_accident", empty=false, tunnel=false, thread=false)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Blame someone")
        ContentList
          Text(" ")
          Divert(target="-> claim_hooper_took_component", empty=false, tunnel=false, thread=false)
          Text("\n")
    Flow(level=Stitch, name="an_accident", function=false)
      Weave(baseIndent=0)
        Text("\"An accident, naturally.\" I risk a smile. \"That damned machine is made from spare parts and string. Even these Huts leak when it rains. It wouldn't take more than one fellow to trip over a cable to shake out a component. Have you tried looking under the thing?\"")
        Text("\n")
        Text("\"Do you believe we haven't?\"")
        Text("\n")
        Text("In a sudden moment I understand that his reply is a threat.")
        Text("\n")
        Text("\"Now,\" he continues. \"Are you sure there isn't anything you want to tell me?\"")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Co-operate")
          ContentList
            Text("\n")
        Text("\"All right.\" With a sigh, your defiance collapses. \"If you're searched my things then I suppose you've found ")
        ContentList
          Conditional
            Binary(>, VariableReference(evasive), Number(1))
            ConditionalBranch(true=true, else=false, inline=true)
              Weave(baseIndent=0)
                Text(" what you need")
            ConditionalBranch(true=false, else=true, inline=true)
              Weave(baseIndent=0)
                Text("my letters. Haven't you? In fact, if you haven't, don't tell me")
        Text(".")
        Text("\n")
        VariableAssignment(name="admitblackmail", global=false, temp=false)
          Number(true)
        Text("Harris nods once.")
        Text("\n")
        Glue
        Text(" ")
        Divert(target="-> harris_has_seen_it_before", empty=false, tunnel=false, thread=false)
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Evade")
          ContentList
            Text(" \"Only that you're being unreasonable, and behaving like a swine.\"")
            Text("\n")
          Binary(>, VariableReference(evasive), Number(0))
        Text("\"You imbecile,\" Harris replies, with sudden force. He is half out of his chair. \"You know the situation as well as I do. Why the fencing? The Hun are poised like rats, ready to run all over this country. They'll destroy everything. You understand that, don't you? You're not so locked up inside your crossword puzzles that you don't see that, are you? This machine we have here — you men — you are the best and only hope this country has. God help her.\"")
        Text("\n")
        VariableAssignment(name="losttemper", global=false, temp=false)
          Number(true)
        Text("I sit back, startled by the force of his outburst. His carefully sculpted expression has curled to angry disgust. <i>He really does hate me</i>, I think. <i>He'll have my blood for the taste of it.</i>")
        Text("\n")
        Weave(baseIndent=1)
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("Placate")
            ContentList
              Text("\n")
          Text("\"Now steady on,\" I reply, gesturing for him to be calm.")
          Text("\n")
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("Mock")
            ContentList
              Text(" ")
              Text("\n")
          Text("\"I can imagine how being surrounded by clever men is pretty threatening for you, Commander,\" I reply with a sneer. \"They don't train you to think in the Armed Forces.\"")
          Text("\n")
          ContentList
            FunctionCall(raise, args=1)
            Text("\n")
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("Dismiss")
            ContentList
              Text("\n")
          Text("\"Then I'll be going, on and getting on with my job of saving her, shall I?\" I even rise half to my feet, before he slams the tabletop.")
          Text("\n")
          Gather(name=null, depth=2)
          Text("\"Talk,\" Harris demands. \"Talk now. Tell me where you've hidden it or who you passed it to. Or God help me, I'll take your wretched pansy body to pieces looking for it.\"")
          Text("\n")
          Divert(target="-> harris_demands_you_speak", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="harris_has_seen_it_before", function=false)
    Weave(baseIndent=0)
      Text("\"I've seen it before. A young man like you — clever, removed. The kind that doesn't go to parties. Who takes himself too seriously. Who takes things too far.\"")
      Text("\n")
      Text("He slides his thumb between two fingers.")
      Text("\n")
      Text("\"Now they own you.\"")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Agree")
        ContentList
          Text(" ")
          Text("\n")
      Text("\"What could I do?\" I'm shaking now. The night is cold and the heat—lamp in the Hut has been removed. \"")
      ContentList
        Conditional
          Binary(>, VariableReference(forceful), Number(2))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("I won't")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("I don't want to")
      Text(" go to prison.\"")
      Text("\n")
      Text("\"Smart man,\" he replies. \"You wouldn't last.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Disagree")
        ContentList
          Text(" ")
          Text("\n")
      Text("\"I can still fix this.\"")
      Text("\n")
      Text("Harris shakes his head. \"You'll do nothing. This is beyond you now. You may go to prison or may go to firing squad - or we can change your name and move you somewhere where your indiscretions can't hurt you. But right now, none of that matters. What happens to you doesn't matter. All that matters is where that component is.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Lie")
        ContentList
          Text(" ")
          Text("\n")
        Unary(not, VariableReference(drugged))
      Text("\"I wanted to tell you,\" I tell him. \"I thought I could find out who they were. Lead you to them.\"")
      Text("\n")
      Text("Harris looks at me with contempt. \"You wretch. You'll pay for what you've done to this country today. If a single man loses his life because of your pride and your perversions then God help your soul.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Apologise")
        ContentList
          Text("\n")
        MultipleCondition(VariableReference(drugged), Binary(<, VariableReference(forceful), Number(0)))
      Text("\"Harris, I...\"")
      Text("\n")
      ContentList
        FunctionCall(lower, args=1)
        Text("\n")
      Text("\"Stop it,\" he interrupts. \"There's no jury here to sway.  And there's no time.")
      Text("\n")
      Gather(name="tell_me_now", depth=1)
      Glue
      Text(" So why don't you tell me, right now. Where is it?\"")
      Text("\n")
      Divert(target="-> harris_demands_you_speak", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="harris_demands_you_speak", function=false)
    Weave(baseIndent=0)
      Text("His eyes bear down like carbonised drill—bits.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Confess")
        ContentList
          Text(" ")
          Text("\n")
      ContentList
        Conditional
          Binary(>, VariableReference(forceful), Number(1))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("\"You want me to tell you what happened? You'll be disgusted.\"")
              Text("\n")
          ConditionalBranch(true=false, else=true, inline=false)
            Weave(baseIndent=0)
              Text("\"All right. I'll tell you what happened.\" And never mind my shame.")
              Text("\n")
      Text("\n")
      Text("\"I can imagine how it starts,\" he replies.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Dissemble")
        ContentList
          Text(" ")
          Divert(target="-> claim_hooper_took_component", empty=false, tunnel=false, thread=false)
          Text("\n")
        Unary(not, VariableReference(drugged))
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Dissemble")
        ContentList
          Text("\n")
        VariableReference(drugged)
      Text("My plan now is to blame Hooper, but I cannot seem to tell the story. Whatever they put in my tea, it rules my tongue. ")
      ContentList
        Conditional
          Binary(>, VariableReference(forceful), Number(1))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("I fight it as hard as I can but it does no good.")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("I am desperate to tell him everything. I am weeping with shame.")
      Text("\n")
      ContentList
        FunctionCall(lower, args=1)
        Text("\n")
      Gather(name=null, depth=1)
      Divert(target="-> i_met_a_young_man", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="i_met_a_young_man", function=false)
    Weave(baseIndent=0)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Talk")
        ContentList
          Text("\n")
      Text("\"There was a young man. I met him in the town. A few months ago now. We got to talking. Not about work. And I used my cover story, but he seemed to know it wasn't true. That got me wondering if he might be one of us.\"")
      Text("\n")
      Gather(name=null, depth=1)
      Text("Harris is not letting me off any more.")
      Text("\n")
      Text("\"You seriously entertained that possibility?\"")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Yes")
        ContentList
          Text("\n")
      Text("\"Yes, I considered it. ")
      Glue
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("No")
        ContentList
          Text(" ")
          Text("\n")
      Text("\"No. Not for more than a moment, of course. Everyone here is marked out by how little we would be willing to say about it.\"")
      Text("\n")
      Text("\"Only you told this young man more than a little, didn't you?\"")
      Text("\n")
      Text("I nod. \"")
      Glue
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Lie")
        ContentList
          Text(" ")
          Text("\n")
      Text("\"I was quite certain, after a while. After we'd been talking. ")
      Glue
      Text("\n")
      Gather(name=null, depth=1)
      Text("He seemed to know all about me. He... he was quite enchanted by my achievements.\"")
      Text("\n")
      Text("The way Harris is staring I expect him to strike me, but he does not. He replies, \"I can see how that must have been attractive to you,\" with such plain—spokeness that I think I must have misheard.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Yes")
        ContentList
          Text(" \"It's a lonely life in this place,\" I reply. \"Lonely - and still one never gets a moment to oneself.\"")
          Text("\n")
      Text("\"That's how it is in the Service,\" Harris answers.")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Argue")
          ContentList
            Text(" \"I'm not in the Service.\"")
            Text("\n")
        Text("Harris shakes his head. \"Yes, you are.\"")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Agree")
          ContentList
            Text(" \"Perhaps. But I didn't choose this life.\" ")
            Text("\n")
        Text("Harris shakes his head. \"No. And there's plenty of others who didn't who are suffering far worse.\"")
        Text("\n")
        Gather(name=null, depth=2)
        Text("Then he waves the thought aside.")
        Text("\n")
      Choice(name="nope", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("No")
        ContentList
          Text(" \"The boy was a pretty simpleton. Quite inferior. His good opinion meant nothing to be. Harris, do not misunderstand. I was simply after his body.\"")
          Text("\n")
        Unary(not, VariableReference(drugged))
      ContentList
        FunctionCall(raise, args=1)
        Text("\n")
      Text("Harris, to his credit, doesn't flinch; but I can see he will have nightmares of this moment later tonight. I'm tempted to reach out and take his hand to worsen it for him.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("No")
        ContentList
          Text(" ")
          Text("\n")
        VariableReference(drugged)
      Text("\"It wasn't,\" I reply. \"But I doubt you'd understand.\"")
      Text("\n")
      Text("He simply nods.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Lie")
        ContentList
          Text(" ")
          Divert(target="-> nope", empty=false, tunnel=false, thread=false)
          Text("\n")
        Unary(not, VariableReference(drugged))
      Gather(name=null, depth=1)
      Text("\"Go on with your confession.\"")
      Text("\n")
      Gather(name="paused", depth=1)
      ContentList
        Conditional
          Unary(not, VariableReference(nope))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("That gives me pause. I hadn't thought of it as such. But I suppose he's right. I am about to admit what I did.")
              Text("\n")
      Text("\n")
      Text("\"There's not much else to say. I took the part from Bombe computing device. You seem to know that already. I had to. He was going to expose me if I didn't.\"")
      Text("\n")
      Text("\"This young man was blackmailing you over your affair?\"")
      Text("\n")
      VariableAssignment(name="harris_thinks_youre_drugged", global=false, temp=true, type=bool)
        VariableReference(drugged)
      ContentList
        Conditional
          VariableReference(drugged)
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              VariableAssignment(name="drugged", global=false, temp=false)
                Number(false)
              Text("As Harris speaks I find myself suddenly sharply aware, as if waking from a long sleep. The table, the corrugated walls of the hut, everything seems suddenly more tangible than a moment before.")
              Text("\n")
              Text("Whatever it was they put in my drink is wearing off.")
              Text("\n")
      Text("\n")
      Choice(name="yes", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Yes")
        ContentList
          Text(" ")
          Text("\n")
      Text("\"Yes. I suppose he was their agent. I should have realised but I didn't. Then he threatened to tell you. I thought you would have me locked up: I couldn't bear the thought of it. I love working here. I've never been so happy, so successful, anywhere before. I didn't want to lose it.\"")
      Text("\n")
      Text("\"So what did you do with the component?\" Harris talks urgently. He grips his gloves tightly in one hand, perhaps prepared to lift them and strike if it is required. \"Have you passed it to this man already? Have you left it somewhere for him to find?\"")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name="still_have", once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("I have it")
          ContentList
            Text(" \t")
            Text("\n")
        Text("\"I still have it. Not on me, of course. ")
        Divert(target="-> reveal_location_of_component", empty=false, tunnel=false, thread=false)
        Text("\n")
        Choice(name="dont_have", once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("I don't have it")
          ContentList
            Text(" \t")
            Divert(target="-> i_dont_have_it", empty=false, tunnel=false, thread=false)
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Lie")
          ContentList
            Text(" \t\t\t\t\t\t\t")
            Divert(target="-> dont_have", empty=false, tunnel=false, thread=false)
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Tell the truth")
          ContentList
            Text(" \t\t\t\t")
            Divert(target="-> still_have", empty=false, tunnel=false, thread=false)
            Text("\n")
      Choice(name="notright", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("No")
        ContentList
          Text(" ")
          Text("\n")
      Text("\"No, Harris. The young man wasn't blackmailing me.\" I take a deep breath. \"It was Hooper.\"")
      Text("\n")
      ContentList
        Conditional
          Unary(not, VariableReference(hooper_mentioned))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("\"Hooper!\" Harris exclaims, in surprise. ")
              ContentList
                Conditional
                  VariableReference(harris_thinks_youre_drugged)
                  ConditionalBranch(true=true, else=false, inline=true)
                    Weave(baseIndent=0)
                      Text("He does not doubt me for a moment.")
              Text("\n")
          ConditionalBranch(true=false, else=true, inline=false)
            Weave(baseIndent=0)
              Text("\"Now look here,\" Harris interrupts. \"Don't start that again.\"")
              Text("\n")
      Text("\n")
      Text("\"It's the truth, Harris. If I'm going to jail, so be it, but I won't hang at Traitor's Gate. Hooper was the one who told the boy about our work. Hooper put the boy on to me. ")
      ContentList
        Conditional
          Binary(<, VariableReference(forceful), Number(2))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("I should have realised, of course. These things don't happen by chance. I was a fool to think they might.")
      Text(" And then, once he had me compromised, he demanded I steal the part from the machine.\"")
      Text("\n")
      VariableAssignment(name="revealedhooperasculprit", global=false, temp=false)
        Number(true)
      Text("\"Which you did.\" Harris leans forward. \"And then what? You still have it? You've stashed it somewhere?\"")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name="didnt_have_long", once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Yes")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"Yes. I only had a moment. ")
        Divert(target="-> reveal_location_of_component", empty=false, tunnel=false, thread=false)
        Text("\n")
        Choice(name="passed_on", once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("No")
          ContentList
            Text(" ")
            Divert(target="-> passed_onto_hooper", empty=false, tunnel=false, thread=false)
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Lie")
          ContentList
            Text(" \t\t\t")
            Divert(target="-> passed_on", empty=false, tunnel=false, thread=false)
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Evade")
          ContentList
            Text(" \t\t")
            Text("\n")
        Text("\"I can't remember.\"")
        Text("\n")
        Text("He draws his gun and lays it lightly on the field table.")
        Text("\n")
        Text("\"I'm sorry to threaten you, friend. But His Majesty needs that brain of yours, and that brain alone. There are plenty of other parts to you that our country could do better without. Now I'll ask you again. Did you hide the component?\"")
        Text("\n")
        Weave(baseIndent=2)
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("Yes")
            ContentList
              Text(" ")
              Divert(target="-> didnt_have_long", empty=false, tunnel=false, thread=false)
              Text("\n")
          Choice(name="nope_didnt_hide", once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("No")
            ContentList
              Text(" ")
              Text("\n")
          Text("\"Very well then.\" I swallow nervously, to make it look more genuine. ")
          Divert(target="-> passed_onto_hooper", empty=false, tunnel=false, thread=false)
          Text("\n")
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("Lie")
            ContentList
              Text(" ")
              Divert(target="-> nope_didnt_hide", empty=false, tunnel=false, thread=false)
              Text("\n")
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("Evade")
            ContentList
              Text(" ")
              Divert(target="-> i_dont_have_it", empty=false, tunnel=false, thread=false)
              Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Tell the truth")
        ContentList
          Text(" \t")
          Divert(target="-> yes", empty=false, tunnel=false, thread=false)
          Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Lie")
        ContentList
          Text(" \t\t\t\t")
          Divert(target="-> notright", empty=false, tunnel=false, thread=false)
          Text("\n")
    Flow(level=Stitch, name="i_dont_have_it", function=false)
      Weave(baseIndent=0)
        Text("\"I don't have it any more. I passed it through the fence to my contact straight after taking it, before it was discovered to be missing. It would have been idiocy to do differently. It's long gone, I'm afraid.\"")
        Text("\n")
        Text("\"You fool, Manning,\" Harris curses, getting quickly to his feet. \"You utter fool. Do you suppose you will be any better off living under Hitler? It's men like you who will get us all killed. Men too feeble, too weak in their hearts to stand up and take a man's responsibility for the world. You're happier to stay a child all your life and play with your little childish toys.\"")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Answer back")
          ContentList
            Text("\n")
        Text("\"Really, Commander,\" I reply. \"It rather sounds like you want to spank me.\"")
        Text("\n")
        Text("\"For God's sake,\" he declares with thick disgust, then swoops away out of the room.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Say nothing")
          ContentList
            Text(" ")
            Text("\n")
        Text("I say nothing. It's true, isn't it? I can't deny that I know there is a world out there, a complicated world of pain and suffering. And I can't deny that I don't think about it a moment longer than I have to. What use is thinking on a problem that cannot be solved? It is precisely our ability to avoid such endless spirals that makes us human and not machine.")
        Text("\n")
        Text("\"God have mercy on your soul,\" Harris says finally, as he gets to his feet and heads for the door. \"I fear no—one else will.\"")
        Text("\n")
        Gather(name=null, depth=1)
        Divert(target="-> left_alone", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="passed_onto_hooper", function=false)
      Weave(baseIndent=0)
        VariableAssignment(name="hooper_mentioned", global=false, temp=false)
          Number(true)
        Text("\"No. I passed it on to Hooper.\"")
        Text("\n")
        Text("\"I see. And what did he do with it?\"")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Evade")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"I don't know.\"")
        Text("\n")
        Text("\"You can do better than that. Remember, there's a hangman's noose waiting for traitors.\"")
        Text("\n")
        Weave(baseIndent=1)
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("Theorise")
            ContentList
              Text(" ")
              Text("\n")
          Text("\"Well, then,\" I answer, nervously. \"What would he do? Either get rid of it straight away — or if that wasn't possible, which it probably wouldn't be, since he'd have to arrange things with his contacts — so most likely, he'd hide it somewhere and wait, until you had the rope around my neck and he could be sure he was safe.\"")
          Text("\n")
          Divert(target="-> claim_hooper_took_component.harris_being_convinced", empty=false, tunnel=false, thread=false)
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("Shrug")
            ContentList
              Text(" ")
              Divert(target="-> claim_hooper_took_component.its_your_problem", empty=false, tunnel=false, thread=false)
              Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Tell the truth")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"I don't think Hooper could have planned this in advance. So he'd need to get word to whoever he's working with, and that would take time. So I think he would have hidden it somewhere, and be waiting to make sure I soundly take the fall. That way, if anything goes wrong, he can arrange for the part to be conveniently re—found.\"")
        Text("\n")
        Divert(target="-> claim_hooper_took_component.harris_being_convinced", empty=false, tunnel=false, thread=false)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Lie")
          ContentList
            Text("\n")
        Text("\"I'm sure I saw him this evening, talking to someone by the fence on the woodland side of the compound. He's probably passed it on already. You'll have to ask him.\"")
        Text("\n")
        Divert(target="-> claim_hooper_took_component.harrumphs", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="claim_hooper_took_component", function=false)
    Weave(baseIndent=0)
      Text("\"I saw Hooper take it.\"")
      Text("\n")
      VariableAssignment(name="hooper_mentioned", global=false, temp=false)
        Number(true)
      ContentList
        Conditional
          VariableReference(losttemper)
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("\"Did you?\"")
              Text("\n")
              Text("The worst of his rage is passing; he is now moving into a kind of contemptuous despair. I can imagine him wrapping up our interview soon, leaving the hut, locking the door, and dropping the key down the well in the yard.")
              Text("\n")
              Text("And why wouldn't he? With my name tarnished they will not let me back to work on the Bombe — if there is the slightest smell of treachery about my name I would be lucky not be locked up for the remainder of the war.")
              Text("\n")
          ConditionalBranch(true=false, else=true, inline=false)
            Weave(baseIndent=0)
              Text("\"I see.\" He is starting to lose his patience. I have seen Harris angry a few times, with lackeys and secretaries. But never with us. With the 'brains' he has always been cautious, treating us like children.")
              Text("\n")
              Text("And now I see that, like a father, he wants to smack us when we disobey him.")
              Text("\n")
      Text("\n")
      Text("\"Just get to the truth, man. Every <i>minute</i> matters.\"")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Persist with this")
        ContentList
          Text("\n")
        VariableReference(admitblackmail)
      Text("\"I know what you're thinking. If I've transgressed once then I must be guilty of everything else... But I'm not. We were close to cracking the 13th's intercept. We were getting correlations in the data. Then Hooper disappeared for a moment, and next minute the machine was down.\"")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Tell the truth")
        ContentList
          Text(" ")
          Text("\n")
      Text("\"Very well. I see there's no point in covering up. You know everything anyway.\"")
      Text("\n")
      Text("Harris nods, and waits for me to continue.")
      Text("\n")
      Divert(target="-> i_met_a_young_man", empty=false, tunnel=false, thread=false)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Persist with this")
        ContentList
          Text("\n")
        Unary(not, VariableReference(admitblackmail))
      Text("\"This is the truth.\"")
      Text("\n")
      Gather(name=null, depth=1)
      Text("I have become, somehow, an accustomed liar — the words roll easily off my tongue. Perhaps I am a traitor, I think, now that I dissemble as easily as one.")
      Text("\n")
      Text("\"Go on,\" Harris says, giving me no indication of whether he believes my tale.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Assert")
        ContentList
          Text(" \"I saw him take it,\" I continue. \"Collins was outside having a cigarette. Peterson was at the table. But I was at the front of the machine. I saw Hooper go around the side. He leant down and pulled something free. I even challenged him. I said, 'What's that? Someone put a nail somewhere they shouldn't have?' He didn't reply.\"")
          Text("\n")
      Text("Harris watches me for a long moment.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Imply")
        ContentList
          Text(" \"At the moment the machine halted, Peterson was at the bench and Collins was outside having a smoke. I was checking the dip—switches. Hooper was the only one at the back of the Bombe. No—one else could have done it.\"")
          Text("\n")
      Text("\"That's not quite the same as seeing him do it,\" Harris remarks.")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Logical")
          ContentList
            Text("\n")
        Text("\"When you have eliminated the impossible...\" I begin, but Harris cuts me off.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Persuasive")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"You have to believe me.\"")
        Text("\n")
        Text("\"We don't have to believe anyone,\" Harris returns. \"I will only be happy with the truth, and your story doesn't tie up. We know you've been leaving yourself open to pressure. We've been watching your activities for some time. But we thought you were endangering the reputation of this site; not risking the country herself. Perhaps I put too much trust in your intellectual pride.\"")
        Text("\n")
        Text("He pauses for a moment, considering something. Then he continues:")
        Text("\n")
        Text("\"It might have been Hooper. It might have been you. ")
        Divert(target="-> we_wont_guess", empty=false, tunnel=false, thread=false)
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Confident")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"Ask the others,\" I reply, leaning back. \"They'll tell you. If they haven't already, that's only because they're protecting Hooper. Hoping he'll come to his senses and stop being an idiot. I hope he does too. And if you lock him up in a freezing hut like you've done me, I'm sure he will.\"")
        Text("\n")
        Text("\"We have,\" Harris replies simply.")
        Text("\n")
        Text("It's all I can do not to gape.")
        Text("\n")
        Divert(target="-> hoopers_hut_3", empty=false, tunnel=false, thread=false)
      Gather(name=null, depth=1)
      Text("\"We are left with two possibilities. You, or Hooper.\" The Commander pauses to smooth down his moustache. ")
      Glue
      Text("\n")
      Gather(name="hoopers_hut_3", depth=1)
      Text("\"Hooper's in Hut 3 with the Captain, having a similar conversation.\"")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("\"And the other men?")
        ContentList
          Text("\"")
        ContentList
          Text(" Do we have a hut each? Are there  enough senior officers to go round?\"")
          Text("\n")
      Text("\"Collins was outside when it happened, and Peterson can't get round the machine in that chair of his,\" Harris replies. \"That leaves you and Hooper.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("\"Then you know I'm right.")
        ContentList
          Text("\"")
        ContentList
          Text(" You knew all along. Why did you threaten me?\"")
          Text("\n")
      Text("\"All we know is that we have a traitor, holding the fate of the country in his hands.")
      Text("\n")
      Gather(name="we_wont_guess", depth=1)
      Glue
      Text(" We're not in the business of guessing here at Bletchley. We are military intelligence. We get answers.\" Harris points a finger. \"And if that component has left these grounds, then every minute is critical.\"")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Co-operate")
        ContentList
          Text(" ")
          Text("\n")
      Text("\"I'd be happy to help,\" I answer, leaning forwards. \"I'm sure there's something I could do.\"")
      Text("\n")
      Text("\"Like what, exactly?\"")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=false)
          ContentList
            Text("\"Put me in with Hooper.\"")
          ContentList
            Text("\n")
        Divert(target="-> putmein", empty=false, tunnel=false, thread=false)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("\"Tell Hooper I've confessed.")
          ContentList
            Text("\"")
          ContentList
            Text(" Better yet. Let him see you marching me off in handcuffs. Then let him go, and see what he does. Ten to one he'll go straight to wherever he's hidden that component and his game will be up.\"")
            Text("\n")
        Text("Harris nods slowly, chewing over the idea. It isn't a bad plan even — except, of course, Hooper has <i>not</i> hidden the component, and won't lead them anywhere. But that's a problem I might be able to solve once I'm out of this place; and once they're too busy dogging Hooper's steps from hut to hut.")
        Text("\n")
        Text("\"Interesting,\" the Commander muses. \"But I'm not so sure he'd be that stupid. And if he's already passed the part on, the whole thing will only be a waste of time.\"")
        Text("\n")
        Weave(baseIndent=2)
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("\"Trust me. He hasn't.")
            ContentList
              Text("\"")
            ContentList
              Text(" If I know that man, and I do, he'll be wanting to keep his options open as long as possible. If the component's gone then he's in it up to his neck. He'll take a week at least to make sure he's escaped suspicion. Then he'll pass it on.\"")
              Text("\n")
          Text("\"And if we keep applying pressure to him, you think the component will eventually just turn up?\"")
          Text("\n")
          Weave(baseIndent=3)
            Choice(name=null, once=true, invisible=false, depth=4, inline=true)
              ContentList
                Text("\"Yes.")
              ContentList
                Text("\"")
              ContentList
                Text(" Probably under my bunk.\"")
                Text("\n")
            Text("Harris smiles wryly. \"We'll know that for a fake, then. We've looked there already.")
            Text("\n")
            Choice(name=null, once=true, invisible=false, depth=4, inline=false)
              ContentList
                Text("\"Or be thrown into the river.\" ")
              ContentList
                Text("\n")
            Text("\"Hmm.\" Harris chews his moustache thoughtfully. \"Well, that would put us in a spot, seeing as how we'd never know for certain. We'd have to be ready to change our whole approach just in case the part had got through to the Germans.")
            Text("\n")
            Gather(name=null, depth=4)
            Glue
            Text(" I don't mind telling you, this is a disaster, this whole thing. What I want is to find that little bit of mechanical trickery. I don't care where. In your luncheon box or under Hooper's pillow. Just somewhere, and within the grounds of this place.\"")
            Text("\n")
            Choice(name=null, once=true, invisible=false, depth=4, inline=true)
              ContentList
                Text("\"Then let him he think he's off the hook.")
              ContentList
                Text("\"")
              ContentList
                Text(" Make a show of me. And then you'll get your man.\"")
                Text("\n")
            Text("<i>Somehow</i>, I think. But that's the part I need to work.")
            Text("\n")
            Divert(target="-> harris_takes_you_to_hooper", empty=false, tunnel=false, thread=false)
            Choice(name=null, once=true, invisible=false, depth=4, inline=true)
              ContentList
                Text("\"Then you'd better get searching")
              ContentList
                Text(".\"")
              ContentList
                Text(",\" I reply, tiring of his complaining. A war is a war, you have to expect an enemy. ")
                Divert(target="-> its_your_problem", empty=false, tunnel=false, thread=false)
                Text("\n")
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("\"You're right. Let me talk to him")
            ContentList
              Text(".\"")
            ContentList
              Text(", then. As a colleague. Maybe I can get something useful out of him.\"")
              Text("\n")
          Divert(target="-> putmein", empty=false, tunnel=false, thread=false)
          Choice(name=null, once=true, invisible=false, depth=3, inline=false)
            ContentList
              Text("\"You're right.\" ")
            ContentList
              Divert(target="-> shake_head", empty=false, tunnel=false, thread=false)
              Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Block")
        ContentList
          Text(" ")
          Divert(target="-> its_your_problem", empty=false, tunnel=false, thread=false)
          Text("\n")
    Flow(level=Stitch, name="harris_being_convinced", function=false)
      Weave(baseIndent=0)
        Text("\"Makes sense,\" Harris agrees, cautiously. ")
        ContentList
          Conditional
            Binary(>, VariableReference(evasive), Number(1))
            ConditionalBranch(true=true, else=false, inline=true)
              Weave(baseIndent=0)
                Text("I can see he's still not entirely convinced by my tale, as well he might not be — I've hardly been entirely straight with him.")
            ConditionalBranch(true=false, else=true, inline=true)
              Weave(baseIndent=0)
                Text("I can see he's still not certain whether he can trust me.")
        Text(" \"Which means the question is, what can we do to rat him out?\"")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Offer to help")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"Maybe I can help with that.\"")
        Text("\n")
        Text("\"Oh, yes? And how, exactly?\"")
        Text("\n")
        Weave(baseIndent=1)
          Choice(name=null, once=true, invisible=false, depth=2, inline=false)
            ContentList
              Text("\"I'll talk to him.\" ")
            ContentList
              Text("\n")
          Text("\"What?\"")
          Text("\n")
          Text("\"Put me in with Hooper with him. Maybe I can get something useful out of him.\"")
          Text("\n")
          Divert(target="-> putmein", empty=false, tunnel=false, thread=false)
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("\"We'll fool him.")
            ContentList
              Text("\"")
            ContentList
              Text(" He's waiting to be sure that I've been strung up for this, so let's give him what he wants. If he sees me taken away, clapped in irons — he'll go straight to that component and set about getting rid of it.\"")
              Text("\n")
          Divert(target="-> harris_takes_you_to_hooper", empty=false, tunnel=false, thread=false)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Don't offer to help")
          ContentList
            Text("\n")
        Text("I lean back. ")
        Divert(target="-> its_your_problem", empty=false, tunnel=false, thread=false)
        Text("\n")
    Flow(level=Stitch, name="putmein", function=false)
      Weave(baseIndent=0)
        Text("Harris shakes his head.")
        Text("\n")
        Text("\"He despises you. I don't see why he'd give himself up to you.\"")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Insist")
          ContentList
            Text(" \"Try me. Just me and him.\" ")
            Text("\n")
        Divert(target="-> go_in_alone", empty=false, tunnel=false, thread=false)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Give in")
          ContentList
            Text(" \"You're right.\" ")
            Text("\n")
        Divert(target="-> shake_head", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="shake_head", function=false)
      Weave(baseIndent=0)
        Glue
        Text(" I shake my head. \"You're right. I don't see how I can help you. So there's only one conclusion.\"")
        Text("\n")
        Text("\"Oh, yes? And what's that?\"")
        Text("\n")
        Divert(target="-> its_your_problem", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="its_your_problem", function=false)
      Weave(baseIndent=0)
        Text("\"It's your problem. Your security breach. So much for your careful vetting process.\"")
        Text("\n")
        Text("I lean back in my chair and fold my arms so the way they shake will not be visible.")
        Text("\n")
        Text("\"You'd better get on with solving it, instead of wasting your time in here with me.\"")
        Text("\n")
        Divert(target="-> harrumphs", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="harrumphs", function=false)
      Weave(baseIndent=0)
        Text("Harris harrumphs. He's thinking it all over.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Wait")
          ContentList
            Text(" ")
            Text("\n")
          VariableReference(putmein)
        Text("\"All right,\" he declares, gruffly. \"We'll try it. But if this doesn't work, I might just put the both of you in front of a firing squad and be done with these games. Worse things happen in time of war, you know.\"")
        Text("\n")
        Text("\"Alone,\" I add.")
        Text("\n")
        Divert(target="-> go_in_alone", empty=false, tunnel=false, thread=false)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Wait")
          ContentList
            Text(" ")
            Text("\n")
          VariableReference(putmein)
        Text("\"No,\" Harris declares, finally. \"I think you're lying about Hooper. I think you're a clever, scheming young man — that's why we hired you — and you're looking for the only reasonable out this situation has to offer. But I'm not taking it. We know you were in the room with the machine, we know you're of a perverted persuasion, we know you have compromised yourself. There's nothing more to say here. Either you tell me what you've done with that component, or we will hang you and search just as hard. It's your choice.\"")
        Text("\n")
        Divert(target="-> harris_threatens_lynching", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="go_in_alone", function=false)
      Weave(baseIndent=0)
        Text("\"Alone?\"")
        Text("\n")
        Text("\"Alone.\"")
        Text("\n")
        Text("Harris considers it. I watch his eyes, flicking backwards and forwards over mine, like a ribbon—reader loading its program.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Patient")
          ContentList
            Text(" \"Well?\"")
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Impatient")
          ContentList
            Text(" \"For God's sake, man, what do you have to lose?\" ")
            Text("\n")
        ContentList
          FunctionCall(raise, args=1)
          Text("\n")
        Gather(name=null, depth=1)
        Text("\"We'll be outside the door,\" Harris replies, seriously. \"The first sign of any funny business and we'll have you both on the floor in minutes. You understand? The country needs your brain, but it's not too worried about your legs. Remember that.\"")
        Text("\n")
        Text("Then he gets to his feet, and opens the door, and marches me out across the yard. The evening is drawing in and there's a chill in the air. My mind is racing. I have one opportunity here — a moment in which to put the fear of God into Hooper and make him do something foolish that places him in harm's way. But how to achieve it?")
        Text("\n")
        Text("\"You ready?\" Harris demands.")
        Text("\n")
        Choice(name="yes", once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Yes")
          ContentList
            Text("\n")
        Text("\"Absolutely.\"")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("No")
          ContentList
            Text("\n")
        Text("\"No.\"")
        Text("\n")
        Text("\"Too bad.\"")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Lie")
          ContentList
            Text(" ")
            Divert(target="-> yes", empty=false, tunnel=false, thread=false)
            Text("\n")
        Gather(name=null, depth=1)
        Divert(target="-> inside_hoopers_hut", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="harris_takes_you_to_hooper", function=false)
    Weave(baseIndent=0)
      Text("Harris gets to his feet. \"All right,\" he says. \"I should no better than to trust a clever man, but we'll give it a go.\"")
      Text("\n")
      Text("Then, he smiles, with all his teeth, like a wolf.")
      Text("\n")
      ContentList
        Conditional
          VariableReference(claim_hooper_took_component.hoopers_hut_3)
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("\"Especially since this is a plan that involves keeping you in handcuffs. I don't see what I have to lose.\"")
              Text("\n")
          ConditionalBranch(true=false, else=true, inline=false)
            Weave(baseIndent=0)
              Text("\"Hooper's in Hut 3 being debriefed by the Captain. Let's see if we can't get his attention somehow.\"")
              Text("\n")
      Text("\n")
      Text("He raps on the door for the guard and gives the man a quick instruction. He returns a moment later with a cool pair of iron cuffs.")
      Text("\n")
      Text("\"Put 'em up,\" Harris instructs, and I do so. The metal closes around my wrists like a trap. I stand and follow Harris willingly out through the door.")
      Text("\n")
      Text("But whatever I'm doing with my body, my mind is scheming. <i>Somehow,</i> I'm thinking, <i>I have to get away from these men long enough to get that component behind Hut 2 and put it somewhere Hooper will go. Or, otherwise, somehow get Hooper to go there himself...</i>")
      Text("\n")
      Text("Harris marches me over to Hut 3, and gestures for the guard to stand aside. Pushing me forward, he opens the door nice and wide.")
      Text("\n")
      Text("\"Captain. Manning talked. If you'd step out for a moment?\"")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Play the part, head down")
        ContentList
          Text("\n")
      Text("From where he's sitting, I know Hooper can see me, so I keep my head down and look guilty as sin. The bastard is probably smiling.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Look inside the hut")
        ContentList
          Text("\n")
      Text("I look in through the door and catch Hooper's expression. I had half expected him to be smiling be he isn't. He looks shocked, almost hurt. \"Iain,\" he murmurs. \"You couldn't...\"")
      Text("\n")
      Choice(name="shouted", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Call to Hooper")
        ContentList
          Text(" ")
          Text("\n")
      Text("I have a single moment to shout something to Hooper before the door closes.")
      Text("\n")
      Text("\"I'll get you Hooper, you'll see!\" I cry. Then:")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("\"Queen to rook two, checkmate!\"")
          ContentList
            Text(" I call, then laugh viciously, as if I am damning him straight to hell.")
            Text("\n")
        VariableAssignment(name="hooperClueType", global=false, temp=false)
          VariableReference(CHESS)
        Gather(name="only_catch", depth=2)
        Text("I only catch Hooper's reaction for a moment — his eyebrow lifts in surprise and alarm. Good. If he thinks it is a threat then he just might be careless enough to go looking for what it might mean.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=false)
          ContentList
            Text("\"Ask not for whom the bell tolls!\"")
          ContentList
            Text("\n")
        Text("He stares back at me, as if were a madman and perhaps for a split second I see him shudder.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("\"Two words: messy, without one missing!\"")
          ContentList
            Text(" I cry, laughing. It isn't the best clue, hardly worthy of The Times, but it will have to do.")
            Text("\n")
        VariableAssignment(name="hooperClueType", global=false, temp=false)
          VariableReference(CROSSWORD)
        Divert(target="-> only_catch", empty=false, tunnel=false, thread=false)
      Gather(name=null, depth=1)
      Text("The Captain comes outside, pulling the door to. \"What's this?\" he asks. \"A confession? Just like that?\"")
      Text("\n")
      Text("\"No,\" the Commander admits, in a low voice. \"I'm afraid not. Rather more a scheme. The idea is to let Hooper go and see what he does. If he believes we have Manning here in irons, he'll try to shift the component.\"")
      Text("\n")
      Text("\"If he has it.\"")
      Text("\n")
      Text("\"Indeed.\"")
      Text("\n")
      Text("The Captain peers at me for a moment, like I was some kind of curious insect.")
      Text("\n")
      Text("\"Sometimes, I think you people are magicians,\" he remarks. \"Other times you seem more like witches. Very well.\"")
      Text("\n")
      Text("With that he opens the door to the Hut and goes back inside. The Commander uses the moment to hustle me roughly forward.")
      Text("\n")
      ContentList
        Conditional
          VariableReference(shouted)
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("\"And what was all that shouting about?\" he hisses in my ear as we move towards the barracks. \"Are you trying to pull something? Or just make me look incompetent?\"")
              Text("\n")
          ConditionalBranch(true=false, else=true, inline=false)
            Weave(baseIndent=0)
              Text("\"This scheme of yours had better come off,\" he hisses in my ear. \"Otherwise the Captain is going to start having men tailing <i>me</i> to see where I go on Saturdays.\"")
              Text("\n")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Reassure")
        ContentList
          Text(" ")
          Text("\n")
      ContentList
        Conditional
          Unary(not, VariableReference(shouted))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("\"It will. Hooper's running scared,\" I reply, hoping I sound more confident than I feel.")
              Text("\n")
          ConditionalBranch(true=false, else=true, inline=false)
            Weave(baseIndent=0)
              Text("\"Just adding to the drama,\" I tell him, confidently. \"I'm sure you can understand that.\"")
              Text("\n")
      Text("\n")
      Text("\"I think we've had enough drama today already,\" Harris replies. \"Let's hope for a clean kill.\"")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Dissuade")
        ContentList
          Text(" ")
          Text("\n")
      ContentList
        Conditional
          Unary(not, VariableReference(shouted))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("\"The Captain thought it was a good scheme. You'll most likely get a promotion.\"")
              Text("\n")
          ConditionalBranch(true=false, else=true, inline=false)
            Weave(baseIndent=0)
              Text("\"I'm not trying to do anything except save my neck.\"")
              Text("\n")
      Text("\n")
      Text("\"Let's hope things work out,\" Harris agrees darkly.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Evade")
        ContentList
          Text(" ")
          Text("\n")
      Text("\"We're still in ear—shot if they let Hooper go. Best get us inside and then we can talk, if we must.\"")
      Text("\n")
      Text("\"I've had enough of your voice for one day,\" Harris replies grimly. ")
      Glue
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Say nothing")
        ContentList
          Text("\n")
      Text("I let him have his rant. ")
      Glue
      Text("\n")
      Gather(name=null, depth=1)
      Text("He hustles me up the steps of the barracks, keeping me firmly gripped as if I had any chance of giving him, a trained military man, the slip. It's all I can do not to fall into the room.")
      Text("\n")
      Divert(target="-> slam_door_shut_and_gone", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="inside_hoopers_hut", function=false)
    Weave(baseIndent=0)
      Gather(name=null, depth=1)
      Text("Harris opens the door and pushes me inside. \"Captain,\" he calls. \"Could I have a moment?\"")
      Text("\n")
      Text("The Captain, looking puzzled, steps out. The door is closed. Hooper stares at me, open—mouthed, about to say something. I probably have less than a minute before the Captain storms back in and declares this plan to be bunkum.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Threaten")
        ContentList
          Text("\n")
      Text("\"Listen to me, Hooper. We were the only men in that hut today, so we know what happened. But I want you to know this. I put the component inside a breeze—block in the foundations of Hut 2, wrapped in one of your shirts. They're going to find it eventually, and that's going to be what tips the balance. And there's nothing you can do to stop any of that from happening.\"")
      Text("\n")
      VariableAssignment(name="hooperClueType", global=false, temp=false)
        VariableReference(STRAIGHT)
      Text("His eyes bulge with terror. \"What did I do, to you? What did I ever do?\"")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Tell the truth")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"You treated me like vermin. Like something abhorrent.\"")
        Text("\n")
        Text("\"You are something abhorrent.\"")
        Text("\n")
        Text("\"I wasn't. Not when I came here. And I won't be, once you're gone.\"")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Lie")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"Nothing,\" I reply. \"You're just the other man in the room. One of us has to get the blame.\"")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Evade")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"It doesn't matter. Just remember what I said. I've beaten you, Hooper. Remember that.\"")
        Text("\n")
        Gather(name=null, depth=2)
        Text("I get to my feet and open the door of the Hut. The Captain storms back inside and I'm quickly thrown out. ")
        Divert(target="-> hustled_out", empty=false, tunnel=false, thread=false)
        Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Bargain")
        ContentList
          Text(" ")
          Text("\n")
      Text("\"Hooper, I'll make a deal with you. We both know what happened in that hut this afternoon. I know because I did it, and you know because you know you didn't. But once this is done I'll be rich, and I'll split that with you. I'll let you have the results, too. Your name on the discovery of the Bombe. And it won't hurt the war effort — you know as well as me that the component on its own is worthless, it's the wiring of the Bombe, the usage, that's what's valuable. So how about it?\"")
      Text("\n")
      Text("Hooper looks back at me, appalled. \"You're asking me to commit treason?\"")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Yes")
          ContentList
            Text("\n")
        Text("\"Yes, perhaps. But also to ensure your name goes down in the annals of mathematics. ")
        Divert(target="-> back_of_hut_2", empty=false, tunnel=false, thread=false)
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("No")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"No. It's not treason. It's a trade, plain and simple.\"")
        Text("\n")
        Choice(name="lie", once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Lie")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"I'm suggesting you save your own skin. I've wrapped that component in one of your shirts, Hooper. They'll be searching this place top to bottom. They'll find it eventually, and when they do, that's the thing that will swing it against you. So take my advice now. Hut 2.\"")
        Text("\n")
        VariableAssignment(name="hooperClueType", global=false, temp=false)
          VariableReference(STRAIGHT)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Evade")
          ContentList
            Text(" ")
            Divert(target="-> lie", empty=false, tunnel=false, thread=false)
            Text("\n")
        Gather(name=null, depth=2)
        Divert(target="-> no_chance", empty=false, tunnel=false, thread=false)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Plead")
        ContentList
          Text(" ")
          Text("\n")
      Text("\"Please, Hooper. You don't understand. They have information on me.  I don't need to tell you what I've done, you know. Have a soul. And the component — it's nothing. It's not the secret of the Bombe. It's just a part. The German's think it's a weapon — a missile component. Let them have it. Please, man. Just help me.\"")
      Text("\n")
      Text("\"Help you?\" Hooper stares. \"Help you? You're a traitor. A snake in the grass. And you're <i>queer</i>.\"")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Deny")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"I'm no traitor. You <i>know</i> I'm not. How much work have I done here against the Germans? I've given my all. And you know as well as I do, if the Reich were to invade, I would be a dead man. Please, Hooper. I'm not doing any of this lightly.\"")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Accept")
          ContentList
            Text("\n")
        Text("\"I am what I am,\" I reply. \"I'm the way I was made. But they'll hang me unless you help, Hooper. Don't let them hang me.\"")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Evade")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"That's not important now. What matters is what you do, this evening.\"")
        Text("\n")
        Gather(name=null, depth=2)
        Text("\"Assuming I wanted to help you,\" he replies, carefully. \"Which I don't. What would I do?\"")
        Text("\n")
        Text("\"Nothing. Almost nothing.")
        Text("\n")
        Divert(target="-> back_of_hut_2", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="back_of_hut_2", function=false)
      Weave(baseIndent=0)
        Glue
        Text(" All you have to do is go to the back of Hut 2. There's a breeze—block with a cavity. That's where I've put it. I'll be locked up overnight. But you can pick it up and pass it to my contact. He'll be at the south fence around two AM.\"")
        Text("\n")
        VariableAssignment(name="hooperClueType", global=false, temp=false)
          VariableReference(STRAIGHT)
        Divert(target="-> no_chance", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="no_chance", function=false)
      Weave(baseIndent=0)
        Text("\"If you think I'll do that then you're crazy,\" Hooper replies.")
        Text("\n")
        Text("At that moment the door flies open and the Captain comes storming back inside.")
        Text("\n")
        Divert(target="-> hustled_out", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="hustled_out", function=false)
      Weave(baseIndent=0)
        Text("Harris hustles me over to the barracks. \"I hope that's the end of it,\" he mutters.")
        Text("\n")
        Text("\"Just be sure to let him out,\" I reply. \"And then see where he goes.\"")
        Text("\n")
        Divert(target="-> slam_door_shut_and_gone", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="slam_door_shut_and_gone", function=false)
    Weave(baseIndent=0)
      Text("Then they slam the door shut, and it locks.")
      Text("\n")
      ContentList
        Conditional
          Binary(==, VariableReference(hooperClueType), VariableReference(NONE))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Glue
              Text(" How am I supposed to manage anything from in here?")
              Text("\n")
              Choice(name=null, once=true, invisible=false, depth=1, inline=true)
                ContentList
                  Text("Try the door")
                ContentList
                  Text(" ")
                  Divert(target="-> try_the_door", empty=false, tunnel=false, thread=false)
                  Text("\n")
              Choice(name=null, once=true, invisible=false, depth=1, inline=true)
                ContentList
                  Text("Try the windows")
                ContentList
                  Text(" ")
                  Divert(target="-> try_the_windows", empty=false, tunnel=false, thread=false)
                  Text("\n")
          ConditionalBranch(true=false, else=true, inline=false)
            Weave(baseIndent=0)
              Text("I can only hope that Hooper bites. If he thinks I'm bitter enough to have framed him, and arrogant enough to have taunted him with ")
              ContentList
                Conditional
                  Binary(>, VariableReference(hooperClueType), VariableReference(STRAIGHT))
                  ConditionalBranch(true=true, else=false, inline=true)
                    Weave(baseIndent=0)
                      Text("a clue to")
              Text(" where the damning evidence is hidden...")
              Text("\n")
              Text("If he hates me enough, and is paranoid enough, then he might ")
              ContentList
                Conditional
                  Binary(>, VariableReference(hooperClueType), VariableReference(STRAIGHT))
                  ConditionalBranch(true=true, else=false, inline=true)
                    Weave(baseIndent=0)
                      Text("unravel my little riddle and")
              Text(" go searching around Hut 2.")
              Text("\n")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Wait")
        ContentList
          Text(" \t")
          Divert(target="-> night_falls", empty=false, tunnel=false, thread=false)
          Text("\n")
    Flow(level=Stitch, name="try_the_door", function=false)
      Weave(baseIndent=0)
        Text("I try the door. It's locked, of course.")
        Text("\n")
        Divert(target="-> from_outside_heard", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="from_outside_heard", function=false)
      Weave(baseIndent=0)
        Text("From outside, I hear a voice. Hooper's. He's haranguing someone.")
        Text("\n")
        Gather(name="opts", depth=1)
        Choice(name="listened", once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Listen at the keyhole")
          ContentList
            Text(" ")
            Text("\n")
        Text("I put my ear down to the keyhole, but there's nothing now. Probably still a guard outside, of course, but they're keeping mum.")
        Text("\n")
        Divert(target="-> opts", empty=false, tunnel=false, thread=false)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Try the window")
          ContentList
            Text(" ")
            Divert(target="-> try_the_windows", empty=false, tunnel=false, thread=false)
            Text("\n")
          Unary(not, VariableReference(try_the_windows))
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Try the door")
          ContentList
            Text(" ")
            Divert(target="-> try_the_door", empty=false, tunnel=false, thread=false)
            Text("\n")
          MultipleCondition(Unary(not, VariableReference(try_the_door)), VariableReference(listened))
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Smash the window")
          ContentList
            Text(" ")
            Divert(target="-> try_to_smash_the_window", empty=false, tunnel=false, thread=false)
            Text("\n")
          VariableReference(try_the_windows)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Wait")
          ContentList
            Text(" ")
            Text("\n")
          Binary(&&, VariableReference(try_the_door), VariableReference(try_the_windows))
        Text("It's useless. There's nothing I can do but hope. I sit down on one corner of the bunk to wait.")
        Text("\n")
        Divert(target="-> night_falls", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="try_the_windows", function=false)
      Weave(baseIndent=0)
        Text("I go over to the window and try to jimmy it open. Not much luck, but in my struggling I notice this window only backs on the thin little brook that runs down the back of the compound. Which means, if I smashed it, I might get away with no—one seeing.")
        Text("\n")
        Divert(target="-> from_outside_heard", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="try_to_smash_the_window", function=false)
      Weave(baseIndent=0)
        Text("The window is my only way out of here. I just need a way to smash it.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Punch it")
          ContentList
            Text(" ")
            Text("\n")
        Text("I suppose my fist would do a good enough job. But I'd cut myself to ribbons, most likely. ")
        Glue
        Text("\n")
        Choice(name="use_bucket", once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Find something")
          ContentList
            Text(" ")
            Text("\n")
        VariableAssignment(name="smashingWindowItem", global=false, temp=false)
          VariableReference(BUCKET)
        Text("I cast around the small room. There's a bucket in one corner for emergencies — I suppose I could use that. I pick it up but it's not very easy to heft. ")
        Glue
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Use something you've got")
          ContentList
            Text(" ")
            Text("\n")
        Text("I pat down my pockets but all I'm carrying is the intercept, which is no good at all.")
        Text("\n")
        Weave(baseIndent=1)
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("Something you're wearing?")
            ContentList
              Text(" ")
              Text("\n")
          Text("Ah, but of course! I slip off one shoe and heft it by the toe. The heel will make a decent enough hammer, if I give it enough wallop.")
          Text("\n")
          VariableAssignment(name="smashingWindowItem", global=false, temp=false)
            VariableReference(SHOE)
          Text("But I'll cut my hand to ribbons doing it. ")
          Glue
          Text("\n")
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("Look around")
            ContentList
              Text(" ")
              Divert(target="-> use_bucket", empty=false, tunnel=false, thread=false)
              Text("\n")
        Gather(name=null, depth=1)
        Text("And the noise would be terrible. There must be a way of making this easier. I'm supposed to be a thief now. What would a burglar do?")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Work slowly")
          ContentList
            Text(" ")
            Text("\n")
        Text("Work carefully? It's difficult to work carefully when all one's has is ")
        ContentList
          Conditional
            Binary(==, VariableReference(smashingWindowItem), VariableReference(BUCKET))
            ConditionalBranch(true=true, else=false, inline=true)
              Weave(baseIndent=0)
                Text("a bucket. It's rather like the sledgehammer for the proverbial nut")
            ConditionalBranch(true=false, else=true, inline=true)
              Weave(baseIndent=0)
                ContentList
                  Conditional
                    Binary(==, VariableReference(smashingWindowItem), VariableReference(SHOE))
                    ConditionalBranch(true=true, else=false, inline=true)
                      Weave(baseIndent=0)
                        Text("a shoe")
                    ConditionalBranch(true=false, else=true, inline=true)
                      Weave(baseIndent=0)
                        Text("nothing but brute force")
        Text(".")
        Text("\n")
        Weave(baseIndent=1)
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("Just do it")
            ContentList
              Text(" ")
              Divert(target="-> time_to_move_now", empty=false, tunnel=false, thread=false)
              Text("\n")
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("Look around for something")
            ContentList
              Text(" ")
              Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Find something to help")
          ContentList
            Text(" ")
            Text("\n")
        Gather(name=null, depth=1)
        Divert(target="-> find_something_to_smash_window", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="time_to_move_now", function=false)
      Weave(baseIndent=0)
        Text("Enough of this. There isn't any time to lose. Right now they'll be following Hooper as he goes to bed, and goes to sleep; and then that's it. The minute he closes his eyelids and drifts off that's the moment that this trap swings shut on me.")
        Text("\n")
        Text("So I punch out the glass with my ")
        ContentList
          Conditional
            Binary(==, VariableReference(smashingWindowItem), VariableReference(BUCKET))
            ConditionalBranch(true=true, else=false, inline=true)
              Weave(baseIndent=0)
                Text("bucket")
            ConditionalBranch(true=false, else=true, inline=true)
              Weave(baseIndent=0)
                ContentList
                  Conditional
                    Binary(==, VariableReference(smashingWindowItem), VariableReference(SHOE))
                    ConditionalBranch(true=true, else=false, inline=true)
                      Weave(baseIndent=0)
                        Text("shoe")
                    ConditionalBranch(true=false, else=true, inline=true)
                      Weave(baseIndent=0)
                        Text("fist")
        Text(" and it shatters with a terrific noise. Then I stop, and wait, to see if anyone will come in through the door.")
        Text("\n")
        Text("Nothing.")
        Text("\n")
        Choice(name="pause", once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Wait a little longer")
          ContentList
            Text(" ")
            Text("\n")
        Text("I pause for a moment longer. It doesn't do to be too careless...")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Clear the frame of shards")
          ContentList
            Text("\n")
        Text("With my jacket wrapped round my arm, I sweep out the remaining shards of glass. It's not a big window, but I'm not a big man. If I was Harris, I'd be stuffed, but as it is...")
        Text("\n")
        Gather(name=null, depth=1)
        Text("Then the door locks turns. The door opens. Then Jeremy — one of the guards, rather — sticks his head through the door. \"I thought I heard...\"")
        Text("\n")
        Text("He stops. Looks for a moment. ")
        ContentList
          Conditional
            Binary(==, VariableReference(smashingWindowItem), VariableReference(BUCKET))
            ConditionalBranch(true=true, else=false, inline=true)
              Weave(baseIndent=0)
                Text("Sees the bucket in my hand.")
            ConditionalBranch(true=false, else=true, inline=true)
              Weave(baseIndent=0)
                Text("Sees the broken window.")
        Text(" Then without a moment's further thought he blows his shrill whistles and hustles into the hut, grabbing me roughly by my arms.")
        Text("\n")
        ContentList
          Conditional
            VariableReference(pause)
            ConditionalBranch(true=true, else=false, inline=false)
              Weave(baseIndent=0)
                Text("I'll never know if I hadn't have waited that extra moment — maybe I still could have got away. But, how far?")
                Text("\n")
        Text("\n")
        Text("I'm hustled into one of the huts. Nowhere to sleep, but they're not interested in my comfort any longer. Harris comes in with the Captain.")
        Text("\n")
        Text("\"So,\" Harris remarks. \"Looks like your little trap worked. Only it worked to show <i>you</i> out for what you are.\"")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Tell the truth")
          ContentList
            Text(" ")
            Text("\n")
        ContentList
          Conditional
            VariableReference(i_met_a_young_man)
            ConditionalBranch(true=true, else=false, inline=false)
              Weave(baseIndent=0)
                Text("\"Please, Harris. You can't understand the pressure they put me under. You can't understand what it's like, to be in love but be able to do nothing about it...\"")
                Text("\n")
            ConditionalBranch(true=false, else=true, inline=false)
              Weave(baseIndent=0)
                Text("\"Harris. They were blackmailing me. They knew about... certain indiscretions. You can understand, can't you, Harris? I was in an impossible bind...\"")
                Text("\n")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Lie")
          ContentList
            Text("\n")
        Text("\"I had to get out, Harris. I had to provoke Hooper into doing something that would incriminate himself fully. He's too clever, you see...\"")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Evade")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"This proves nothing,\" I reply stubbornly. \"You still don't have the component and without it, I don't see what you can hope to prove.\"")
        Text("\n")
        Gather(name=null, depth=1)
        Text("\"Be quiet, man. We know all about your and your sordid affairs.\" The Captain curls his lip. \"Don't you know there's a war on? Do you know the kind of place they would have sent you if it haven't had been for that brain of yours? Don't you think you owe it to your country to use it a little more?\"")
        Text("\n")
        Text("<i>Do I</i>, I wonder? <i>Do I owe this country anything, this country that has spurned who and what am I since the day I became a man?</i>")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Yes")
          ContentList
            Text(" ")
            Text("\n")
        Text("My anger deflates like a collapsing equation, all arguments cancelling each other out. The world, of course, owes me nothing; and I owe it everything.")
        Text("\n")
        Choice(name="alone", once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("No")
          ContentList
            Text(" ")
            Text("\n")
        Text("<i>Of course not. I am alone; that is what they wanted me to be, because of who and what I love. So I have no nation, no country.</i>")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Lie")
          ContentList
            Text(" \t")
            Divert(target="-> alone", empty=false, tunnel=false, thread=false)
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Evade")
          ContentList
            Text(" \t")
            Text("\n")
        Text("<i>But what is a country, after all? A country is not a concept, not an ideal. Every country falls, its borders shift and move, its language disappears to be replaced by another. Neither the Reich nor the British Empire will survive forever, so what use is my loyalty to either? </i>")
        Text("\n")
        Text("<i>I may as well, therefore, look after myself. Something I have attempted, but failed miserably, to do.</i>")
        Text("\n")
        Gather(name=null, depth=1)
        Text("\"I'm afraid we have only one option, Manning,\" Harris says. \"Please, man. Tell us where the component is.\"")
        Text("\n")
        VariableAssignment(name="notraitor", global=false, temp=false)
          Number(true)
        VariableAssignment(name="losttemper", global=false, temp=false)
          Number(false)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Tell them")
          ContentList
            Text("\n")
        VariableAssignment(name="revealedhooperasculprit", global=false, temp=false)
          Number(false)
        Text("\"All right.\" I am beaten, after all. \"")
        Glue
        Divert(target="-> reveal_location_of_component", empty=false, tunnel=false, thread=false)
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Say nothing")
          ContentList
            Text(" ")
            Divert(target="-> my_lips_are_sealed", empty=false, tunnel=false, thread=false)
            Text("\n")
    Flow(level=Stitch, name="find_something_to_smash_window", function=false)
      Weave(baseIndent=0)
        Text("Let me see. There's the bunk, ")
        ContentList
          Conditional
            Binary(!=, VariableReference(smashingWindowItem), VariableReference(BUCKET))
            ConditionalBranch(true=true, else=false, inline=true)
              Weave(baseIndent=0)
                Text("a bucket,")
        Text(" nothing else. I have my jacket but nothing in the pockets — no handkerchief, for instance.")
        Text("\n")
        Gather(name="opts", depth=1)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("The bunk")
          ContentList
            Text(" \t")
            Text("\n")
        Text("The bunk has a solid metal frame, a blanket, a pillow, nothing more.")
        Text("\n")
        Weave(baseIndent=1)
          Gather(name="bunk_opts", depth=2)
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("The frame")
            ContentList
              Text("\n")
          Text("The frame is heavy and solid. I couldn't lift it or shift it without help from another man. And it wouldn't do me any good here anyway. I can reach the window perfectly well.")
          Text("\n")
          Divert(target="-> bunk_opts", empty=false, tunnel=false, thread=false)
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("The blanket")
            ContentList
              Text(" ")
              Text("\n")
          Text("The blanket. Perfect. I scoop it up off the bed and hold it in place over the window. ")
          Divert(target="-> smash_the_window", empty=false, tunnel=false, thread=false)
          Text("\n")
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("The pillow")
            ContentList
              Text(" ")
              Text("\n")
          Text("The pillow is fat and fluffy. I could put it over the window and it would muffle the sound of breaking glass, certainly; but I wouldn't be able to break any glass through it either.")
          Text("\n")
          Divert(target="-> bunk_opts", empty=false, tunnel=false, thread=false)
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("Something else")
            ContentList
              Text(" ")
              Divert(target="-> opts", empty=false, tunnel=false, thread=false)
              Text("\n")
            Binary(>, VariableReference(bunk_opts), Number(1))
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("The jacket")
          ContentList
            Text(" ")
            Text("\n")
        Text("I slip off my jacket and hold it with one hand over the glass. ")
        Divert(target="-> smash_the_window", empty=false, tunnel=false, thread=false)
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("The bucket")
          ContentList
            Text(" ")
            Text("\n")
          Binary(!=, VariableReference(smashingWindowItem), VariableReference(BUCKET))
        Text("The bucket? Hardly. The bucket might do some good if I wanted to sweep up the glass afterwards, but it won't help me smash the glass quietly.")
        Text("\n")
        Divert(target="-> opts", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="smash_the_window", function=false)
    Weave(baseIndent=0)
      Text("Then I heft ")
      ContentList
        Conditional
          Binary(==, VariableReference(smashingWindowItem), VariableReference(BUCKET))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("up the bucket — this really is quite a fiddly thing to be doing in cuffs — ")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              ContentList
                Conditional
                  Binary(==, VariableReference(smashingWindowItem), VariableReference(SHOE))
                  ConditionalBranch(true=true, else=false, inline=true)
                    Weave(baseIndent=0)
                      Text(" my shoe by its toe, ")
                  ConditionalBranch(true=false, else=true, inline=true)
                    Weave(baseIndent=0)
                      Text("back my arm, ")
      Text(" and take a strong swing, trying to imagine it's Harris' face on the other side.")
      Text("\n")
      VariableAssignment(name="smashedglass", global=false, temp=false)
        Number(true)
      VariableAssignment(name="smashingWindowItem", global=false, temp=false)
        VariableReference(NONE)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Smash!")
        ContentList
          Text("\n")
      Gather(name=null, depth=1)
      Text("The sound of the impact is muffled. With my arm still covered, I sweep out the remaining glass in the frame.")
      Text("\n")
      Gather(name=null, depth=1)
      Text("I'm ready to escape. The only trouble is — when they look in on me in the morning, there will be no question what has happened. It won't help me one jot with shifting suspicion off my back.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Wait")
        ContentList
          Text("\n")
      Text("So perhaps I should wait it out, after all. Who knows? I might have a better opportunity later.")
      Text("\n")
      Divert(target="-> night_passes", empty=false, tunnel=false, thread=false)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Slip out")
        ContentList
          Text(" ")
          Text("\n")
      Text("Moving quickly and quietly, I hoist myself up onto the window—frame and worm my way outside into the freezing night air. Then I am away, slipping down the paths between the Huts, sticking to the shadows, on my way to Hut 2.")
      Text("\n")
      Gather(name=null, depth=1)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Go the shortest way")
        ContentList
          Text(" ")
          Text("\n")
      Text("There's no time to lose. Throwing caution to the wind I make my way quickly to Hut 2, and around the back. I don't think I've been seen but if I have it is too late. My actions are suspicious enough for the noose. I have no choice but to follow through.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Take a longer route")
        ContentList
          Text("\n")
      Text("In case I'm being followed, I divert around the perimeter of the compound. It's a much longer path, and it takes me across some terrain that's difficult to negotiate in the dark — muddy, and thick with thistles and nestles.")
      Text("\n")
      VariableAssignment(name="muddyshoes", global=false, temp=false)
        Number(true)
      Text("Still, I can be confident no—one is behind me. I crouch down behind the rear wall of Hut 2. ")
      Glue
      Text("\n")
      Gather(name=null, depth=1)
      Text("The component is still there, wrapped in a tea—towel and shoved into a cavity in a breeze—block at the base of the Hut wall.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Take it")
        ContentList
          Text(" ")
          Text("\n")
      Text("Quickly, I pull it free, and slip it into the pocket of my jacket.")
      Text("\n")
      VariableAssignment(name="gotcomponent", global=false, temp=false)
        Number(true)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Leave it")
        ContentList
          Text(" ")
          Text("\n")
      Text("Still there means no—one has found it, which means it is probably well—hidden. And short of skipping the compound now, I can afford to leave it hidden there a while longer. So I leave it in place.")
      Text("\n")
      Gather(name=null, depth=1)
      Text("Where now?")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Back to the barracks")
        ContentList
          Text(" ")
          Divert(target="-> return_to_room_after_excursion", empty=false, tunnel=false, thread=false)
          Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Go to Hooper's dorm")
        ContentList
          Text(" ")
          Divert(target="-> go_to_hoopers_dorm", empty=false, tunnel=false, thread=false)
          Text("\n")
        VariableReference(gotcomponent)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Escape the compound")
        ContentList
          Text(" ")
          Text("\n")
      Text("Enough of this place. Time for me to get moving. I can get to the train station on foot, catch the postal train to Scotland and be somewhere else before anyone realises that I'm gone.")
      Text("\n")
      Text("Of course, then they'll be looking for me in earnest. ")
      ContentList
        Conditional
          Unary(not, VariableReference(framedhooper))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("As a confirmed traitor.")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("Perhaps not as a traitor — they might take the idea that Hooper was involved with the theft — but certainly as a valuable mind, one containing valuable secrets and all too easily threatened. They will think I am running away because of my indiscretions. I suppose, in fairness, that I am.")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Go")
          ContentList
            Text(" \t\t\t")
            Divert(target="-> live_on_the_run", empty=false, tunnel=false, thread=false)
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Don't go")
          ContentList
            Text(" ")
            Text("\n")
        Text("It's no good. That's only half a solution. I couldn't be happy with that.")
        Text("\n")
        Weave(baseIndent=2)
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("Back to the barracks")
            ContentList
              Text(" \t\t\t")
              Divert(target="-> return_to_room_after_excursion", empty=false, tunnel=false, thread=false)
              Text("\n")
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("To Hooper's dorm")
            ContentList
              Text(" ")
              Divert(target="-> go_to_hoopers_dorm", empty=false, tunnel=false, thread=false)
              Text("\n")
            Binary(&&, VariableReference(gotcomponent), Binary(==, FunctionCall(READ_COUNT, args=1), Number(0)))
  Flow(level=Knot, name="go_to_hoopers_dorm", function=false)
    Weave(baseIndent=0)
      Text("I creep around the outside of the huts towards Hooper's dorm. Time to wrap up this little game once and for all. A few guards patrol the area at night but not many — after all, very few know this place even exists.")
      Text("\n")
      Text("Our quarters are arranged away from the main house; where we sleep is of less importance than where we work. We each have our own hut, through some are less permanent than others. Hooper's is a military issue tent: quite a large canopy, with two rooms inside and a short porch area where he insists people leave their shoes. It's all zipped up for the night and no light shines from inside.")
      Text("\n")
      Text("I hang back for a moment. If Harris is keeping to the terms of our deal then someone will be watching this place. But I can see no—one.")
      Text("\n")
      Choice(name="outer_zip", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Open the outer zip")
        ContentList
          Text(" ")
          Text("\n")
      Text("I creep forward to the tent, intent on lifting the zip to the front porch area just a little — enough to slip the component inside, and without the risk of the noise waking Hooper from his snoring.")
      Text("\n")
      Text("The work is careful, and more than little fiddly — Hooper has tied the zips down on the inside, the fastidious little bastard! — but after a little work I manage to make a hole large enough for my hand.")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Slip in the component")
          ContentList
            Text(" \t\t")
            Text("\n")
        Text("I slide the component into the tent, work the zip closed, and move quickly away into the shadows. It takes a few minutes for my breath to slow, and my heart to stop hammering, but I see no other movement. If anyone is watching Hooper's tent, they are asleep at their posts.")
        Text("\n")
        VariableAssignment(name="putcomponentintent", global=false, temp=false)
          Number(true)
        VariableAssignment(name="gotcomponent", global=false, temp=false)
          Number(false)
        Divert(target="-> return_to_room_after_excursion", empty=false, tunnel=false, thread=false)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("No, some other way")
          ContentList
            Text(" \t\t\t")
            Text("\n")
        Text("Then pause. This is too transparent. Too blatant. If I leave it here, like this, Hooper will never be seen to go looking for it: he will stumble over it in plain sight, and the men watching will wonder why it was not there when he went to bed.")
        Text("\n")
        Text("No, I must try something else — or nothing at all.")
        Text("\n")
        Weave(baseIndent=2)
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("On top of the tent")
            ContentList
              Text(" ")
              Divert(target="-> put_component_on_tent", empty=false, tunnel=false, thread=false)
              Text("\n")
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("Throw the component into the long grass")
            ContentList
              Text(" ")
              Text("\n")
          Text("From inspiration — or desperation, I am not certain — a simple approach occurs to me. ")
          Divert(target="-> toss_component_into_bushes", empty=false, tunnel=false, thread=false)
          Text("\n")
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("Give up")
            ContentList
              Text(" ")
              Text("\n")
          Text("There is nothing to be gained here. I have the component now; maybe it will be of some value tomorrow.")
          Text("\n")
          Weave(baseIndent=3)
            Choice(name=null, once=true, invisible=false, depth=4, inline=true)
              ContentList
                Text("Return to my barrack")
              ContentList
                Text(" ")
                Divert(target="-> return_to_room_after_excursion", empty=false, tunnel=false, thread=false)
                Text("\n")
            Choice(name=null, once=true, invisible=false, depth=4, inline=true)
              ContentList
                Text("Escape the compound")
              ContentList
                Text(" ")
                Divert(target="-> live_on_the_run", empty=false, tunnel=false, thread=false)
                Text("\n")
      Choice(name="wide_circuit", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Look for another opening")
        ContentList
          Text(" ")
          Text("\n")
      Text("Making a wide circuit I creep around the tent. It has plenty of other flaps and openings, tied down with Gordian complexity. But nothing afford itself to slipping the component inside.")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Try the porch zip")
          ContentList
            Text(" \t\t\t")
            Divert(target="-> outer_zip", empty=false, tunnel=false, thread=false)
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Try on top of the tent")
          ContentList
            Text(" \t\t")
            Divert(target="-> put_component_on_tent", empty=false, tunnel=false, thread=false)
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Give up")
          ContentList
            Text(" \t\t\t\t\t\t")
            Text("\n")
        Text("It's no good. Nothing I can do will be any less than obvious — something appearing where something was not there before. The men watching Hooper will know it is a deception and Hooper's protestations will be taken at face value.")
        Text("\n")
        Text("If I can't find a way for Hooper to pick the component up, as if from a hiding place of his own devising, and be caught doing it, then I have no plan at all.")
        Text("\n")
        Weave(baseIndent=2)
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("Return to my barrack")
            ContentList
              Text(" ")
              Divert(target="-> return_to_room_after_excursion", empty=false, tunnel=false, thread=false)
              Text("\n")
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("Escape the compound")
            ContentList
              Text(" ")
              Divert(target="-> live_on_the_run", empty=false, tunnel=false, thread=false)
              Text("\n")
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("Toss the component into the bushes")
            ContentList
              Text(" ")
              Divert(target="-> toss_component_into_bushes", empty=false, tunnel=false, thread=false)
              Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Hide the component somewhere")
        ContentList
          Text(" ")
          Text("\n")
      Text("If I leave the component here somewhere it should be somewhere I can rely on Hooper finding it, but no—one before Hooper. In particular.")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Behind the tent")
          ContentList
            Text("\t\t\t \t")
            Divert(target="-> wide_circuit", empty=false, tunnel=false, thread=false)
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Inside the porch section")
          ContentList
            Text(" \t\t")
            Divert(target="-> outer_zip", empty=false, tunnel=false, thread=false)
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("On top of the canvas")
          ContentList
            Text(" \t\t\t")
            Divert(target="-> put_component_on_tent", empty=false, tunnel=false, thread=false)
            Text("\n")
    Flow(level=Stitch, name="put_component_on_tent", function=false)
      Weave(baseIndent=0)
        Text("A neat idea strikes me. If I could place it on top of the canvas, somewhere in the middle where it would bow the cloth inwards, then it would be invisible to anyone passing by. But to Hooper, it would be above him: a shadow staring him in the face as he awoke. What could be more natural than getting up, coming out, and looking to see what had fallen on him during the night?")
        Text("\n")
        Text("It's the work of a moment. I was once an excellent bowler for the second XI back at school. This time I throw underarm, of course, but I still land the vital missing component exactly where I want it to go.")
        Text("\n")
        VariableAssignment(name="framedhooper", global=false, temp=false)
          Number(true)
        VariableAssignment(name="gotcomponent", global=false, temp=false)
          Number(false)
        Text("For a second I hold my breath, but nothing and no—one stirs. ")
        Divert(target="-> return_to_room_after_excursion", empty=false, tunnel=false, thread=false)
        Text("\n")
    Flow(level=Stitch, name="toss_component_into_bushes", function=false)
      Weave(baseIndent=0)
        Text("I toss the component away into the bushes behind Hooper's tent and return to my barrack, wishing myself a long sleep followed by a morning, free of this business.")
        Text("\n")
        VariableAssignment(name="gotcomponent", global=false, temp=false)
          Number(false)
        VariableAssignment(name="throwncomponentaway", global=false, temp=false)
          Number(true)
        Divert(target="-> return_to_room_after_excursion", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="live_on_the_run", function=false)
    Weave(baseIndent=0)
      Text("Better to live on the run than die on the spit. Creeping around the edge of the compound")
      ContentList
        Conditional
          VariableReference(gotcomponent)
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text(", the Bombe component heavy in my pocket")
      Text(", I make my way to the front gate. As always, it's manned by two guards, but I slip past their box by crawling on my belly.")
      Text("\n")
      Text("And then I'm on the road. Walking, not running. Silent. Free.")
      Text("\n")
      Text("For the moment, at least.")
      Text("\n")
      Divert(target="-> END", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="return_to_room_after_excursion", function=false)
    Weave(baseIndent=0)
      ContentList
        Conditional
          VariableReference(gotcomponent)
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("The weight of the Bombe component safely in my jacket")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("Satisfied")
      Text(", I return the short way up the paths between the huts to the barrack block and the broken window.")
      Text("\n")
      Text("It's a little harder getting back through — the window is higher off the ground than the floor inside — but after a decent bit of jumping and hauling I manage to get my elbows up, and then one leg, and finally I collapse inside, quite winded and out breath.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Wait")
        ContentList
          Text("  \t")
          Divert(target="-> night_passes", empty=false, tunnel=false, thread=false)
          Text("\n")
  Flow(level=Knot, name="night_passes", function=false)
    Weave(baseIndent=0)
      Text("The rest of the night passes slowly. I sleep a little, dozing mostly. Then I'm woken by the rooster in the yard. The door opens, and Harris comes in. He takes one look at the broken window and frowns with puzzlement.")
      Text("\n")
      ContentList
        Conditional
          VariableReference(putcomponentintent)
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text(" ")
              Divert(target="-> put_component_inside_tent", empty=false, tunnel=false, thread=false)
      Text("\n")
      Text("\"What happened there?\"")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Confess")
        ContentList
          Text(" ")
          Text("\n")
      Text("\"I broke it,\" I reply. There doesn't seem any use in trying to lie. \"I thought I could escape. But I couldn't get myself through.\"")
      Text("\n")
      Text("The Commander laughs. ")
      Divert(target="-> glad_youre_here", empty=false, tunnel=false, thread=false)
      Text("\n")
      Choice(name="deny", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Deny")
        ContentList
          Text(" ")
          Text("\n")
      Text("\"I'm not sure. I was asleep: I woke up when someone broke the window. I looked out to see who it was, but they were already gone.\"")
      Text("\n")
      Text("Harris looks at me with puzzlement. \"Someone came by to break the window, and then ran off? That's absurd. That's utterly absurd. Admit it, Manning. You tried to escape and you couldn't get through.\"")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Admit it")
          ContentList
            Text("\n")
        Text("\"All right. ")
        ContentList
          Conditional
            Binary(>, VariableReference(forceful), Number(1))
            ConditionalBranch(true=true, else=false, inline=true)
              Weave(baseIndent=0)
                Text("Damn you.")
        Text(" That's exactly it.\"")
        Text("\n")
        Divert(target="-> glad_youre_here", empty=false, tunnel=false, thread=false)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Deny it")
          ContentList
            Text("\n")
          Unary(not, VariableReference(framedhooper))
        Text("\"If I wanted to escape, I would have made damn sure that I could,\" I tell him sternly.")
        Text("\n")
        Divert(target="-> harris_certain_is_you", empty=false, tunnel=false, thread=false)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Deny it")
          ContentList
            Text(" ")
            Text("\n")
          VariableReference(framedhooper)
        Text("\"I tell you, someone broke it. Someone wanted to threaten me, I think.\"")
        Text("\n")
        Text("Harris shakes his head. \"Well, we can look into that matter later. For now, you probably want to hear the more pressing news. ")
        Divert(target="-> found_missing_component", empty=false, tunnel=false, thread=false)
        Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Show him the component")
        ContentList
          Text(" ")
          Divert(target="-> someone_threw_component", empty=false, tunnel=false, thread=false)
          Text("\n")
        VariableReference(gotcomponent)
    Flow(level=Stitch, name="put_component_inside_tent", function=false)
      Weave(baseIndent=0)
        Text("He takes one look around, and sighs, a deep, wistful sigh.")
        Text("\n")
        Text("\"Things just get worse and worse for you, Manning,\" he remarks. \"You are your own worst enemy.\"")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Agree")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"I've thought so before.\" ")
        ContentList
          Conditional
            VariableReference(admitblackmail)
            ConditionalBranch(true=true, else=false, inline=true)
              Weave(baseIndent=0)
                Text("Certainly in the matter of getting blackmailed.")
        Text("\n")
        Text("\"Let me tell you what happened this morning. ")
        Glue
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Disagree")
          ContentList
            Text("\n")
        Text("\"Right now, I think you take that role, Harris,\" I reply coolly.")
        Text("\n")
        Weave(baseIndent=1)
          Gather(name="droll", depth=2)
          Text("\"Very droll,\" he replies. \"Let me tell you what happened this morning. It will take the smile off your face. ")
          Glue
          Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Evade")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"I'm looking forward to having a wash and a change of clothes; which should make me a little less evil to be around.\"")
        Text("\n")
        Divert(target="-> droll", empty=false, tunnel=false, thread=false)
        Gather(name=null, depth=1)
        Text("Our men watching Hooper's tent saw Hooper wake up, get dressed, clamber out of his tent and then step on something in at the entrance of his tent.\"")
        Text("\n")
        VariableAssignment(name="piecereturned", global=false, temp=false)
          Number(true)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Be interested")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"You mean he didn't even hide it? He put it in his shoe?\"")
        Text("\n")
        Weave(baseIndent=1)
          Gather(name="not_that", depth=2)
          Text("\"No,\" Harris replies. \"That isn't really what I mean. ")
          Glue
          Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Be dismissive")
          ContentList
            Text("\n")
        Text("\"So he's an idiot, and he hid it in his shoe.\"")
        Text("\n")
        Divert(target="-> not_that", empty=false, tunnel=false, thread=false)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Say nothing")
          ContentList
            Text(" ")
            Text("\n")
        Text("I say quiet, listening, not sure how this will go.")
        Text("\n")
        Text("\"In case I'm not making myself clear,\" Harris continues, \"")
        Glue
        Text("\n")
        Gather(name=null, depth=1)
        Text("I mean, he managed to find it, by accident, somewhere where it wasn't the night before. And at the same time, you're sitting here with your window broken. So, I rather think you've played your last hand and lost. It's utterly implausible that Hooper stole that component and then left it lying around in the doorway of his tent. So I came to tell you that the game is up, for you.\"")
        Text("\n")
        Text("He nods and gets to his feet. ")
        Divert(target="-> left_alone", empty=false, tunnel=false, thread=false)
        Text("\n")
    Flow(level=Stitch, name="someone_threw_component", function=false)
      Weave(baseIndent=0)
        Text("\"Someone threw this in through the window over night,\" I reply, and open my jacket to reveal the component from the Bombe. \"I couldn't see who, it was too dark. But I know what it is.\"")
        Text("\n")
        Text("He reaches out and takes it. \"Well, I'll be damned,\" he murmurs. \"That's it all right. And you didn't have it on you when we put you in here. But it can't have been Hooper — I had men watching him all night. And there's no—one else it could have been.\"")
        Text("\n")
        Text("He turns the component over in his hands, bemused.")
        Text("\n")
        VariableAssignment(name="piecereturned", global=false, temp=false)
          Number(true)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Suggest something")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"Perhaps Hooper had an accomplice. Someone else who works on site.\"")
        Text("\n")
        Text("Harris shakes his head, distractedly. \"That doesn't make sense,\" he says. \"Why go to all the trouble of stealing it only to give it back? And why like this?\"")
        Text("\n")
        Weave(baseIndent=1)
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("Suggest something")
            ContentList
              Text(" ")
              Text("\n")
          Text("\"Perhaps the accomplice thought it was Hooper being kept in here. Maybe they saw the guard...\"")
          Text("\n")
          Divert(target="-> all_too_farfetched", empty=false, tunnel=false, thread=false)
          Choice(name=null, once=true, invisible=false, depth=2, inline=true)
            ContentList
              Text("Suggest nothing")
            ContentList
              Text(" ")
              Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Suggest nothing")
          ContentList
            Text(" ")
            Text("\n")
        Gather(name=null, depth=1)
        Text("I shrug, eloquently.")
        Text("\n")
        Gather(name=null, depth=1)
        Divert(target="-> all_too_farfetched", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="glad_youre_here", function=false)
      Weave(baseIndent=0)
        Text("\"Shame,\" he remarks. \"I should have left that window open and put a guard on you. Might have been interesting to see where you went. Anyway, I'm glad you're still here, even if you do smell like a dog.\"")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Be optimistic")
          ContentList
            Text(" ")
            Text("\n")
          Unary(not, VariableReference(framedhooper))
        Divert(target="-> night_falls.morning_not_saved.optimism", empty=false, tunnel=false, thread=false)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Be pessimistic")
          ContentList
            Text(" ")
            Text("\n")
          Unary(not, VariableReference(framedhooper))
        Divert(target="-> night_falls.morning_not_saved.pessimism", empty=false, tunnel=false, thread=false)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Be optimistic")
          ContentList
            Text(" ")
            Text("\n")
          VariableReference(framedhooper)
        Text("\"I'm looking forward to having a bath.\"")
        Text("\n")
        Text("\"Well, you should enjoy it. ")
        Glue
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Be pessimistic")
          ContentList
            Text("\n")
          VariableReference(framedhooper)
        Text("\"I imagine I'll smell worse after another couple of days of this.\"")
        Text("\n")
        Text("\"That won't be necessary. ")
        Glue
        Text("\n")
        Gather(name=null, depth=1)
        Divert(target="-> found_missing_component", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="found_missing_component", function=false)
      Weave(baseIndent=0)
        Text("We found the missing component. Or rather, Hooper found it for us. He snuck out and retrieved it from on top. Of all the damnest places — you would never have known it was there. He claimed ignorance when we jumped him, of course. But it's good enough for me.\"")
        Text("\n")
        Choice(name="devil", once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Approve")
          ContentList
            Text("\n")
        Text("\"I can't tell you enough, I'm glad to hear it. I've had a devil of a night.\"")
        Text("\n")
        Text("His gaze flicks to the broken window, but only for a moment. I think he genuinely cannot believe I could have done it.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Disapprove")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"You should never have hired him. A below-average intelligence can't be expected to cope with the pressure of our work.\"")
        Text("\n")
        Gather(name=null, depth=1)
        Text("Harris rolls his eyes, but he might almost be smiling. \"You'd better get along, ")
        ContentList
          Conditional
            VariableReference(devil)
            ConditionalBranch(true=true, else=false, inline=true)
              Weave(baseIndent=0)
                Text("and work through your devils")
            ConditionalBranch(true=false, else=true, inline=true)
              Weave(baseIndent=0)
                Text("Mr Intelligent")
        Text(". There's a 24—hour—late message to be tackled and we're a genius short. So you'd better be ready to work twice as hard.\"")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Thank him")
          ContentList
            Text(" \t")
            Text("\n")
        Text("\"I'll enjoy it. Thank you for helping me clear this up.\"")
        Text("\n")
        Text("\"Don't thank me yet. There's still a war to fight. Now get a move on.\"")
        Text("\n")
        Text("I nod, and hurry out of the door. The air outside has never tasted fresher and more invigorating. ")
        Glue
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Argue with him")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"I'll work as hard as I work.\"")
        Text("\n")
        Text("\"Get out,\" Harris growls. \"Before I decide to arrest you as an accessory.\"")
        Text("\n")
        Text("I do as he says. Outside the barrack, the air has never smelt sweeter.")
        Text("\n")
        Gather(name=null, depth=1)
        Divert(target="-> head_for_my_dorm_free", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="night_falls", function=false)
    Weave(baseIndent=0)
      Text("Night falls. The clockwork of the heavens keeps turning, whatever state I might be in. No—one can steal the components that make the sun go down and the stars come out. I watch it performing its operations. I can't sleep.")
      Text("\n")
      ContentList
        Conditional
          Binary(>, VariableReference(hooperClueType), VariableReference(NONE))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("Has Hooper taken my bait?")
              Text("\n")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Look of out the window")
        ContentList
          Text(" ")
          Text("\n")
      Text("I peer out of the window, but it looks out onto the little brook at the back of the compound, with no view of the other huts or the House. Who knows if there are men up, searching the base of Hut 2, following one another with flashlights...")
      Text("\n")
      ContentList
        Conditional
          VariableReference(inside_hoopers_hut.back_of_hut_2)
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("Perhaps Hooper is there, in the dark, trying to help me after all?")
              Text("\n")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Listen at the door")
        ContentList
          Text(" \t")
          Text("\n")
      Text("I put my ear to the keyhole but can make out nothing. Are there still guards posted? ")
      ContentList
        Conditional
          Binary(>, VariableReference(hooperClueType), VariableReference(NONE))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("Perhaps, if Hooper has managed to incriminate himself, the guards have been removed?")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("Perhaps the component has been found and the crisis is over.")
      Text("\n")
      Text("Perhaps the door is unlocked and they left me to sleep?")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Try it")
          ContentList
            Text(" I try the handle. No such luck.")
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Leave it")
          ContentList
            Text(" I don't touch it. I don't want anyone outside thinking I'm trying to escape.")
            Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Wait")
        ContentList
          Text(" \t\t\t\t\t")
          Text("\n")
      Text("There is nothing I can do to speed up time.")
      Text("\n")
      Gather(name=null, depth=1)
      Text("The night moves at its own pace. I suppose by morning I will know my fate.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Wait")
        ContentList
          Text(" ")
          Text("\n")
        Binary(>, VariableReference(hooperClueType), VariableReference(NONE))
      Text("Morning comes. I'm woken by a rooster calling from the yard behind the House. I must have slept after all. I pull myself up from the bunk, shivering slightly. There is condensation on the inside of the window. I have probably given myself a chill.")
      Text("\n")
      Text("Without knocking, Harris comes inside. \"You're up,\" he remarks, and then, \"You smell like an animal.\"")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Be friendly")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"I suppose I do rather.\" I laugh, but Harris does not.")
        Text("\n")
        Text("\"This damn business gets worse and worse,\" he says, talking as he goes over to unlock and throw open the window. ")
        Glue
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Be cold")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"So would you,\" I reply tartly. Harris shrugs.")
        Text("\n")
        Text("\"I've been through worse than this,\" he replies matter—of—factly. \"It's hardly my fault if you sleep in your clothes.\"")
        Text("\n")
        Text("I glare back. He goes over to the window, unlocks it and throws it open, relishing the fresh air from outside.")
        Text("\n")
        Gather(name=null, depth=2)
        Text("\"Hooper's confessed, you know.\"")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Be eager")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"He has? I knew he would. The worm.\"")
        Text("\n")
        Text("\"Steady now. Matters aren't over yet. ")
        Glue
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Be cautious")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"Oh, yes?\"")
        Text("\n")
        Text("\"Yes. For what that's worth. ")
        Glue
        Text("\n")
        Gather(name="hooper_didnt_give_himself_up", depth=2)
        Text("There's still the issue of the component. It hasn't turned up. He didn't lead us to it. I guess he figured you must have had something on him. I don't know.\"")
        Text("\n")
        Text("He looks quite put out by the whole affair. He is not the kind of man to deal well with probabilities.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Be interested")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"You mean he confessed of his own accord? You didn't catch him?\"")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Be disinterested")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"Well, I'm glad his conscience finally caught up with him,\" I reply dismissively.")
        Text("\n")
        Gather(name=null, depth=2)
        Text("\"The Captain went back into that hut and he confessed immediately. We were so surprised we didn't let you go.\" He wrinkles his nose. \"I'm rather sorry about that now. I suggest you have a wash.\"")
        Text("\n")
        Text("And with that he gestures to the doorway.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Go")
          ContentList
            Text(" ")
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Wait")
          ContentList
            Text(" ")
            Text("\n")
        Text("I hang back a moment. Something does not seem quite right. After all, Hooper did not steal the component. He has no reason to confess to anything. Perhaps this is another trap?")
        Text("\n")
        Text("\"Well?\" Harris asks. \"What are you waiting for? Please don't tell me <i>you</i> want to confess now as well, I don't think my head could stand it.\"")
        Text("\n")
        Weave(baseIndent=2)
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("Confess")
            ContentList
              Text(" ")
              Text("\n")
          Text("After a chance like this? A chance — however real — to save my neck? To hand it over — what, to save Hooper's worthless skin?")
          Text("\n")
          Weave(baseIndent=3)
            Choice(name=null, once=true, invisible=false, depth=4, inline=true)
              ContentList
                Text("Confess")
              ContentList
                Text(" ")
                Text("\n")
            Text("I see. Perhaps you think I bullied the man into giving himself up. Perhaps he understood my little clue far enough to know it was a threat against him, but not well enough to understand where he should look to find it. So he took the easy route out and folded. Gave me the hand.")
            Text("\n")
            VariableAssignment(name="hooperConfessed", global=false, temp=false)
              Number(true)
            Text("Hardly sporting, of course.")
            Text("\n")
            Weave(baseIndent=4)
              Choice(name=null, once=true, invisible=false, depth=5, inline=true)
                ContentList
                  Text("Confess")
                ContentList
                  Text("\n")
              Text("Well, then. I suppose this must be what it feels like to have a conscience. I suppose I had always wondered.")
              Text("\n")
              Text("\"Harris, sir. I don't know what Hooper's playing at, sir. But I can't let him do this.\"")
              Text("\n")
              Text("\"Do what?\"")
              Text("\n")
              Text("\"Take the rope for this. I took it, sir.")
              Text("\n")
              VariableAssignment(name="revealedhooperasculprit", global=false, temp=false)
                Number(false)
              VariableAssignment(name="losttemper", global=false, temp=false)
                Number(false)
              Divert(target="-> reveal_location_of_component", empty=false, tunnel=false, thread=false)
              Choice(name=null, once=true, invisible=false, depth=5, inline=true)
                ContentList
                  Text("Don't confess")
                ContentList
                  Text(" ")
                  Text("\n")
            Choice(name=null, once=true, invisible=false, depth=4, inline=true)
              ContentList
                Text("Don't confess")
              ContentList
                Text(" ")
                Text("\n")
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("Don't confess")
            ContentList
              Text(" ")
              Text("\n")
          Gather(name=null, depth=3)
          Text("\"I certainly don't. But still, I'm surprised. I had Hooper down for a full—blown double agent, a traitor. He knows he'll face the rope, doesn't he?\"")
          Text("\n")
          Text("\"Don't ask me to explain why he did what he did,\" Harris sighs. \"Just be grateful that he did, and you're now off the hook.\"")
          Text("\n")
        Gather(name=null, depth=2)
        Text("Curiouser and curiouser. I nod once to Harris and slip outside into the cold morning air.")
        Text("\n")
        ContentList
          Conditional
            Binary(==, VariableReference(hooperClueType), VariableReference(NONE))
            ConditionalBranch(true=true, else=false, inline=false)
              Weave(baseIndent=0)
                Text("Hooper's confession only makes sense in one fashion")
                ContentList
                  Conditional
                    VariableReference(hooperConfessed)
                    ConditionalBranch(true=true, else=false, inline=true)
                      Weave(baseIndent=0)
                        Text(", and that is his being dim—witted and slow")
                    ConditionalBranch(true=false, else=true, inline=true)
                      Weave(baseIndent=0)
                        Text(" — if I successfully implied to him that I had him framed, but he did not unpack my little clue well enough to go looking for the component. Well, I had figured him for a more intelligent opponent, but a resignation from the game will suffice")
                Text(". Or perhaps he knew he would be followed if he went to check, and decided he would be doomed either way.")
                Text("\n")
            ConditionalBranch(true=false, else=true, inline=false)
              Weave(baseIndent=0)
                Text("Hooper's confession only makes sense in one way — and that's that he believed me. He reasoned that he would be followed. To try and uncover the component would have got him arrested, and to confess was the same.")
                Text("\n")
                Text("He simply caved, and threw in his hand.")
                Text("\n")
        Text("\n")
        Text("Of course, however, there is only one way to be certain that Harris is telling the truth, and that is to check the breeze—block at the back of Hut 2.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Check")
          ContentList
            Text(" ")
            Divert(target="-> go_to_where_component_is_hidden", empty=false, tunnel=false, thread=false)
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Don't check")
          ContentList
            Text("\n")
        Text("But there will time for that later. If there is nothing there, then Hooper discovered the component after all and Harris' men will have swooped on him, and the story about his confession is just a ruse to test me out.")
        Text("\n")
        Text("And if the component is still there — well. It will be just as valuable to my contact in a week's time, and his deadline of the 31st is not yet upon us.")
        Text("\n")
        Divert(target="-> head_for_my_dorm_free", empty=false, tunnel=false, thread=false)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Wait")
        ContentList
          Text(" ")
          Divert(target="-> morning_not_saved", empty=false, tunnel=false, thread=false)
          Text("\n")
        Binary(==, VariableReference(hooperClueType), VariableReference(NONE))
    Flow(level=Stitch, name="morning_not_saved", function=false)
      Weave(baseIndent=0)
        Text("Morning comes with the call of a rooster from the yard of the House. I must have slept after all. I pull myself up off the bunk, shivering slightly. There is condensation on the inside of the window. I have probably given myself a chill.")
        Text("\n")
        Text("It's not long after that Harris enters the hut. He closes the door behind him, careful as ever, then takes a chair across from me.")
        Text("\n")
        Text("\"You smell like a dog,\" he remarks.")
        Text("\n")
        Choice(name="optimism", once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Be optimistic")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"I'm looking forward to a long bath,\" I reply. \"And getting back to work.\"")
        Text("\n")
        Choice(name="pessimism", once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Be pessimistic")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"So would you after the night I've had.\"")
        Text("\n")
        Gather(name=null, depth=1)
        Divert(target="-> harris_certain_is_you", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="harris_certain_is_you", function=false)
    Weave(baseIndent=0)
      Text("\"Well, I'm afraid it is going to get worse for you,\" Harris replies soberly. \"We followed Hooper, and he took himself neatly to bed and slept like a boy scout. Which puts us back to square one, and you firmly in the frame. And I'm afraid I don't have time for any more games. I want you to tell me where that component is, or we will hang you as a traitor.\"")
      Text("\n")
      VariableAssignment(name="revealedhooperasculprit", global=false, temp=false)
        Number(false)
      VariableAssignment(name="losttemper", global=false, temp=false)
        Number(false)
      Divert(target="-> harris_threatens_lynching", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="head_for_my_dorm_free", function=false)
    Weave(baseIndent=0)
      Text("I head for my dorm, intent on a bath, breakfast, a glance at the crossword before the other men get to it, and then on with work. They should have replaced the component in the Bombe by now. We will only be a day behind.")
      Text("\n")
      ContentList
        Conditional
          Unary(not, VariableReference(framedhooper))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("And then everything will proceed as before. The component will mean nothing to the Germans — this is the one fact I could never have explained to a man like Harris, even though the principle behind the Bombe is the same as the principle behind the army. The individual pieces — the men, the components — do not matter. They are identical. It is how they are arranged that counts.")
              Text("\n")
      Text("\n")
      Text("I bump into Russell in the dorm hut.")
      Text("\n")
      Text("\"Did you hear?\" he whispers. \"Terrible news about Hooper. Absolutely terrible.\"")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Yes")
        ContentList
          Text(" ")
          Text("\n")
      Text("\"Quite terrible. I would never have guessed.\"")
      Text("\n")
      Text("\"Well.\" Russell harrumphs.")
      Text("\n")
      Weave(baseIndent=1)
        Gather(name="quince", depth=2)
        Text("\"Quince was saying this morning, apparently his grandfather was German. So perhaps it's to be expected. See you there?\"")
        Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("No")
        ContentList
          Text("\n")
      Text("\"Heard what?\"")
      Text("\n")
      Weave(baseIndent=1)
        Gather(name="hooper_taken", depth=2)
        Text("\"Hooper's been taken away. They caught him, uncovering that missing Bombe component from a hiding place somewhere, apparently about to take it to his contact.\" Russell harrumphs. ")
        Divert(target="-> quince", empty=false, tunnel=false, thread=false)
        Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Lie")
        ContentList
          Text(" ")
          Text("\n")
      Text("\"I don't know what you're talking about.\"")
      Text("\n")
      Divert(target="-> hooper_taken", empty=false, tunnel=false, thread=false)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Evade")
        ContentList
          Text("\n")
      Text("\"If you'll excuse me, Russell. I was about to take a bath.\"")
      Text("\n")
      Text("\"Oh, of course. Worked all night, did you? Well, you'll hear soon enough. Can hardly hide the fact there'll only be three of us from now on.\"")
      Text("\n")
      Gather(name=null, depth=1)
      Text("I wave to him and move away, my thoughts turning to the young man in the village. My lover. My contact. My blackmailer. Hooper may have taken the fall for the missing component, but ")
      ContentList
        Conditional
          Unary(not, VariableReference(framedhooper))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("if he did recover it from Hut 2 then ")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text(" its recovery does mean ")
      Text("I have nothing to sell to save my reputation")
      ContentList
        Conditional
          VariableReference(i_met_a_young_man)
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text(", if I have any left")
      Text(".")
      Text("\n")
      ContentList
        Conditional
          Unary(not, VariableReference(framedhooper))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("If he didn't, of course, and Harris was telling the truth about his sudden confession, then I will be able to buy my freedom once and for all.")
              Text("\n")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Get the component")
        ContentList
          Text(" ")
          Divert(target="-> go_to_where_component_is_hidden", empty=false, tunnel=false, thread=false)
          Text("\n")
        Unary(not, VariableReference(framedhooper))
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Leave it")
        ContentList
          Text(" ")
          Text("\n")
        Unary(not, VariableReference(framedhooper))
      Text("I will have to leave that question for another day. To return there now, when they're probably watching my every step, would be suicide. After all, if Hooper ")
      ContentList
        Conditional
          Binary(==, VariableReference(hooperClueType), VariableReference(STRAIGHT))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("followed")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("understood")
      Text(" my clue, he will have explained it to them to save his neck. They won't believe him — but they won't quite disbelieve him either. We're locked in a cycle now, him and me, of half—truth and probability. There's nothing either of us can do to put the other entirely into blame.")
      Text("\n")
      Divert(target="-> ending_return_to_normal", empty=false, tunnel=false, thread=false)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Act normal")
        ContentList
          Text(" ")
          Text("\n")
      Text("But there is nothing to be done about it. ")
      Divert(target="-> ending_return_to_normal", empty=false, tunnel=false, thread=false)
      Text("\n")
  Flow(level=Knot, name="ending_return_to_normal", function=false)
    Weave(baseIndent=0)
      Text("Nothing, that is, except to act as if there is no game being played. I'll have a bath, then start work as normal. I've got a week to find something to give my blackmailer")
      ContentList
        Conditional
          VariableReference(i_met_a_young_man)
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text(" — or give him nothing: it seems my superiors know about my indiscretions now already")
      Text(".")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Co-operate")
        ContentList
          Text(" ")
          Text("\n")
      Text("Something will turn up. It always does. An opportunity will present itself, and more easily now that Hooper is out of the way.")
      Text("\n")
      Text("But for now, there's yesterday's intercept to be resolved.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Dissemble")
        ContentList
          Text(" ")
          Text("\n")
      Text("Or perhaps I might hand my young blackmailer over my superiors instead for being the spy he is.")
      Text("\n")
      Text("Perhaps that would be the moral thing to do, even, and not just the most smart.")
      Text("\n")
      Text("But not today. Today, there's an intercept to resolve.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Lie")
        ContentList
          Text("\n")
      Text("In a week's time, this whole affair will be in the past and quite forgotten. I'm quite sure of that. ")
      Divert(target="-> moreimportant", empty=false, tunnel=false, thread=false)
      Text("\n")
      Choice(name="moreimportant", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Evade")
        ContentList
          Text(" I've more important problems to think about now. There's still yesterday's intercept to be resolved. ")
          Text("\n")
      Gather(name=null, depth=1)
      Text("The Bombe needs to be set up once more and set running.")
      Text("\n")
      Text("It's time I tackled a problem I can solve.")
      Text("\n")
      Divert(target="-> END", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="go_to_where_component_is_hidden", function=false)
    Weave(baseIndent=0)
      Text("It won't take a moment to settle the matter. I can justify a walk past Hut 2 as part of my morning stroll. It will be obvious in a moment if the component is still there.")
      Text("\n")
      Text("On my way across the paddocks, between the huts and the House, I catch sight of young Miss Lyon, arriving for work on her bicycle. She giggles as she sees me and waves.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Wave back")
        ContentList
          Text(" ")
          Text("\n")
      Text("I wave cheerily back and she giggles, almost drops her bicycle, then dashes away inside the House. Judging by the clock on the front gable, she's running a little late this morning.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Ignore her")
        ContentList
          Text(" ")
          Text("\n")
      Text("I give no reaction. She sighs to herself, as if this kind of behaviour is normal, and trots away inside the House to begin her duties.")
      Text("\n")
      Gather(name=null, depth=1)
      Text("I turn the corner of Hut 3 and walk down the short gravel path to Hut 2. It was a good spot to choose — Hut 2 is where the electricians work, and they're generally focussed on what they're doing. They don't often come outside to smoke a cigarette so it's easy to slip past the doorway unnoticed.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Check inside")
        ContentList
          Text(" \t\t")
          Text("\n")
      Text("I hop up the steps and put my head inside all the same. Nobody about. Still too early in the AM for sparks, I suppose. ")
      Glue
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Go around the back")
        ContentList
          Text(" ")
          Text("\n")
      Gather(name=null, depth=1)
      Text("I head on around the back of the hut. The breeze—block with the cavity is on the left side.")
      Text("\n")
      Choice(name="check", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Check")
        ContentList
          Text(" \t\t")
          Text("\n")
      Text("No time to waste. I drop to my knees and check the breeze—block. Sure enough, there's nothing there. <i>Hooper took the bait.</i>")
      Text("\n")
      Text("Suddenly, there's a movement behind me. I look up to see, first a snub pistol, and then, Harris.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Look around")
        ContentList
          Text(" ")
          Text("\n")
      Text("I pause to glance around, and catch a glimpse of movement. Someone ducking around the corner of the hut. Or a canvas sheet flapping in the light breeze. Impossible to be sure.")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Check the breeze—block")
          ContentList
            Text(" ")
            Divert(target="-> check", empty=false, tunnel=false, thread=false)
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Check around the side of the hut")
          ContentList
            Text(" ")
            Text("\n")
        Text("But too important to guess. I move back around the side of the hut.")
        Text("\n")
        Text("Harris is there, leaning in against the wall. He holds a stub pistol in his hand.")
        Text("\n")
      Gather(name=null, depth=1)
      ContentList
        Conditional
          Binary(>, VariableReference(hooperClueType), VariableReference(STRAIGHT))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("\"")
              ContentList
                Conditional
                  Binary(==, VariableReference(hooperClueType), VariableReference(CHESS))
                  ConditionalBranch(true=true, else=false, inline=true)
                    Weave(baseIndent=0)
                      Text("Queen to rook two")
                  ConditionalBranch(true=false, else=true, inline=true)
                    Weave(baseIndent=0)
                      Text("Messy without one missing whatever it was")
              Text(",\" he declares. \"I wouldn't have fathomed it but Hooper did. Explained it right after we sprung him doing what you're doing now. We weren't sure what to believe but now, you seem to have resolved that for us.\"")
              Text("\n")
          ConditionalBranch(true=false, else=true, inline=false)
            Weave(baseIndent=0)
              Text("\"Hooper said you'd told him where to look. I didn't believe him. Or, well. I wasn't sure what to believe. Now I rather think you've settled it.\"")
              Text("\n")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Agree")
        ContentList
          Text(" ")
          Text("\n")
      Text("\"I have, rather.\" I put my hands into my pockets. \"I seem to have done exactly that.\"")
      Text("\n")
      Text("\"I'm afraid my little story about Hooper confessing wasn't true. I wanted to see if you'd go to retrieve the part.\" Harris gestures me to start walking. \"You were close, Manning, I'll give you that. I wanted to believe you. But I'm glad I didn't.\"")
      Text("\n")
      Divert(target="-> done", empty=false, tunnel=false, thread=false)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Lie")
        ContentList
          Text(" ")
          Text("\n")
      Text("\"I spoke to Russell. He said he saw Hooper doing something round here. I wanted to see what it was.\"")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Evade")
        ContentList
          Text(" ")
          Text("\n")
      Text("\"Harris, you'd better watch out. He's planted a time—bomb here.\"")
      Text("\n")
      Text("Harris stares at me for a moment, then laughs. \"Oh, goodness. That's rich.\"")
      Text("\n")
      Text("I almost wish I had a way to make the hut explode, but of course I don't.")
      Text("\n")
      Gather(name=null, depth=1)
      Text("\"Enough.\" Harris gestures for me to start walking. \"This story couldn't be simpler. You took it to cover your back. You hid it. You lied to get Hooper into trouble, and when you thought you'd won, you came to scoop your prize. A good hand but ultimately, ")
      ContentList
        Conditional
          Binary(<=, VariableReference(hooperClueType), VariableReference(STRAIGHT))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("if it hadn't have been you who hid the component, then you wouldn't be here now")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("you told Hooper where to look with your little riddle")
      Text(".\"")
      Text("\n")
      Gather(name="done", depth=1)
      Text("He leads me across the yard. Back towards Hut 5 to be decoded, and taken to pieces, once again.")
      Text("\n")
      Divert(target="-> END", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="harris_threatens_lynching", function=false)
    Weave(baseIndent=0)
      ContentList
        Conditional
          VariableReference(harris_certain_is_you)
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("He passes a hand across his eyes with a long look of despair.")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("He gets to his feet, and gathers his gloves from the table top.")
      Text("\n")
      Text("\"I'm going to go outside and organise a rope. That'll take about twelve minutes. That's how long you have to decide.\"")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Protest")
        ContentList
          Text(" ")
          Text("\n")
      Text("\"You can't do this!\" I cry. \"It's murder! I demand a trial, a lawyer; for God's sake, man, you can't just throw me overboard, we're not barbarians...!\"")
      Text("\n")
      Weave(baseIndent=1)
        Gather(name="too_clever", depth=2)
        Text("\"You leave me no choice,\" Harris snaps back, eyes cold as gun—metal. \"You and your damn cyphers. Your damn clever problems. If men like you didn't exist, if we could just all be <i>straight</i> with one another.\" He gets to his feet and heads for the door. \"I fear for the future of this world, with men like you in. Reich or no Reich, Mr Manning, people like you simply <i>complicate</i> matters.\"")
        Text("\n")
        Divert(target="-> left_alone", empty=false, tunnel=false, thread=false)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Confess")
        ContentList
          Text(" ")
          Text("\n")
        Binary(&&, Unary(not, VariableReference(gotcomponent)), Unary(not, VariableReference(throwncomponentaway)))
      Text("I nod. \"I don't need twelve minutes. ")
      Divert(target="-> reveal_location_of_component", empty=false, tunnel=false, thread=false)
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Stay silent")
        ContentList
          Text(" ")
          Divert(target="-> my_lips_are_sealed", empty=false, tunnel=false, thread=false)
          Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Show him the component")
        ContentList
          Text(" ")
          Text("\n")
        VariableReference(gotcomponent)
      Text("\"I don't need twelve minutes. Here it is.\"")
      Text("\n")
      Text("I open my jacket and pull the Bombe component out of my pocket. Harris takes it from me, whistling, curious.")
      Text("\n")
      Text("\"Well, I'll be. That's it all right.\"")
      Text("\n")
      Text("\"That's it.\"")
      Text("\n")
      Text("\"But you didn't have it on you yesterday.\"")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Explain")
          ContentList
            Text(" ")
            Text("\n")
        Text("\"I climbed out of the window overnight,\" I explain. \"I went and got this from where it was hidden, and brought it back here.\"")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Don't explain")
          ContentList
            Text("\n")
        Text("\"No. I didn't.\"")
        Text("\n")
      Gather(name=null, depth=1)
      Divert(target="-> all_too_farfetched", empty=false, tunnel=false, thread=false)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Confess")
        ContentList
          Text("\n")
        VariableReference(throwncomponentaway)
      Text("\"I don't need twelve minutes. The component is in the long grass behind Hooper's tent. I threw it there hoping to somehow frame him, but now I see that won't be possible. I was naive, I suppose.\"")
      Text("\n")
      VariableAssignment(name="piecereturned", global=false, temp=false)
        Number(true)
      Divert(target="-> reveal_location_of_component.harris_believes", empty=false, tunnel=false, thread=false)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Frame Hooper")
        ContentList
          Text(" ")
          Text("\n")
        VariableReference(throwncomponentaway)
      Text("\"Look, I know where it is. The missing piece of the Bombe is in the long grasses behind Hooper's tent. I saw him throw it there right after we finished work. He knew you'd scour the camp but I suppose he thought you'd more obvious places first. I suppose he was right about that. Look there. That <i>proves</i> his guilt.\"")
      Text("\n")
      VariableAssignment(name="longgrasshooperframe", global=false, temp=false)
        Number(true)
      VariableAssignment(name="piecereturned", global=false, temp=false)
        Number(true)
      Text("\"That doesn't prove anything,\" Harris returns sharply. \"But we'll check what you say, all the same.\" He gets to his feet and heads out of the door.")
      Text("\n")
      Divert(target="-> left_alone", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="reveal_location_of_component", function=false)
    Weave(baseIndent=0)
      Glue
      Text(" The missing component of the Bombe computer is hidden in a small cavity in a breeze—block supporting the left rear post of Hut 2. I put in there anticipating a search. I intended to ")
      ContentList
        Conditional
          VariableReference(revealedhooperasculprit)
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("pass it to Hooper")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("dispose of it")
      Text(" once the fuss had died down. I suppose I was foolish to think that it might.\"")
      Text("\n")
      VariableAssignment(name="piecereturned", global=false, temp=false)
        Number(true)
      Divert(target="-> harris_believes", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="harris_believes", function=false)
      Weave(baseIndent=0)
        ContentList
          Conditional
            Unary(not, VariableReference(night_falls.hooper_didnt_give_himself_up))
            ConditionalBranch(true=true, else=false, inline=false)
              Weave(baseIndent=0)
                Text("\"Indeed. And Mr Manning: God help you if you're lying to me.\"")
                Text("\n")
            ConditionalBranch(true=false, else=true, inline=false)
              Weave(baseIndent=0)
                Text("\"I thought as much. I hadn't expected you to give it out so easily, however. You understand, Hooper has said nothing, of course. In fact, he went to Hut 2 directly after we released him and uncovered the component. But he told us you had instructed him where to go. Hence my little double bluff. Frankly, I'll be glad when I'm shot of the lot of you mathematicians.\"")
                Text("\n")
        Text("\n")
        Text("Harris stands, and slips away smartly. ")
        Divert(target="-> left_alone", empty=false, tunnel=false, thread=false)
        Text("\n")
  Flow(level=Knot, name="my_lips_are_sealed", function=false)
    Weave(baseIndent=0)
      Text("I say nothing, my lips tightly, firmly sealed. It's true I am a traitor, to the very laws of nature. The world has taught me that since a very early age. But not to my country — should the Reich win this war, I would hardly be treated as an honoured hero. I was doomed from the very start.")
      Text("\n")
      VariableAssignment(name="notraitor", global=false, temp=false)
        Number(true)
      Text("I explain none of this. How could a man like Harris understand?")
      Text("\n")
      Text("The Commander takes one look back from the doorway as he pulls it to.")
      Text("\n")
      Text("\"It's been a pleasure working with you, Mr Manning,\" he declares. \"You've done a great service to this country. If we come through, I'm sure they'll remember you name. I'm sorry it had to end this way and I'll do my best to keep it quiet. No—one need know what you did.\"")
      Text("\n")
      Divert(target="-> left_alone", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="all_too_farfetched", function=false)
    Weave(baseIndent=0)
      Text("\"This is all too far—fetched,\" Harris says. \"I'm glad to have this back, but I need to think.\"")
      Text("\n")
      Text("Getting to his feet, he nods once. \"You'll have to wait a little longer, I'm afraid, Manning.\"")
      Text("\n")
      Text("Then he steps out of the door, muttering to himself.")
      Text("\n")
      Divert(target="-> make_your_peace", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="left_alone", function=false)
    Weave(baseIndent=0)
      ContentList
        Conditional
          VariableReference(slam_door_shut_and_gone.time_to_move_now)
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("The Commander holds the door for his superior, and follows him out.")
      Text(" Then the door closes. I am alone again, as I have been for most of my short life.")
      Text("\n")
      Divert(target="-> make_your_peace", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="make_your_peace", function=false)
    Weave(baseIndent=0)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Make your peace")
        ContentList
          Text("\n")
      Gather(name=null, depth=1)
      Text("I am waiting again. I have no God to make my peace with. I find it difficult to believe in goodness of any kind, in a world such as this.")
      Text("\n")
      ContentList
        Conditional
          Unary(not, VariableReference(notraitor))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              VariableAssignment(name="notraitor", global=false, temp=false)
                Number(true)
              Text("But I am no traitor. Not to my country. To my sex, perhaps. But how could I support the Reich? If the Nazis were to come to power, I would be worse off than ever.")
              Text("\n")
      Text("\n")
      ContentList
        Conditional
          VariableReference(harris_threatens_lynching.too_clever)
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("In truth, it is men like Harris who are complex, not men like me. I live to make things ordered, systematic. I like my pencils sharpened and lined up in a row. I do not deal in difficult borders, or uncertainties, or alliances. If I could, I would reduce the world to something easier to understand, something finite.")
              Text("\n")
              Text("But I cannot, not even here, in our little haven from the horrors of the war.")
              Text("\n")
      Text("\n")
      Text("I have no place here. No way to fit. I am caught, in the middle, cryptic and understood only thinly, through my machines.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=false)
        ContentList
          Text("I must seem very calm. \t\t\t")
        ContentList
          Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Perhaps I should try to escape.")
        ContentList
          Text(" But escape to where? I am already a prisoner. Jail would be a blessing. ")
          Divert(target="-> monastic", empty=false, tunnel=false, thread=false)
          Text("\n")
      Gather(name=null, depth=1)
      Glue
      Text(" I suppose I do not believe they will hang me. They will lock me up and continue to use my brain, if they can. I wonder what they will tell the world — perhaps that I have taken my own life. That would be simplest. The few who know me would believe it.")
      Text("\n")
      Text("Well, then. Not a bad existence, in prison. Removed from temptation.")
      Text("\n")
      Gather(name="monastic", depth=1)
      Text("A monastic life, with plenty of problems to keep me going.")
      Text("\n")
      Text("I wonder what else I might yet unravel before I'm done?")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("The door is opening.")
        ContentList
          Text(" Harris is returning. Our little calculation here is complete. ")
          ContentList
            Conditional
              Unary(not, VariableReference(piecereturned))
              ConditionalBranch(true=true, else=false, inline=true)
                Weave(baseIndent=0)
                  Text(" I can only hope one of the others will be able to explain to him that the part I stole will mean nothing to the Germans.")
              ConditionalBranch(true=false, else=true, inline=true)
                Weave(baseIndent=0)
                  Text("We are just pieces in this machine; interchangeable and prone to wear.")
          Text("\n")
      Gather(name=null, depth=1)
      Text("That is the true secret of the calculating engine, and the source of its power. It is not the components that matter, they are quite repetitive. What matters is how they are wired; the diversity of the patterns and structures they can form. Much like people — it is how they connect that determines our victories and tragedies, and not their genius.")
      Text("\n")
      Text("Which makes me wonder. Should I give ")
      ContentList
        Conditional
          VariableReference(i_met_a_young_man)
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("up my beautiful young man")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("the young man who put me in this spot")
      Text(" to them as well as myself?")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Yes")
        ContentList
          Text(" ")
          Text("\n")
      Text("But of course I will. ")
      ContentList
        Conditional
          Binary(>, VariableReference(forceful), Number(2))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("Perhaps I can persuade them to put him in my cell.")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("A little vengeance, disguised as doing something good.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("No")
        ContentList
          Text(" ")
          Text("\n")
      Text("No. What would be the use? He will be long gone, and the name he told me is no doubt hokum. No: I was alone before in guilt, and I am thus alone again.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Lie")
        ContentList
          Text(" ")
          Text("\n")
      Text("No. Why would I? He is no doubt an innocent himself, trapped by some dire circumstance. Forced to act the way he did. I have every sympathy for him.")
      Text("\n")
      Text("Of course I do.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Evade")
        ContentList
          Text(" ")
          Text("\n")
      Text("It depends, perhaps, on what his name his worth. If it were to prove valuable, well; perhaps I can concoct a few more such lovers with which to ease my later days.")
      Text("\n")
      ContentList
        Conditional
          VariableReference(hooper_mentioned)
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text(" Hooper, perhaps. He wouldn't like that. ")
      Text("\n")
      Gather(name=null, depth=1)
      ContentList
        Conditional
          Unary(not, VariableReference(longgrasshooperframe))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("Harris put the cuffs around my wrists. \"I still have the intercept in my pocket,\" I remark. \"Wherever we're going, could I have a pencil?\"")
              Text("\n")
          ConditionalBranch(true=false, else=true, inline=false)
            Weave(baseIndent=0)
              Text("\"We recovered the part, just where you said it was,\" Harris reports, as he puts the cuffs around my wrists. \"Of course, a couple of the men swear blind they searched there yesterday, so I'm afraid, what with the broken window... we've formed a perfectly good theory which doesn't bode well for you.\"")
              Text("\n")
      Text("\n")
      VariableAssignment(name="piecereturned", global=false, temp=false)
        Number(true)
      ContentList
        Conditional
          VariableReference(longgrasshooperframe)
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("\"I see.\" It doesn't seem worth arguing any further. \"I still have the intercept in my pocket,\" I remark. \"Wherever we're going, could I have a pencil?\"")
              Text("\n")
      Text("\n")
      Text("He looks me in the eye.")
      Text("\n")
      ContentList
        Conditional
          Unary(not, VariableReference(losttemper))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("\"Of course. And one of your computing things, if I get my way. And when we're old, and smoking pipes together in The Rag like heroes, I'll explain to you the way that decent men have affairs.")
              Text("\n")
          ConditionalBranch(true=false, else=true, inline=false)
            Weave(baseIndent=0)
              Text("\"I'll give you a stone to chisel notches in the wall. And that's all the calculations you'll be doing. And as you sit there, pissing into a bucket and growing a beard down to your toes, you have a think about how a <i>smart</i> man would conduct his illicit affairs. With a bit of due decorum you could have learnt off any squaddie.")
              Text("\n")
      Text("\n")
      Glue
      Text(" You scientists.\"")
      Text("\n")
      Text("He drags me up to my feet.")
      Text("\n")
      Text("\"You think you have to re—invent everything.\"")
      Text("\n")
      Text("With that, he hustles me out of the door and I can't help thinking that, with a little more strategy, I could still have won the day. But too late now, of course.")
      Text("\n")
      Divert(target="-> END", empty=false, tunnel=false, thread=false)
