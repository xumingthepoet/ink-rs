      Text("I shrug.")
      Text("\n")
      TunnelOnwards
      Gather(name=null, depth=1)
      Text("The reel went missing from the Bombe this afternoon. The four of us were in the Hut, working on the latest German intercept. The results were garbage. It was Russell who found the gap in the plugboard.")
      Text("\n")
      Gather(name=null, depth=1)
      Text("Any of us could have taken it; and no one else would have known its worth.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Panic")
        ContentList
          Text(" They will pin it on me. They need a scapegoat so that the work can continue. I'm a likely target. Weaker than the rest. ")
          Text("\n")
        Binary(<=, VariableReference(forceful), Number(0))
      ContentList
        FunctionCall(lower, args=1)
        Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Calculate")
        ContentList
          Text(" My odds, then, are one in four. Not bad; although the stakes themselves are higher than I would like.")
          Text("\n")
      ContentList
        FunctionCall(raise, args=1)
        Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Deny")
        ContentList
          Text(" But this is still a mere formality. The work will not stop. A replacement component will be made and we will all be put back to work. We are too valuable to shoot. ")
          Text("\n")
        Binary(>=, VariableReference(evasive), Number(0))
      ContentList
        FunctionCall(raise, args=1)
        Text("\n")
      Gather(name=null, depth=1)
      TunnelOnwards
  Flow(level=Knot, name="here_at_bletchley_diversion", function=false)
    Weave(baseIndent=0)
      Text("\"Here at Bletchley? Of course.\"")
      Text("\n")
      ContentList
        FunctionCall(raise, args=1)
        Text("\n")
      ContentList
        FunctionCall(lower, args=1)
        Text("\n")
      Text("\"Here, now,\" Harris corrects. \"We are not talking to everyone. I can imagine you might feel pretty sore about that. I can imagine you feeling picked on. ")
      ContentList
        Conditional
          Binary(<, VariableReference(forceful), Number(0))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("You're a sensitive soul.")
      Text("\"")
      Text("\n")
      Choice(name="fine", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("\"I'm fine")
        ContentList
          Text(".\"")
        ContentList
          Text(",\" I reply. \"This is all some misunderstanding and the quicker we have it cleared up the better.\"")
          Text("\n")
      ContentList
        FunctionCall(lower, args=1)
        Text("\n")
      Text("\"I couldn't agree more.\" And then he comes right out with it, with an accusation.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=false)
        ContentList
          Text("\"What do you mean by that?\"")
        ContentList
          Text("\n")
        Binary(<, VariableReference(forceful), Number(0))
      Choice(name="sore", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("\"Damn right")
        ContentList
          Text(".\"")
        ContentList
          Text(" I'm sore. Was it one of the others who put you up to this? Was it Hooper? He's always been jealous of me. He's...\"")
          Text("\n")
        Binary(>=, VariableReference(forceful), Number(0))
      ContentList
        FunctionCall(raise, args=1)
        Text("\n")
      VariableAssignment(name="hooper_mentioned", global=false, temp=false)
        Number(true)
      Text("The Commander moustache bristles as he purses his lips. \"Has he now? Of your achievements, do you think?\"")
      Text("\n")
      Text("It's difficult not to shake the sense that he's ")
      ContentList
        Conditional
          Binary(>, VariableReference(evasive), Number(1))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("mocking")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("simply humouring")
      Text(" me.")
      Text("\n")
      Text("\"Or of your brain? Or something else?\"")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("\"Of my genius.")
          ContentList
            Text("\"")
          ContentList
            Text(" Hooper simply can't stand that I'm cleverer than he is. We work so closely together, cooped up in that Hut all day. It drives him to distraction. To worse.\"")
