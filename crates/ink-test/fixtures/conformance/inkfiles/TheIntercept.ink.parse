      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Lie")
        ContentList
          Text(" ")
          Divert(target="-\u003E nothing", empty=false, tunnel=false, thread=false)
          Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Evade")
        ContentList
          Text(" ")
          Text("\n")
      Text("\u0022I don\u0027t know what gives you the right to pick on me. ")
      ContentList
        Conditional
