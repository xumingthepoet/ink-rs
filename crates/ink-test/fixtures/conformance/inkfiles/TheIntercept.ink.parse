  Flow(level=Knot, name="harris_presses_for_details", function=false)
    Weave(baseIndent=0)
      Text("\u0022You mean you\u0027ve left yourself open,\u0022 Harris answers. \u0022To pressure. Is that what you\u0027re saying?\u0022")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Yes")
        ContentList
          Text(" ")
          Divert(target="-\u003E admit_open_to_pressure", empty=false, tunnel=false, thread=false)
          Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("No")
        ContentList
          Text(" ")
          Text("\n")
        Unary(not, VariableReference(drugged))
      Text("\u0022I\u0027m not saying anything of the sort,\u0022 I snap back. \u0022What is this, Harris? You\u0027re accusing me of treachery but I don\u0027t see a shred of evidence for it! Why don\u0027t you put your cards on the table?\u0022")
      Text("\n")
      ContentList
        FunctionCall(raise, args=1)
        Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("No")
        ContentList
          Text(" ")
          Text("\n")
        VariableReference(drugged)
      Text("I shake my head violently, to say no, that\u0027s not it, but whatever is wrong with tongue is wrong with neck too. I look across at the table at Harris\u0027 face and realise with a start how sympathetic he is. Such a kind, generous man. How can I hold anything back from him?")
      Text("\n")
      ContentList
        FunctionCall(lower, args=1)
        Text("\n")
      Text("I take another mouthful of the bitter, strange\u2014tasting tea before answering.")
      Text("\n")
      Divert(target="-\u003E admit_open_to_pressure", empty=false, tunnel=false, thread=false)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Evade")
        ContentList
          Text(" ")
          Text("\n")
        Unary(not, VariableReference(drugged))
      Text("\u0022You\u0027re the one applying pressure here,\u0022 I answer ")
      ContentList
        Conditional
          Binary(>, VariableReference(forceful), Number(1))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("smartly")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("somewhat miserably")
      Text(". \u0022I\u0027m just waiting until you tell me what is really going on.\u0022")
      Text("\n")
      ContentList
        FunctionCall(raise, args=1)
        Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Evade")
        ContentList
          Text(" \t\t\t\t ")
          Text("\n")
        VariableReference(drugged)
      Text("\u0022We\u0027re all under pressure here.\u0022")
      Text("\n")
      Text("He looks at me with pity. ")
      Divert(target="-\u003E harris_has_seen_it_before", empty=false, tunnel=false, thread=false)
      Text("\n")
      Gather(name=null, depth=1)
      Text("\u0022It\u0027s simple enough,\u0022 Harris says. ")
      Divert(target="-\u003E harris_has_seen_it_before", empty=false, tunnel=false, thread=false)
      Text("\n")
    Flow(level=Stitch, name="admit_open_to_pressure", function=false)
      Weave(baseIndent=0)
        Text("\u0022That\u0027s it,\u0022 I reply. \u0022There are some things... which a man shouldn\u0027t do.\u0022")
        Text("\n")
        VariableAssignment(name="admitblackmail", global=false, temp=false)
          Number(true)
        Text("Harris doesn\u0027t stiffen. Doesn\u0027t lean away, as though my condition might be infectious. I had thought they trained them in the army to shoot my kind on sight.")
        Text("\n")
        Text("He offers no sympathy either. He nods, once. His understanding of me is a mere turning cog in his calculations, with no meaning to it.")
        Text("\n")
        Divert(target="-\u003E harris_has_seen_it_before", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="admitted_to_something", function=false)
    Weave(baseIndent=0)
      ContentList
        Conditional
          Unary(not, VariableReference(drugged))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              Text("Harris stares back at me. ")
              ContentList
                Conditional
                  Binary(==, VariableReference(evasive), Number(0))
                  ConditionalBranch(true=true, else=false, inline=true)
                    Weave(baseIndent=0)
                      Text("He cannot have expected it to be so easy to break me.")
              Text("\n")
          ConditionalBranch(true=false, else=true, inline=false)
            Weave(baseIndent=0)
              Text("Harris smiles with satisfaction, as if your willingness to talk was somehow his doing.")
              Text("\n")
      Text("\n")
      Text("\u0022I see.\u0022")
      Text("\n")
      Text("There\u0027s a long pause, like the delay between feeding a line of cypher into the Bombe and waiting for its valves to warm up enough to begin processing.")
      Text("\n")
      Text("\u0022You want to explain that?\u0022")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Explain")
        ContentList
          Text(" ")
          Text("\n")
      Text("I pause a moment, trying to choose my words. To just come out and say it, after a lifetime of hiding... that is a circle I cannot square.")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Explain")
          ContentList
            Text(" \t")
            Divert(target="-\u003E ive_done_things", empty=false, tunnel=false, thread=false)
