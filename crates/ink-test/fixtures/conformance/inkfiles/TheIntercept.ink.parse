        VariableAssignment(name="teacup", global=false, temp=false)
          Number(false)
        ContentList
          FunctionCall(raise, args=1)
          Text("\n")
        Text("\u0022How should I know?\u0022 I reply, defensively. ")
        ContentList
          Conditional
            VariableReference(teacup)
            ConditionalBranch(true=true, else=false, inline=true)
              Weave(baseIndent=0)
                Text("I set the teacup back on the table.")
        Text(" ")
        Divert(target="-\u003E suggest_its_a_lie", empty=false, tunnel=false, thread=false)
        Text("\n")
