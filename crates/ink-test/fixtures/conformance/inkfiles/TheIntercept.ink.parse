  Flow(level=Knot, name="start", function=false)
    Weave(baseIndent=0)
      Gather(name=null, depth=1)
      Text("They are keeping me waiting.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Hut 14")
        ContentList
          Text(". The door was locked after I sat down. ")
          Text("\n")
      Text("I don\u0027t even have a pen to do any work. There\u0027s a copy of the morning\u0027s intercept in my pocket, but staring at the jumbled letters will only drive me mad.")
      Text("\n")
      Text("I am not a machine, whatever they say about me.")
      Text("\n")
      Gather(name="opts", depth=1)
      ContentList
        Sequence(type=Stopping)
          ContentList
          Weave(baseIndent=0)
            Text("I rattle my fingers on the field table.")
          ContentList
      Text("\n")
      Choice(name="think", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Think")
        ContentList
          Text(" ")
          Text("\n")
      Text("They suspect me to be a traitor. They think I stole the component from the calculating machine. They will be searching my bunk and cases.")
      Text("\n")
      Text("When they don\u0027t find it, ")
      ContentList
        Conditional
          VariableReference(plan)
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("then")
      Text(" they\u0027ll come back and demand I talk.")
      Text("\n")
      Divert(target="-\u003E opts", empty=false, tunnel=false, thread=false)
      Choice(name="plan", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Plan")
        ContentList
          Text("\n")
      ContentList
        Conditional
          Unary(not, VariableReference(think))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("What I am is")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("I am")
      Text(" a problem\u2014solver. Good with figures, quick with crosswords, excellent at chess.")
      Text("\n")
      Text("But in this scenario \u2014 in this trap \u2014 what is the winning play?")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name="cooperate", once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Co\u2014operate")
          ContentList
            Text(" ")
            Text("\n")
        Text("I must co\u2014operate. My credibility is my main asset. To contradict myself, or another source, would be fatal.")
        Text("\n")
        Text("I must simply hope they do not ask the questions I do not want to answer.")
        Text("\n")
        ContentList
          FunctionCall(lower, args=1)
          Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Dissemble")
          ContentList
            Text(" ")
            Text("\n")
        Text("Misinformation, then. Just as the war in Europe is one of plans and interceptions, not planes and bombs.")
        Text("\n")
        Text("My best hope is a story they prefer to the truth.")
        Text("\n")
        ContentList
          FunctionCall(raise, args=1)
          Text("\n")
        Choice(name="delay", once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Divert")
          ContentList
            Text(" ")
            Text("\n")
        Text("Avoidance and delay. The military machine never fights on a single front. If I move slowly enough, things will resolve themselves some other way, my reputation intact.")
        Text("\n")
        ContentList
          FunctionCall(raise, args=1)
          Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Wait")
        ContentList
          Text("\t\t")
          Text("\n")
      Gather(name=null, depth=1)
      Divert(target="-\u003E waited", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="waited", function=false)
      Weave(baseIndent=0)
        Gather(name=null, depth=1)
        Text("Half an hour goes by before Commander Harris returns. He closes the door behind him quickly, as though afraid a loose word might slip inside.")
        Text("\n")
        Text("\u0022Well, then,\u0022 he begins, awkwardly. This is an unseemly situation.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=false)
          ContentList
            Text("\u0022Commander.\u0022")
          ContentList
            Text("\n")
        Text("He nods. ")
        Glue
        Text("\n")
        Choice(name="tellme", once=true, invisible=false, depth=1, inline=false)
          ContentList
            Text("\u0022Tell me what this is about.\u0022")
          ContentList
            Text("\n")
          Unary(not, VariableReference(start.delay))
        Text("He shakes his head.")
        Text("\n")
        Text("\u0022Now, don\u0027t let\u0027s pretend.\u0022")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Wait")
          ContentList
            Text("\n")
        Text("I say nothing.")
        Text("\n")
        Gather(name=null, depth=1)
        Text("He has brought two cups of tea in metal mugs: he sets them down on the tabletop between us.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Deny")
          ContentList
            Text(" \u0022I\u0027m not pretending anything.\u0022")
            Text("\n")
          VariableReference(tellme)
        ContentList
          Conditional
            VariableReference(cooperate)
            ConditionalBranch(true=true, else=false, inline=true)
              Weave(baseIndent=0)
                Text("I\u0027m lying already, despite my good intentions.")
        Text("\n")
        Text("Harris looks disapproving. ")
        Divert(target="-\u003E pushes_cup", empty=false, tunnel=false, thread=false)
        Text("\n")
        Choice(name="took", once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Take one")
          ContentList
            Text("\n")
        VariableAssignment(name="teacup", global=false, temp=false)
          Number(true)
        Text("I take a mug and warm my hands. It\u0027s ")
        Glue
        Text("\n")
        Choice(name="what2", once=true, invisible=false, depth=1, inline=false)
          ContentList
            Text("\u0022What\u0027s going on?\u0022")
          ContentList
            Text("\n")
          Unary(not, VariableReference(tellme))
        Text("\u0022You know already.\u0022")
        Text("\n")
        Divert(target="-\u003E pushes_cup", empty=false, tunnel=false, thread=false)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Wait")
          ContentList
            Text("\n")
        Text("I wait for him to speak.")
        Text("\n")
        Weave(baseIndent=1)
          Gather(name="pushes_cup", depth=2)
          Text("He pushes one mug halfway towards me: ")
          Glue
          Text("\n")
        Gather(name=null, depth=1)
        Text("a small gesture of friendship.")
        Text("\n")
        Text("Enough to give me hope?")
        Text("\n")
        Choice(name="lift_up_cup", once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Take it")
          ContentList
            Text(" ")
            Text("\n")
          Unary(not, VariableReference(teacup))
        Text("I ")
        ContentList
          Conditional
            VariableReference(took)
            ConditionalBranch(true=true, else=false, inline=true)
              Weave(baseIndent=0)
                Text("lift the mug")
            ConditionalBranch(true=false, else=true, inline=true)
              Weave(baseIndent=0)
                Text("take the mug,")
        Text(" and blow away the steam. It is too hot to drink.")
        Text("\n")
        Text("Harris picks his own up and just holds it.")
        Text("\n")
        VariableAssignment(name="teacup", global=false, temp=false)
          Number(true)
        ContentList
          FunctionCall(lower, args=1)
          Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Don\u0027t take it")
          ContentList
            Text(" ")
            Text("\n")
          Unary(not, VariableReference(teacup))
        Text("Just a cup of insipid canteen tea. I leave it where it is.")
        Text("\n")
        ContentList
          FunctionCall(raise, args=1)
          Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Drink")
          ContentList
            Text(" ")
            Text("\n")
          VariableReference(teacup)
        Text("I raise the cup to my mouth but it\u0027s too hot to drink.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Wait")
          ContentList
            Text(" \t\t")
            Text("\n")
          VariableReference(teacup)
        Text("I say nothing as ")
        Divert(target="-\u003E lift_up_cup", empty=false, tunnel=false, thread=false)
        Text("\n")
        Gather(name=null, depth=1)
        Text("\u0022Quite a difficult situation,\u0022 ")
        ContentList
          Conditional
            VariableReference(lift_up_cup)
            ConditionalBranch(true=true, else=false, inline=true)
              Weave(baseIndent=0)
                Text("he")
            ConditionalBranch(true=false, else=true, inline=true)
              Weave(baseIndent=0)
                Text("Harris")
        Text(" begins")
        ContentList
          Conditional
            Binary(<=, VariableReference(forceful), Number(0))
            ConditionalBranch(true=true, else=false, inline=true)
              Weave(baseIndent=0)
                Text(", sternly")
        Text(". I\u0027ve seen him adopt this stiff tone of voice before, but only when talking to the brass. \u0022I\u0027m sure you agree.\u0022")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Agree")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022Awkward,\u0022 I reply")
        Text("\n")
        Choice(name="disagree", once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Disagree")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022I don\u0027t see why,\u0022 I reply")
        Text("\n")
        ContentList
          FunctionCall(raise, args=1)
          Text("\n")
        ContentList
          FunctionCall(raise, args=1)
          Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Lie")
          ContentList
            Text(" ")
            Divert(target="-\u003E disagree", empty=false, tunnel=false, thread=false)
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Evade")
          ContentList
            Text(" ")
            Text("\n")
        Text("\u0022I\u0027m sure you\u0027ve handled worse,\u0022 I reply casually")
        Text("\n")
        ContentList
          FunctionCall(raise, args=1)
          Text("\n")
        Gather(name=null, depth=1)
        ContentList
          Conditional
            VariableReference(teacup)
            ConditionalBranch(true=true, else=false, inline=false)
              Weave(baseIndent=0)
                VariableAssignment(name="drugged", global=false, temp=false)
                  Number(true)
                Glue
                Text(", sipping at my tea as though we were old friends")
                Text("\n")
        Text("\n")
        Glue
        Text(".")
        Text("\n")
        Gather(name=null, depth=1)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Watch him")
          ContentList
            Text("\n")
        Text("His face is telling me nothing. I\u0027ve seen Harris broad and full of laughter. Today he is tight, as much part of the military machine as the device in Hut 5.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Wait")
          ContentList
            Text("\n")
        Text("I wait to see how he\u0027ll respond.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Smile")
          ContentList
            Text("\n")
          Unary(not, VariableReference(disagree))
        Text("I try a weak smile. It is not returned.")
        Text("\n")
        ContentList
          FunctionCall(lower, args=1)
          Text("\n")
        Gather(name=null, depth=1)
        Text("\u0022We need that component,\u0022 he says.")
        Text("\n")
        Gather(name=null, depth=1)
        ContentList
          Conditional
            Unary(not, VariableReference(missing_reel))
            ConditionalBranch(true=true, else=false, inline=false)
              Weave(baseIndent=0)
                Divert(target="-\u003E missing_reel", empty=false, tunnel=true, thread=false)
                Divert(target="-\u003E harris_demands_component", empty=false, tunnel=false, thread=false)
        Text("\n")
        Gather(name=null, depth=1)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Yes")
          ContentList
            Text("\n")
        Text("\u0022Of course I do,\u0022 I answer.")
        Text("\n")
        Choice(name="no", once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("No")
          ContentList
            Text("\n")
        Text("\u0022No I don\u0027t. And I\u0027ve got work to do...\u0022")
        Text("\n")
        Text("\u0022Work that will be rather difficult for you to do, don\u0027t you think?\u0022 Harris interrupts.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Evade")
          ContentList
            Text("\n")
        Divert(target="-\u003E here_at_bletchley_diversion", empty=false, tunnel=false, thread=false)
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Lie")
          ContentList
            Text(" ")
            Text("\n")
        Divert(target="-\u003E no", empty=false, tunnel=false, thread=false)
        Gather(name=null, depth=1)
        Divert(target="-\u003E missing_reel", empty=false, tunnel=true, thread=false)
        Divert(target="-\u003E harris_demands_component", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="missing_reel", function=false)
    Weave(baseIndent=0)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("The stolen component...")
        ContentList
          Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Shrug")
        ContentList
          Text("\n")
      Text("I shrug.")
      Text("\n")
      TunnelOnwards
      Gather(name=null, depth=1)
      Text("The reel went missing from the Bombe this afternoon. The four of us were in the Hut, working on the latest German intercept. The results were garbage. It was Russell who found the gap in the plugboard.")
      Text("\n")
      Gather(name=null, depth=1)
      Text("Any of us could have taken it; and no one else would have known its worth.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Panic")
        ContentList
          Text(" They will pin it on me. They need a scapegoat so that the work can continue. I\u0027m a likely target. Weaker than the rest. ")
          Text("\n")
        Binary(<=, VariableReference(forceful), Number(0))
      ContentList
        FunctionCall(lower, args=1)
        Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Calculate")
        ContentList
          Text(" My odds, then, are one in four. Not bad; although the stakes themselves are higher than I would like.")
          Text("\n")
      ContentList
        FunctionCall(raise, args=1)
        Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Deny")
        ContentList
          Text(" But this is still a mere formality. The work will not stop. A replacement component will be made and we will all be put back to work. We are too valuable to shoot. ")
          Text("\n")
        Binary(>=, VariableReference(evasive), Number(0))
      ContentList
        FunctionCall(raise, args=1)
        Text("\n")
      Gather(name=null, depth=1)
      TunnelOnwards
  Flow(level=Knot, name="here_at_bletchley_diversion", function=false)
    Weave(baseIndent=0)
      Text("\u0022Here at Bletchley? Of course.\u0022")
      Text("\n")
      ContentList
        FunctionCall(raise, args=1)
        Text("\n")
      ContentList
        FunctionCall(lower, args=1)
        Text("\n")
      Text("\u0022Here, now,\u0022 Harris corrects. \u0022We are not talking to everyone. I can imagine you might feel pretty sore about that. I can imagine you feeling picked on. ")
      ContentList
        Conditional
          Binary(<, VariableReference(forceful), Number(0))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("You\u0027re a sensitive soul.")
      Text("\u0022")
      Text("\n")
      Choice(name="fine", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("\u0022I\u0027m fine")
        ContentList
          Text(".\u0022")
        ContentList
          Text(",\u0022 I reply. \u0022This is all some misunderstanding and the quicker we have it cleared up the better.\u0022")
          Text("\n")
      ContentList
        FunctionCall(lower, args=1)
        Text("\n")
      Text("\u0022I couldn\u0027t agree more.\u0022 And then he comes right out with it, with an accusation.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=false)
        ContentList
          Text("\u0022What do you mean by that?\u0022")
        ContentList
          Text("\n")
        Binary(<, VariableReference(forceful), Number(0))
      Choice(name="sore", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("\u0022Damn right")
        ContentList
          Text(".\u0022")
        ContentList
          Text(" I\u0027m sore. Was it one of the others who put you up to this? Was it Hooper? He\u0027s always been jealous of me. He\u0027s...\u0022")
          Text("\n")
        Binary(>=, VariableReference(forceful), Number(0))
      ContentList
        FunctionCall(raise, args=1)
        Text("\n")
      VariableAssignment(name="hooper_mentioned", global=false, temp=false)
        Number(true)
      Text("The Commander moustache bristles as he purses his lips. \u0022Has he now? Of your achievements, do you think?\u0022")
      Text("\n")
      Text("It\u0027s difficult not to shake the sense that he\u0027s ")
      ContentList
        Conditional
          Binary(>, VariableReference(evasive), Number(1))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("mocking")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("simply humouring")
      Text(" me.")
      Text("\n")
      Text("\u0022Or of your brain? Or something else?\u0022")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("\u0022Of my genius.")
          ContentList
            Text("\u0022")
          ContentList
            Text(" Hooper simply can\u0027t stand that I\u0027m cleverer than he is. We work so closely together, cooped up in that Hut all day. It drives him to distraction. To worse.\u0022")
            Text("\n")
        Text("\u0022You\u0027re suggesting Hooper would sabotage this country\u0027s future simply to spite you?\u0022 Harris chooses his words like the military man he is, each lining up to create a ring around me.")
        Text("\n")
        Weave(baseIndent=2)
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("Yes")
            ContentList
              Text(" \t\t\t")
              Text("\n")
          Text("\u0022")
          ContentList
            Conditional
              Binary(>, VariableReference(forceful), Number(0))
              ConditionalBranch(true=true, else=false, inline=true)
                Weave(baseIndent=0)
                  Text("He\u0027s petty enough, certainly")
              ConditionalBranch(true=false, else=true, inline=true)
                Weave(baseIndent=0)
                  Text("I wouldn\u0027t put it past him")
          Text(". He\u0027s a creep.\u0022 ")
          ContentList
            Conditional
              VariableReference(teacup)
              ConditionalBranch(true=true, else=false, inline=true)
                Weave(baseIndent=0)
                  Text(" I set the teacup down.")
              ConditionalBranch(true=false, else=true, inline=true)
                Weave(baseIndent=0)
                  Text("I wipe a hand across my forehead.")
          Text("\n")
          ContentList
            FunctionCall(raise, args=1)
            Text("\n")
          VariableAssignment(name="teacup", global=false, temp=false)
            Number(false)
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("No")
            ContentList
              Text(" \t\t\t")
              Text("\n")
          Text("\u0022No, ")
          ContentList
            Conditional
