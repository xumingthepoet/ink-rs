                  ConditionalBranch(true=false, else=true, inline=true)
                    Weave(baseIndent=0)
                      Text(", voice quivering. \u0022For God\u0027s sake!\u0022")
              Text("\n")
          Choice(name=null, once=true, invisible=false, depth=3, inline=true)
            ContentList
              Text("Lie")
            ContentList
              Text(" ")
              Divert(target="-\u003E iamnotraitor", empty=false, tunnel=false, thread=false)
              Text("\n")
          Gather(name=null, depth=3)
          Text("He stares back at me.")
          Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("\u0022Of my standing.")
          ContentList
            Text("\u0022")
          ContentList
            Text(" My reputation.\u0022 ")
            ContentList
              Conditional
                Binary(>, VariableReference(forceful), Number(0))
                ConditionalBranch(true=true, else=false, inline=true)
                  Weave(baseIndent=0)
                    Text("I\u0027m aware of how arrogant I must sound but I plough on all the same.")
                ConditionalBranch(true=false, else=true, inline=true)
                  Weave(baseIndent=0)
                    Text("I don\u0027t like to talk of myself like this, but I carry on all the same.")
            Text(" \u0022Hooper simply can\u0027t bear knowing that, once all this is over, I\u0027ll be the one receiving the knighthood and he...\u0022")
            Text("\n")
        Text("\u0022No\u2014one will be getting a knighthood if the Germans make landfall,\u0022 Harris answers sharply. He casts a quick eye to the door of the Hut to check the latch is still down, then continues in more of a murmur: \u0022Not you and not Hooper. Now answer me.\u0022")
        Text("\n")
        Text("For the first time since the door closed, I wonder what the threat might be if I do \u003Ci\u003Enot\u003C/i\u003E.")
        Text("\n")
