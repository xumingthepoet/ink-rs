          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("I demand a lawyer.")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("I want a lawyer.")
      Text("\u0022")
      Text("\n")
      Text("\u0022This is time of war,\u0022 Harris answers.  \u0022And by God, if I have to shoot you to recover the component, I will. Understand?\u0022 He points at the mug, ")
      Divert(target="-\u003E drinkit", empty=false, tunnel=false, thread=false)
      Text("\n")
      Gather(name="silence", depth=1)
      Text("There\u0027s an icy silence. ")
      ContentList
        Conditional
          Binary(>, VariableReference(forceful), Number(2))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("I\u0027ve cracked him a little.")
