  Flow(level=Knot, name="start", function=false)
    Weave(baseIndent=0)
      Gather(name=null, depth=1)
      Text("They are keeping me waiting.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Hut 14")
        ContentList
          Text(". The door was locked after I sat down. ")
          Text("\n")
      Text("I don't even have a pen to do any work. There's a copy of the morning's intercept in my pocket, but staring at the jumbled letters will only drive me mad.")
      Text("\n")
      Text("I am not a machine, whatever they say about me.")
      Text("\n")
      Gather(name="opts", depth=1)
      ContentList
        Sequence(type=Stopping)
          ContentList
          Weave(baseIndent=0)
            Text("I rattle my fingers on the field table.")
          ContentList
      Text("\n")
      Choice(name="think", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Think")
        ContentList
          Text(" ")
          Text("\n")
      Text("They suspect me to be a traitor. They think I stole the component from the calculating machine. They will be searching my bunk and cases.")
      Text("\n")
      Text("When they don't find it, ")
      ContentList
        Conditional
          VariableReference(plan)
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("then")
      Text(" they'll come back and demand I talk.")
      Text("\n")
      Divert(target="-> opts", empty=false, tunnel=false, thread=false)
      Choice(name="plan", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Plan")
        ContentList
          Text("\n")
      ContentList
        Conditional
          Unary(not, VariableReference(think))
          ConditionalBranch(true=true, else=false, inline=true)
            Weave(baseIndent=0)
              Text("What I am is")
          ConditionalBranch(true=false, else=true, inline=true)
            Weave(baseIndent=0)
              Text("I am")
      Text(" a problem—solver. Good with figures, quick with crosswords, excellent at chess.")
      Text("\n")
      Text("But in this scenario — in this trap — what is the winning play?")
      Text("\n")
      Weave(baseIndent=1)
        Choice(name="cooperate", once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Co—operate")
          ContentList
            Text(" ")
            Text("\n")
        Text("I must co—operate. My credibility is my main asset. To contradict myself, or another source, would be fatal.")
        Text("\n")
        Text("I must simply hope they do not ask the questions I do not want to answer.")
        Text("\n")
        ContentList
          FunctionCall(lower, args=1)
          Text("\n")
        Choice(name=null, once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Dissemble")
          ContentList
            Text(" ")
            Text("\n")
        Text("Misinformation, then. Just as the war in Europe is one of plans and interceptions, not planes and bombs.")
        Text("\n")
        Text("My best hope is a story they prefer to the truth.")
        Text("\n")
        ContentList
          FunctionCall(raise, args=1)
          Text("\n")
        Choice(name="delay", once=true, invisible=false, depth=2, inline=true)
          ContentList
            Text("Divert")
          ContentList
            Text(" ")
            Text("\n")
        Text("Avoidance and delay. The military machine never fights on a single front. If I move slowly enough, things will resolve themselves some other way, my reputation intact.")
        Text("\n")
        ContentList
          FunctionCall(raise, args=1)
          Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Wait")
        ContentList
          Text("\t\t")
          Text("\n")
      Gather(name=null, depth=1)
      Divert(target="-> waited", empty=false, tunnel=false, thread=false)
    Flow(level=Stitch, name="waited", function=false)
      Weave(baseIndent=0)
        Gather(name=null, depth=1)
        Text("Half an hour goes by before Commander Harris returns. He closes the door behind him quickly, as though afraid a loose word might slip inside.")
        Text("\n")
        Text("\"Well, then,\" he begins, awkwardly. This is an unseemly situation.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=false)
          ContentList
            Text("\"Commander.\"")
          ContentList
            Text("\n")
        Text("He nods. ")
        Glue
        Text("\n")
        Choice(name="tellme", once=true, invisible=false, depth=1, inline=false)
          ContentList
            Text("\"Tell me what this is about.\"")
          ContentList
            Text("\n")
          Unary(not, VariableReference(start.delay))
        Text("He shakes his head.")
        Text("\n")
        Text("\"Now, don't let's pretend.\"")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Wait")
          ContentList
            Text("\n")
        Text("I say nothing.")
        Text("\n")
        Gather(name=null, depth=1)
        Text("He has brought two cups of tea in metal mugs: he sets them down on the tabletop between us.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=1, inline=true)
          ContentList
            Text("Deny")
          ContentList
            Text(" \"I'm not pretending anything.\"")
            Text("\n")
          VariableReference(tellme)
        ContentList
