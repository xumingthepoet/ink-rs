    Flow(level=Stitch, name="admit_open_to_pressure", function=false)
      Weave(baseIndent=0)
        Text("\"That's it,\" I reply. \"There are some things... which a man shouldn't do.\"")
        Text("\n")
        VariableAssignment(name="admitblackmail", global=false, temp=false)
          Number(true)
        Text("Harris doesn't stiffen. Doesn't lean away, as though my condition might be infectious. I had thought they trained them in the army to shoot my kind on sight.")
        Text("\n")
        Text("He offers no sympathy either. He nods, once. His understanding of me is a mere turning cog in his calculations, with no meaning to it.")
