            Weave(baseIndent=0)
              Divert(target="-\u003E missing_reel", empty=false, tunnel=true, thread=false)
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Co-operate")
