Story
  Weave(baseIndent=0)
    ContentList
      FunctionCall(merchant_init, args=0)
      Text("\n")
    Text("\u0022I will pay you ")
    ContentList
      VariableReference(fee)
    Text(" reales if you get the goods to their destination. The goods will take up ")
    ContentList
      VariableReference(weight)
    Text(" cargo spaces.\u0022")
    Text("\n")
    Divert(target="-\u003E END", empty=false, tunnel=false, thread=false)
    Gather(name=null, depth=1)
    Divert(target="-\u003E DONE", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="merchant_init", function=true)
    Weave(baseIndent=0)
      VariableAssignment(name="weight", global=true, temp=false)
        Number(20)
      VariableAssignment(name="roll", global=true, temp=false)
        Number(0)
      VariableAssignment(name="mult", global=true, temp=false)
        Number(1)
      ContentList
        Conditional
          Binary(==, VariableReference(roll), Number(0))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              VariableAssignment(name="mult", global=false, temp=false)
                Number(2)
      Text("\n")
      ContentList
        Conditional
          Binary(==, VariableReference(mult), Number(2))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              VariableAssignment(name="roll", global=false, temp=false)
                Number(1)
      Text("\n")
      ContentList
        Conditional
          Binary(==, VariableReference(roll), Number(0))
          ConditionalBranch(true=true, else=false, inline=false)
            Weave(baseIndent=0)
              VariableAssignment(name="mult", global=false, temp=false)
                Number(3)
      Text("\n")
      VariableAssignment(name="dst", global=true, temp=false)
        Number(5)
      VariableAssignment(name="deadline", global=true, temp=false)
        Number(0)
      VariableAssignment(name="deadline", global=false, temp=false)
        Binary(/, Binary(*, VariableReference(dst), Number(100)), Number(100))
      VariableAssignment(name="fee", global=true, temp=false)
        Number(0)
      VariableAssignment(name="fee", global=false, temp=false)
        Binary(*, Binary(*, Binary(+, Number(1), VariableReference(dst)), Number(10)), VariableReference(mult))