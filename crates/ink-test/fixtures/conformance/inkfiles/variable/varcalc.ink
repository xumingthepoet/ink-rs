
         VAR knows: bool = false
         VAR x: int = 2
         VAR y: int = 3
         VAR c: int = 4
         VAR str: string = ""
         ~ knows = true
         ~ x = (x * x) - (y * y) + c
         ~ y = 2 * x * y
         ~ str = "a"
         ~ str += "a"
        
            The values are {knows} and {x} and {y} and {str}.
            -> END