Story
  Weave(baseIndent=0)
    VariableAssignment(name="x", global=true, temp=false)
      Number(-2)
    VariableAssignment(name="y", global=true, temp=false)
      Number(3)
    ContentList
      Conditional
        ConditionalBranch(true=false, else=false, inline=false)
          Weave(baseIndent=0)
            VariableAssignment(name="y", global=false, temp=false)
              Number(0)
          Binary(==, VariableReference(x), Number(0))
        ConditionalBranch(true=false, else=false, inline=false)
          Weave(baseIndent=0)
            VariableAssignment(name="y", global=false, temp=false)
              Binary(-, VariableReference(x), Number(1))
          Binary(>, VariableReference(x), Number(0))
        ConditionalBranch(true=false, else=true, inline=false)
          Weave(baseIndent=0)
            VariableAssignment(name="y", global=false, temp=false)
              Binary(+, VariableReference(x), Number(1))
    Text("\n")
    Text("The value is ")
    ContentList
      VariableReference(y)
    Text(". ")
    Divert(target="-> END", empty=false, tunnel=false, thread=false)
    Text("\n")
    Gather(name=null, depth=1)
    Divert(target="-> DONE", empty=false, tunnel=false, thread=false)