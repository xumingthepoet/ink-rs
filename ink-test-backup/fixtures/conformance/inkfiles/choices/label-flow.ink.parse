Story
  Weave(baseIndent=0)
    Divert(target="-> meet_guard", empty=false, tunnel=false, thread=false)
    Gather(name=null, depth=1)
    Divert(target="-> DONE", empty=false, tunnel=false, thread=false)
  Flow(level=Knot, name="meet_guard", function=false)
    Weave(baseIndent=0)
      Text("The guard frowns at you.")
      Text("\n")
      Choice(name="greet", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Greet him")
        ContentList
          Text("\n")
      Text("'Greetings.'")
      Text("\n")
      Choice(name="get_out", once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("'Get out of my way")
        ContentList
          Text(".'")
        ContentList
          Text(",' you tell the guard.")
          Text("\n")
      Gather(name=null, depth=1)
      Text("'Hmm,' replies the guard.")
      Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=false)
        ContentList
          Text("'Having a nice day?'")
        ContentList
          Text("\n")
        VariableReference(greet)
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("'Hmm?'")
        ContentList
          Text(" you reply.        ")
          Text("\n")
      Choice(name=null, once=true, invisible=false, depth=1, inline=true)
        ContentList
          Text("Shove him aside")
        ContentList
          Text("\n")
        VariableReference(get_out)
      Text("You shove him sharply. He stares in reply, and draws his sword!")
      Text("\n")
      Divert(target="-> END", empty=false, tunnel=false, thread=false)
      Gather(name=null, depth=1)
      Text("'Mff,' the guard replies, and then offers you a paper bag. 'Toffee?'")
      Text("\n")
      Divert(target="-> END", empty=false, tunnel=false, thread=false)