Story
  Weave(baseIndent=0)
    Text("I looked at Monsieur Fogg")
    Text("\n")
    Choice(name=null, once=true, invisible=false, depth=1, inline=false)
      ContentList
        Text("... and I could contain myself no longer.")
      ContentList
        Text("\n")
    Text("'What is the purpose of our journey, Monsieur?'")
    Text("\n")
    Text("'A wager,' he replied.")
    Text("\n")
    Weave(baseIndent=1)
      Choice(name=null, once=true, invisible=false, depth=2, inline=true)
        ContentList
          Text("'A wager!'")
        ContentList
          Text(" I returned.")
          Text("\n")
      Text("He nodded.")
      Text("\n")
      Weave(baseIndent=2)
        Choice(name=null, once=true, invisible=false, depth=3, inline=false)
          ContentList
            Text("'But surely that is foolishness!'")
          ContentList
            Text("\n")
        Choice(name=null, once=true, invisible=false, depth=3, inline=false)
          ContentList
            Text("'A most serious matter then!'")
          ContentList
            Text("\n")
        Gather(name=null, depth=3)
        Text("He nodded again.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=3, inline=false)
          ContentList
            Text("'But can we win?'")
          ContentList
            Text("\n")
        Text("'That is what we will endeavour to find out,' he answered.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=3, inline=false)
          ContentList
            Text("'A modest wager, I trust?'")
          ContentList
            Text("\n")
        Text("'Twenty thousand pounds,' he replied, quite flatly.")
        Text("\n")
        Choice(name=null, once=true, invisible=false, depth=3, inline=true)
          ContentList
            Text("I asked nothing further of him then")
          ContentList
            Text(".")
          ContentList
            Text(", and after a final, polite cough, he offered nothing more to me. ")
            Glue
            Text("\n")
      Choice(name=null, once=true, invisible=false, depth=2, inline=true)
        ContentList
          Text("'Ah")
        ContentList
          Text(".'")
        ContentList
          Text(",' I replied, uncertain what I thought.")
          Text("\n")
      Gather(name=null, depth=2)
      Text("After that, ")
      Glue
      Text("\n")
    Choice(name=null, once=true, invisible=false, depth=1, inline=true)
      ContentList
        Text("... but I said nothing")
      ContentList
        Text(" and ")
