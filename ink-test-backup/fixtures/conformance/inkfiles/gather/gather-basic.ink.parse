Story
  Weave(baseIndent=0)
    Text("What's that?\" my master asked.")
    Text("\n")
    Choice(name=null, once=true, invisible=false, depth=1, inline=true)
      ContentList
        Text("\"I am somewhat tired")
      ContentList
