#!/bin/sh
set -u

mode=${1:-sync}
context=${2:-after Git operation}

if ! command -v codegraph >/dev/null 2>&1; then
    echo "codegraph not installed; skipping CodeGraph index update"
    exit 0
fi

update_codegraph() {
    if [ ! -f .codegraph/config.json ] || [ ! -f .codegraph/codegraph.db ]; then
        codegraph init . >/dev/null && codegraph index --force --quiet .
        return
    fi

    if [ "$mode" = "force" ]; then
        codegraph index --force --quiet .
        return
    fi

    codegraph sync --quiet . || {
        codegraph unlock . >/dev/null 2>&1 || true
        codegraph sync --quiet .
    }
}

if ! update_codegraph; then
    echo "CodeGraph index update failed ${context}; continuing"
fi

exit 0
